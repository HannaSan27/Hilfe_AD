# Copia este archivo a .env y completa las credenciales locales.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hilfe
PORT=8000
HOST=0.0.0.0

# Usa el mismo Client ID web que PUBLIC_GOOGLE_CLIENT_ID en el frontend.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Usa un valor aleatorio y privado en cada ambiente (no lo subas al repositorio).
JWT_SECRET=

# Opcionales según las funciones habilitadas en tu ambiente.
EMAIL_USER=
EMAIL_PASS=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

