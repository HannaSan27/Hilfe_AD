# ID público de cliente OAuth 2.0 tipo Web application de Google Cloud.
# Debe coincidir exactamente con GOOGLE_CLIENT_ID del backend.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hilfe

PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# API local de Deno; cambia el host/puerto solo si tu backend usa otro origen.
PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
 

.env.example


SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CODE_SECRET=change-this-local-secret
