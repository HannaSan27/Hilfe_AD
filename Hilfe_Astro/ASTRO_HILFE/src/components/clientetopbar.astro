---
import ThemeToggle from "../components/Themetoggle.astro";
import UserMenu from "./UserMenu.astro";
import BotonBilletera from "./BotonBilletera.astro";

interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<div class="topbar">
  <div>
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
  <div class="client-topbar-actions">
    <a class="cliente-view-site" href="/" aria-label="Volver al sitio principal">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="m3 10 9-7 9 7"/><path d="M5 9v11h14V9M9 20v-6h6v6"/></svg>
      Ver sitio
    </a>
    <BotonBilletera /><ThemeToggle /><UserMenu />
  </div>
</div>
