---
import ThemeToggle from "../components/Themetoggle.astro";
import UserMenu from "./UserMenu.astro";

interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<div class="topbar">
  <div>
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
  <div class="client-topbar-actions"><ThemeToggle /><UserMenu /></div>
</div>
