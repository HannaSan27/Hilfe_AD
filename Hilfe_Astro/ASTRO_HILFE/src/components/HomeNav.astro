						Instagram
					</a>
				</div>
			</li>
			<li><a href="/#como-funciona" id="ayudaLink">Ayuda</a></li>
		</ul>
		<div class="nav-actions">
			<button type="button" class="theme-toggle" aria-label="Cambiar tema">
				<svg class="theme-icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
				<svg class="theme-icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
			</button>
			<a href="/login/login" class="btn-login">Iniciar sesión</a>
			<a href="/login/registrar" class="btn-register">Registrarse</a>
			<BotonBilletera />
			<UserMenu variant="nav" />
		</div>
		<button class="nav-toggle" id="navToggle" aria-label="Menú">
			<span></span><span></span><span></span>
		</button>
	</div>
</nav>

<div class="help-chat" id="helpChat">
	<section class="help-chat-panel" id="helpChatPanel" aria-label="Chat de ayuda" hidden>
		<header class="help-chat-header">
			<div><strong>Ayuda Hilf'e</strong><span>Pregúntame lo que necesites</span></div>
			<button type="button" class="help-chat-close" id="helpChatClose" aria-label="Cerrar chat">×</button>
		</header>
		<div class="help-chat-messages" id="helpChatMessages" aria-live="polite">
			<div class="help-chat-message bot">¡Hola! Puedo responder tus preguntas, buscar profesionales, consultar sus horarios y ayudarte a agendar. ¿Qué necesitas?</div>
		</div>
		<div class="help-chat-prompts" id="helpChatPrompts">
			<button type="button">¿Cómo encuentro un profesional?</button>
			<button type="button">¿Cómo contacto a un profesional?</button>
			<button type="button">¿Cómo creo una cuenta?</button>
			<button type="button">Quiero agendar un servicio</button>
		</div>
		<form class="help-chat-form" id="helpChatForm">
			<label class="sr-only" for="helpChatInput">Escribe tu pregunta</label>
			<input id="helpChatInput" type="text" placeholder="Escribe tu pregunta…" autocomplete="off" />
			<button type="submit" aria-label="Enviar pregunta">Enviar</button>
		</form>
	</section>
	<button type="button" class="help-chat-toggle" id="helpChatToggle" aria-expanded="false" aria-controls="helpChatPanel">
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
		<span>Ayuda</span>
	</button>
</div>

<script is:inline>
	(function () {
		var navbar = document.getElementById('navbar');
		var acciones = document.querySelector('.nav-actions');
		var usuario;
		var token;
		try {
			token = localStorage.getItem('token');
			usuario = JSON.parse(localStorage.getItem('usuario') || 'null');
		} catch (e) { usuario = null; token = null; }
		var sesionActiva = typeof token === 'string' && token.trim().length > 0 &&
			usuario && typeof usuario === 'object' && typeof (usuario.nombre || usuario.Nombre) === 'string' &&
			(usuario.nombre || usuario.Nombre).trim().length > 0;
		var botonLogin = acciones && acciones.querySelector('.btn-login');
		var botonRegistro = acciones && acciones.querySelector('.btn-register');
		if (botonLogin) botonLogin.hidden = Boolean(sesionActiva);
		if (botonRegistro) botonRegistro.hidden = Boolean(sesionActiva);
		var ticking = false;
		window.addEventListener('scroll', function () {
			if (!ticking) {
				requestAnimationFrame(function () {
					if (navbar) navbar.classList.toggle('scrolled', window.scrollY > 60);
					ticking = false;
				});
				ticking = true;
			}
		});

		var navToggle = document.getElementById('navToggle');
		if (navToggle) {
			navToggle.addEventListener('click', function () {
				var links = document.querySelector('.nav-links');
				var actions = document.querySelector('.nav-actions');
				if (links) links.classList.toggle('open');
				if (actions) actions.classList.toggle('open');
				this.classList.toggle('active');
			});
		}

		document.querySelectorAll('a[href^="#"]').forEach(function (a) {
			a.addEventListener('click', function (e) {
				var href = this.getAttribute('href');
				if (!href || href.length < 2) return;
				var target = document.querySelector(href);
				if (target) {
					e.preventDefault();
					target.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}
			});
		});

		var helpPanel = document.getElementById('helpChatPanel');
		var helpToggle = document.getElementById('helpChatToggle');
		var helpInput = document.getElementById('helpChatInput');
		var helpMessages = document.getElementById('helpChatMessages');
		var temporizadorInactividadAyuda = null;
		var temporizadorCierreChatAyuda = null;
		var esperaDecisionInactividad = false;
		var conversacionFinalizadaAyuda = false;
		var accionesAyudaActuales = [];
		var accionesAntesInactividad = [];
		var bienvenidaChatAyuda = '¡Hola! Puedo responder tus preguntas, buscar profesionales, consultar sus horarios y ayudarte a agendar. ¿Qué necesitas?';
		function toggleHelpChat(open) {
			helpPanel.hidden = !open;
			helpToggle.setAttribute('aria-expanded', String(open));
			if (open) {
				if (conversacionFinalizadaAyuda) iniciarNuevaConversacionChat();
				helpInput.focus();
				programarTemporizadorInactividad();
			}
			else { window.clearTimeout(temporizadorInactividadAyuda); temporizadorInactividadAyuda = null; }
		}
		helpToggle.addEventListener('click', function () { toggleHelpChat(helpPanel.hidden); });
		document.getElementById('helpChatClose').addEventListener('click', function () { toggleHelpChat(false); });
		var ayudaLink = document.getElementById('ayudaLink');
		if (ayudaLink) ayudaLink.addEventListener('click', function (e) {
			e.preventDefault();
			toggleHelpChat(true);
			var links = document.querySelector('.nav-links');
			var actions = document.querySelector('.nav-actions');
			if (links) links.classList.remove('open');
			if (actions) actions.classList.remove('open');
		});
		var apiAyuda = 'http://127.0.0.1:8000/api';
		var flujoReserva = null;
		var busquedaProfesional = null;
		var historialAyuda = [{ role: 'assistant', content: bienvenidaChatAyuda, reserva: false }];
		var listaAcciones = document.getElementById('helpChatPrompts');
		function normalizarAyuda(texto) { return String(texto || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); }
		function diaSolicitado(q) {
			var dias = ['domingo', 'lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado'];
			for (var i = 0; i < dias.length; i++) if (new RegExp('\\b' + dias[i] + 's?\\b').test(q)) return i;
			return -1;
		}
		function fechaProximoDia(dia) {
			var fecha = new Date();
			var diferencia = (dia - fecha.getDay() + 7) % 7 || 7;
			fecha.setDate(fecha.getDate() + diferencia);
			return [fecha.getFullYear(), String(fecha.getMonth() + 1).padStart(2, '0'), String(fecha.getDate()).padStart(2, '0')].join('-');
		}
		async function consultarDisponibilidadChat(pregunta) {
			var q = normalizarAyuda(pregunta);
			var dia = diaSolicitado(q);
			if (dia < 0 || !(/disponib|quien.*(atiende|trabaja|puede|libre)|hay.*profesional|busco.*profesional/.test(q))) return false;
			var nombresDias = ['domingo', 'lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado'];
			var fecha = fechaProximoDia(dia);
			try {
				var respuesta = await fetch(apiAyuda + '/servicios');
				if (!respuesta.ok) throw new Error();
				var servicios = await respuesta.json();
				if (!Array.isArray(servicios)) servicios = servicios.value || [];
				var stop = /^(quien|esta|estan|disponible|disponibles|para|el|la|los|las|este|esta|proximo|proxima|hay|algun|alguna|profesional|profesionales|trabajador|trabajadores|atiende|trabaja|puede|libre|busco|servicio|servicios|de|en|por|favor|me|pueden|puede|lunes|martes|miercoles|jueves|viernes|sabado|domingo)$/;
				var terminos = q.replace(/\b(lunes|martes|miercoles|jueves|viernes|sabado|domingo)\b/g, ' ').split(/\s+/).filter(function (p) { return p.length > 2 && !stop.test(p); });
				if (terminos.length) {
					var coinciden = servicios.filter(function (s) {
						var datos = normalizarAyuda([s.Titulo, s.Nombre_Categoria, s.Nombre_Trabajador, s.Ubicacion].join(' '));
						return terminos.some(function (p) { return datos.includes(p); });
					});
					if (coinciden.length) servicios = coinciden;
				}
				var respuestaHorarios = await fetch(apiAyuda + '/disponibilidad');
				if (!respuestaHorarios.ok) throw new Error();
				var horarios = await respuestaHorarios.json();
				if (!Array.isArray(horarios)) horarios = horarios.value || [];
				var resultados = servicios.map(function (s) {
					var coincidencias = horarios.filter(function (h) {
						return String(h.Id_Servicio) === String(s.Id_Servicio) && normalizarAyuda(h.Dia_Semana) === nombresDias[dia];
					});
					if (!coincidencias.length) return null;
					return { servicio: s, horas: coincidencias.map(function (h) {
						var inicio = String(h.Hora_Inicio || '').slice(0, 5), fin = String(h.Hora_Fin || '').slice(0, 5);
						return String(h.Hora_Fin) === '23:59:59' ? 'todo el día' : inicio + ' a ' + fin;
					}).join(', ') };
				});
				resultados = resultados.filter(Boolean).slice(0, 6);
				if (!resultados.length) {
					addHelpMessage('No encontré servicios con horario publicado para el ' + nombresDias[dia] + ' ' + fecha + (terminos.length ? ' que coincidan con lo que buscas.' : '.') + ' Si me dices qué servicio y ciudad necesitas, puedo afinar la búsqueda.', 'bot');
					accionesAyuda([{ label: 'Ver categorías', action: 'categories' }]);
					return true;
				}
				addHelpMessage('Para el ' + nombresDias[dia] + ' ' + fecha + ' encontré estos horarios publicados:\n' + resultados.map(function (r) {
					var s = r.servicio;
					return '• ' + (s.Nombre_Trabajador || 'Profesional') + ' — ' + (s.Titulo || s.Nombre_Categoria || 'Servicio') + ' (' + (s.Ubicacion || 'ubicación no indicada') + '): ' + r.horas;
				}).join('\n') + '\n\nEl horario publicado no confirma que cada hora siga libre; la disponibilidad exacta se verifica al enviar la solicitud.', 'bot');
				accionesAyuda(resultados.map(function (r) {
					return { label: 'Ver perfil: ' + (r.servicio.Nombre_Trabajador || 'Profesional'), action: 'profile', value: '/trabajador/perfil/?id=' + encodeURIComponent(r.servicio.Id_Trabajador) + '&servicioId=' + encodeURIComponent(r.servicio.Id_Servicio) };
				}));
				return true;
			} catch (_) {
				addHelpMessage('No pude consultar los horarios ahora. Intenta de nuevo en un momento.', 'bot');
				return true;
			}
		}
		async function buscarProfesionalesChat(pregunta) {
			var q = normalizarAyuda(pregunta);
			var ultimaRespuesta = '';
			for (var i = historialAyuda.length - 2; i >= 0; i--) {
				if (historialAyuda[i].role === 'assistant') { ultimaRespuesta = normalizarAyuda(historialAyuda[i].content); break; }
			}
			var esperandoCiudadPorContexto = /ciudad|barrio|zona/.test(ultimaRespuesta) && /profesional|servicio|busc/.test(ultimaRespuesta);
			var stop = /^(quiero|busco|buscar|necesito|necesitamos|un|una|unos|unas|el|la|los|las|de|del|en|por|favor|profesional|profesionales|trabajador|trabajadores|servicio|servicios|alguien|que|me|ayude|ayuda|para|con|tienes|tienen|hay|puedes|puede|como|contactar|contacto|ver|encontrar|ciudad|barrio|zona|esta|estoy|vivo|disponible|disponibles|lunes|martes|miercoles|jueves|viernes|sabado|domingo)$/;
			var terminos = q.split(/[^a-z0-9]+/).filter(function (p) { return p.length > 2 && !stop.test(p); });
			var servicioDirecto = /\b(manicure|manicura|peluqueria|plomeria|aseo|limpieza|belleza|electricista|carpinteria|pintura|jardineria|cerrajeria|mudanza|domicilio|mandados)\b/.test(q);
			var inicioExplicito = /\b(busca|buscar|busco|necesito|quiero|encuentra|encontrar|contactar|ver perfil)\b/.test(q) && /\b(profesional|trabajador|servicio|manicure|manicura|plomer|aseo|belleza|electric|carpinter|pintor|jardin|tecnico)\w*/.test(q);
			var busquedaDirecta = servicioDirecto && !/[?¿]/.test(pregunta) && terminos.length <= 4;
			if (!busquedaProfesional && !inicioExplicito && !busquedaDirecta && !esperandoCiudadPorContexto) return false;
			if (!inicioExplicito && !busquedaDirecta && (/[?¿]/.test(pregunta) || /^(como|que|quien|cuando|donde|por que|cuanto|cual)\b/.test(q))) return false;
			try {
				var respuesta = await fetch(apiAyuda + '/servicios');
				if (!respuesta.ok) throw new Error();
				var servicios = await respuesta.json();
				if (!Array.isArray(servicios)) servicios = servicios.value || [];
				var ubicacionConocida = servicios.map(function (s) { return String(s.Ubicacion || '').trim(); }).filter(Boolean).find(function (ubicacion) {
					var ubicacionNormalizada = normalizarAyuda(ubicacion);
					return q.includes(ubicacionNormalizada) || ubicacionNormalizada.split(/[^a-z0-9]+/).some(function (parte) { return parte.length > 3 && q.split(/[^a-z0-9]+/).includes(parte); });
				});
				if (busquedaProfesional && busquedaProfesional.paso === 'ciudad') {
					busquedaProfesional.ubicacion = ubicacionConocida || pregunta.trim();
					busquedaProfesional.paso = 'resultados';
				} else {
					var terminosServicio = terminos.filter(function (p) { return !ubicacionConocida || !normalizarAyuda(ubicacionConocida).includes(p); });
					var candidatos = terminosServicio.length ? servicios.filter(function (s) {
						var datos = normalizarAyuda([s.Titulo, s.Nombre_Categoria].join(' '));
						return terminosServicio.some(function (p) { return datos.includes(p); });
					}) : [];
					if (!candidatos.length && esperandoCiudadPorContexto && terminosServicio.length) {
						candidatos = servicios.filter(function (s) {
							var datos = normalizarAyuda([s.Titulo, s.Nombre_Categoria].join(' '));
							return terminosServicio.some(function (p) { return datos.includes(p); });
						});
					}
					if (terminosServicio.length && !candidatos.length) {
						addHelpMessage('No encontré servicios publicados que coincidan con «' + terminosServicio.join(' ') + '» en el catálogo actual. Prueba con otro servicio o revisa las categorías.', 'bot');
						accionesAyuda([{ label: 'Ver categorías', action: 'categories' }]);
						busquedaProfesional = null;
						return true;
					}
					if (!candidatos.length && !inicioExplicito && !esperandoCiudadPorContexto) return false;
					busquedaProfesional = { terminos: terminosServicio, ubicacion: ubicacionConocida || '', paso: ubicacionConocida ? 'resultados' : 'ciudad' };
					if (!busquedaProfesional.terminos.length && !ubicacionConocida) {
						busquedaProfesional.paso = 'servicio';
						addHelpMessage('¿Qué servicio necesitas y en qué ciudad? Así busco profesionales concretos en el catálogo.', 'bot');
						accionesAyuda([]);
						return true;
					}
					if (candidatos.length) busquedaProfesional.terminos = terminosServicio;
