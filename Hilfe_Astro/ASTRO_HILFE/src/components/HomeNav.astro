				}
				addHelpMessage('Encontré estas opciones de ' + (busquedaProfesional.terminos.join(' ') || 'servicio') + ' en ' + busquedaProfesional.ubicacion + ':\n' + encontrados.map(function (s) {
					return '• ' + (s.Nombre_Trabajador || 'Profesional') + ' — ' + (s.Titulo || s.Nombre_Categoria || 'Servicio') + (s.Precio ? ' · $' + Number(s.Precio).toLocaleString('es-CO') : '');
				}).join('\n') + '\n\nAbre un perfil para revisar los detalles y contactar al profesional.', 'bot');
				accionesAyuda(encontrados.map(function (s) {
