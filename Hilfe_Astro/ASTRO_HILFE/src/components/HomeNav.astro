<script is:inline>
	(function () {
		var navbar = document.getElementById('navbar');
		var acciones = document.querySelector('.nav-actions');
		var usuario;
		var token;
		try {
			token = localStorage.getItem('token');
			usuario = JSON.parse(localStorage.getItem('usuario') || 'null');
		} catch (e) { usuario = null; token = null; }
		var sesionActiva = typeof token === 'string' && token.trim().length > 0 &&
			usuario && typeof usuario === 'object' && typeof usuario.nombre === 'string' &&
			usuario.nombre.trim().length > 0;
		var botonLogin = acciones && acciones.querySelector('.btn-login');
		var botonRegistro = acciones && acciones.querySelector('.btn-register');		
		if (botonLogin) botonLogin.hidden = Boolean(sesionActiva);
		if (botonRegistro) botonRegistro.hidden = Boolean(sesionActiva);
		if (sesionActiva && acciones) {
			var destinos = { 1: '/admin/admin', 2: '/trabajador/', 3: '/cliente/' };
			var enlaceExistente = acciones.querySelector('.nav-user');
			if (enlaceExistente) enlaceExistente.remove();
			var enlaceUsuario = document.createElement('a');
			enlaceUsuario.className = 'nav-user';
			enlaceUsuario.href = destinos[Number(usuario.rol)] || '/';
			enlaceUsuario.setAttribute('aria-label', 'Sesión iniciada como ' + usuario.nombre);
			var inicial = document.createElement('span');
			inicial.className = 'nav-user-initial';
			inicial.textContent = usuario.nombre.trim().charAt(0).toUpperCase();
			var nombre = document.createElement('span');
			nombre.className = 'nav-user-name';
			nombre.textContent = usuario.nombre.trim();
			enlaceUsuario.append(inicial, nombre);
			acciones.appendChild(enlaceUsuario);
		} else if (acciones) {
			var enlaceExistente = acciones.querySelector('.nav-user');
			if (enlaceExistente) enlaceExistente.remove();
		}
		var ticking = false;
		window.addEventListener('scroll', function () {
			if (!ticking) {
				requestAnimationFrame(function () {
					if (navbar) navbar.classList.toggle('scrolled', window.scrollY > 60);
					ticking = false;
				});
				ticking = true;
			}
		});

		var navToggle = document.getElementById('navToggle');
		if (navToggle) {
			navToggle.addEventListener('click', function () {
				var links = document.querySelector('.nav-links');
				var actions = document.querySelector('.nav-actions');
				if (links) links.classList.toggle('open');
				if (actions) actions.classList.toggle('open');
				this.classList.toggle('active');
			});
		}

		document.querySelectorAll('a[href^="#"]').forEach(function (a) {
			a.addEventListener('click', function (e) {
				var href = this.getAttribute('href');
				if (!href || href.length < 2) return;
				var target = document.querySelector(href);
				if (target) {
					e.preventDefault();
					target.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}
			});
		});

		var ayudaLink = document.getElementById('ayudaLink');
		if (ayudaLink) {
			ayudaLink.addEventListener('click', function (e) {
				e.preventDefault();
				var existing = document.getElementById('ayudaToast');
				if (existing) existing.remove();
				var toast = document.createElement('div');
				toast.id = 'ayudaToast';
				toast.style.cssText =
					'position:fixed;bottom:24px;right:24px;background:var(--primary);color:#fff;padding:14px 22px;border-radius:14px;font-size:14px;font-weight:600;box-shadow:0 8px 30px rgba(0,0,0,.15);z-index:9999;animation:fadeUp .3s ease;max-width:340px';
				toast.innerHTML = 'Te contactaremos lo más pronto posible.';
				document.body.appendChild(toast);
				setTimeout(function () {
					toast.style.opacity = '0';
					toast.style.transition = 'opacity .3s';
					setTimeout(function () {
						toast.remove();
					}, 300);
				}, 3000);
			});
		}
	})();
</script>
