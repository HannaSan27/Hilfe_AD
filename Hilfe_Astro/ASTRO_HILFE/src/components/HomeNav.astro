		async function reservarServicio(servicio, fecha, hora, direccion) {
			var diaNombre = new Intl.DateTimeFormat('es-CO', { weekday: 'long', timeZone: 'UTC' }).format(new Date(fecha + 'T12:00:00Z'));
			var diaNormal = normalizarAyuda(diaNombre);
			var resDisp = await fetch(apiAyuda + '/disponibilidad?servicio=' + encodeURIComponent(servicio.Id_Servicio));
			if (!resDisp.ok) throw new Error('No se pudo comprobar el horario publicado.');
			var horarios = await resDisp.json(); if (!Array.isArray(horarios)) horarios = horarios.value || [];
			var rangos = horarios.filter(function (h) { return String(h.Id_Servicio) === String(servicio.Id_Servicio) && normalizarAyuda(h.Dia_Semana) === diaNormal; });
			var permitido = rangos.some(function (h) {
				var fin = String(h.Hora_Fin || '').slice(0, 5);
				return hora >= String(h.Hora_Inicio || '').slice(0, 5) && (String(h.Hora_Fin) === '23:59:59' ? hora <= '23:59' : hora < fin);
			});
			if (!permitido) throw new Error('Ese día u hora no está dentro del horario publicado. Indica otra fecha y hora (formato AAAA-MM-DD y HH:MM).');
			var ocupadasRes = await fetch(apiAyuda + '/solicitudes/horarios-ocupados?trabajador=' + encodeURIComponent(servicio.Id_Trabajador) + '&fecha=' + encodeURIComponent(fecha));
			if (!ocupadasRes.ok) throw new Error('No se pudo confirmar si esa hora está ocupada. Intenta nuevamente.');
			var ocupadas = await ocupadasRes.json(); if (!Array.isArray(ocupadas)) ocupadas = ocupadas.value || [];
			if (ocupadas.some(function (h) { return String(h).slice(0, 5) === hora; })) throw new Error('Esa hora ya está ocupada. Indica otra hora disponible.');
			flujoReserva.fecha = fecha; flujoReserva.hora = hora; flujoReserva.direccion = direccion;
			flujoReserva.paso = 'confirmar';
			var precio = Number(servicio.Precio) || 0;
			addHelpMessage('Confirma los datos de tu solicitud:\n• Servicio: ' + (servicio.Titulo || 'Servicio') + '\n• Profesional: ' + (servicio.Nombre_Trabajador || 'Profesional') + '\n• Fecha: ' + fecha + ' a las ' + hora + '\n• Dirección: ' + direccion + (precio ? '\n• Precio publicado: $' + precio.toLocaleString('es-CO') : '') + '\n\n¿La envío?', 'bot');
			accionesAyuda([{ label: 'Sí, enviar solicitud', action: 'confirm' }, { label: 'Cancelar', action: 'cancel' }]);
		}
		async function responderDudaDuranteReserva(pregunta) {
