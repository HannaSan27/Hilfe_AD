						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
						Facebook
					</a>
					<a href="https://www.instagram.com/hilfe.soluciones?igsh=MThuamdrcW4xNXFiNQ==" target="_blank" class="nav-dropdown-item">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678a6.162 6.162 0 100 12.324 6.162 6.162 0 100-12.324zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405a1.441 1.441 0 11-2.882 0 1.441 1.441 0 012.882 0z"/></svg>
						Instagram
					</a>
				</div>
			</li>
			<li><a href="/#como-funciona" id="ayudaLink">Ayuda</a></li>
		</ul>
		<div class="nav-actions">
			<button type="button" class="theme-toggle" aria-label="Cambiar tema">
				<svg class="theme-icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
				<svg class="theme-icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
			</button>
			<a href="/login/login" class="btn-login">Iniciar sesión</a>
			<a href="/login/registrar" class="btn-register">Registrarse</a>
			<BotonBilletera />
			<UserMenu variant="nav" />
		</div>
		<button class="nav-toggle" id="navToggle" aria-label="Menú">
			<span></span><span></span><span></span>
		</button>
	</div>
</nav>

<div class="help-chat" id="helpChat">
	<section class="help-chat-panel" id="helpChatPanel" aria-label="Chat de ayuda" hidden>
		<header class="help-chat-header">
			<div><strong>Ayuda Hilf'e</strong><span>Pregúntame lo que necesites</span></div>
			<button type="button" class="help-chat-close" id="helpChatClose" aria-label="Cerrar chat">×</button>
		</header>
		<div class="help-chat-messages" id="helpChatMessages" aria-live="polite">
			<div class="help-chat-message bot">¡Hola! Puedo ayudarte con dudas sobre cómo buscar servicios, contactar profesionales o usar tu cuenta. ¿Qué necesitas?</div>
		</div>
		<div class="help-chat-prompts" id="helpChatPrompts">
			<button type="button">¿Cómo encuentro un profesional?</button>
			<button type="button">¿Cómo contacto a un profesional?</button>
			<button type="button">¿Cómo creo una cuenta?</button>
			<button type="button">Quiero agendar un servicio</button>
		</div>
		<form class="help-chat-form" id="helpChatForm">
			<label class="sr-only" for="helpChatInput">Escribe tu pregunta</label>
			<input id="helpChatInput" type="text" placeholder="Escribe tu pregunta…" autocomplete="off" />
			<button type="submit" aria-label="Enviar pregunta">Enviar</button>
		</form>
	</section>
	<button type="button" class="help-chat-toggle" id="helpChatToggle" aria-expanded="false" aria-controls="helpChatPanel">
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
		<span>Ayuda</span>
	</button>
</div>

<script is:inline>
	(function () {
		var navbar = document.getElementById('navbar');
		var acciones = document.querySelector('.nav-actions');
		var usuario;
		var token;
		try {
			token = localStorage.getItem('token');
			usuario = JSON.parse(localStorage.getItem('usuario') || 'null');
		} catch (e) { usuario = null; token = null; }
		var sesionActiva = typeof token === 'string' && token.trim().length > 0 &&
			usuario && typeof usuario === 'object' && typeof (usuario.nombre || usuario.Nombre) === 'string' &&
			(usuario.nombre || usuario.Nombre).trim().length > 0;
		var botonLogin = acciones && acciones.querySelector('.btn-login');
		var botonRegistro = acciones && acciones.querySelector('.btn-register');
		if (botonLogin) botonLogin.hidden = Boolean(sesionActiva);
		if (botonRegistro) botonRegistro.hidden = Boolean(sesionActiva);
		var ticking = false;
		window.addEventListener('scroll', function () {
			if (!ticking) {
				requestAnimationFrame(function () {
					if (navbar) navbar.classList.toggle('scrolled', window.scrollY > 60);
					ticking = false;
				});
				ticking = true;
			}
		});

		var navToggle = document.getElementById('navToggle');
		if (navToggle) {
			navToggle.addEventListener('click', function () {
				var links = document.querySelector('.nav-links');
				var actions = document.querySelector('.nav-actions');
				if (links) links.classList.toggle('open');
				if (actions) actions.classList.toggle('open');
				this.classList.toggle('active');
			});
		}

		document.querySelectorAll('a[href^="#"]').forEach(function (a) {
			a.addEventListener('click', function (e) {
				var href = this.getAttribute('href');
				if (!href || href.length < 2) return;
				var target = document.querySelector(href);
				if (target) {
					e.preventDefault();
					target.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}
			});
		});

		var helpPanel = document.getElementById('helpChatPanel');
		var helpToggle = document.getElementById('helpChatToggle');
		var helpInput = document.getElementById('helpChatInput');
		var helpMessages = document.getElementById('helpChatMessages');
		function toggleHelpChat(open) {
			helpPanel.hidden = !open;
			helpToggle.setAttribute('aria-expanded', String(open));
			if (open) helpInput.focus();
		}
		helpToggle.addEventListener('click', function () { toggleHelpChat(helpPanel.hidden); });
		document.getElementById('helpChatClose').addEventListener('click', function () { toggleHelpChat(false); });
		var ayudaLink = document.getElementById('ayudaLink');
		if (ayudaLink) ayudaLink.addEventListener('click', function (e) {
			e.preventDefault();
			toggleHelpChat(true);
			var links = document.querySelector('.nav-links');
			var actions = document.querySelector('.nav-actions');
			if (links) links.classList.remove('open');
			if (actions) actions.classList.remove('open');
		});
		var apiAyuda = 'http://127.0.0.1:8000/api';
		var flujoReserva = null;
		var historialAyuda = [{ role: 'assistant', content: '¡Hola! Puedo ayudarte con dudas sobre cómo buscar servicios, contactar profesionales o usar tu cuenta. ¿Qué necesitas?', reserva: false }];
		var listaAcciones = document.getElementById('helpChatPrompts');
		function normalizarAyuda(texto) { return String(texto || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); }
		async function consultarIAChat(pregunta) {
			try {
				var response = await fetch(apiAyuda + '/chat-ayuda', {
					method: 'POST', headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						mensaje: pregunta,
						historial: flujoReserva ? [] : historialAyuda.filter(function (turno) { return !turno.reserva; }).slice(-10, -1)
					})
				});
				var data = await response.json().catch(function () { return {}; });
				if (!response.ok) throw new Error(data.mensaje || 'No pude consultar al asistente. Inténtalo de nuevo.');
				return data.respuesta || 'No recibí una respuesta. Inténtalo de nuevo.';
			} catch (error) {
				return error && error.message ? error.message : 'No hay conexión con el asistente en este momento.';
			}
		}
		function addHelpMessage(text, kind) {
			var message = document.createElement('div');
			message.className = 'help-chat-message ' + kind;
			message.textContent = text;
			helpMessages.appendChild(message);
			historialAyuda.push({ role: kind === 'user' ? 'user' : 'assistant', content: String(text), reserva: Boolean(flujoReserva) });
			if (historialAyuda.length > 20) historialAyuda.splice(1, historialAyuda.length - 20);
			helpMessages.scrollTop = helpMessages.scrollHeight;
		}
		function accionesAyuda(items) {
			listaAcciones.replaceChildren();
			(items || []).forEach(function (item) {
				var button = document.createElement('button'); button.type = 'button'; button.textContent = item.label;
				button.dataset.helpAction = item.action || ''; button.dataset.helpValue = item.value || '';
				listaAcciones.appendChild(button);
			});
		}
		function agregarMensajeUsuario(clean) {
			addHelpMessage(clean, 'user');
		}
		function sesionCliente() {
			try { var user = JSON.parse(localStorage.getItem('usuario') || 'null'); return user && Number(user.rol) === 3 && user.id ? user : null; }
			catch (_) { return null; }
		}
		async function iniciarAgendamiento(texto) {
			var user = sesionCliente();
			if (!user) {
				addHelpMessage('Para crear una solicitud necesito que inicies sesión con una cuenta de cliente. Después vuelve aquí y te ayudo a agendar.', 'bot');
				accionesAyuda([{ label: 'Iniciar sesión', action: 'login' }, { label: 'Crear cuenta', action: 'register' }]);
				return;
			}
			flujoReserva = { paso: 'servicio', cliente: user };
			try {
				var respuesta = await fetch(apiAyuda + '/servicios');
				if (!respuesta.ok) throw new Error('No se pudo consultar el catálogo de servicios.');
				var servicios = await respuesta.json();
				if (!Array.isArray(servicios)) servicios = servicios.value || [];
				var q = normalizarAyuda(texto).replace(/quiero|ayudame|ayuda|agendar|agenda|reservar|reserva|un servicio|servicio de|por favor/g, '').trim();
				var coinciden = servicios.filter(function (s) {
					var nombre = normalizarAyuda([s.Titulo, s.Nombre_Categoria, s.Nombre_Trabajador].join(' '));
					return !q || q.split(/\s+/).some(function (palabra) { return palabra.length > 2 && nombre.includes(palabra); });
				}).slice(0, 6);
				flujoReserva.servicios = coinciden.length ? coinciden : servicios.slice(0, 6);
				if (!flujoReserva.servicios.length) throw new Error('No hay servicios disponibles en este momento.');
				addHelpMessage('Claro. Elige el servicio y profesional con quien quieres agendar:', 'bot');
				accionesAyuda(flujoReserva.servicios.map(function (s, i) { return { label: (s.Titulo || 'Servicio') + ' · ' + (s.Nombre_Trabajador || 'Profesional'), action: 'service', value: String(i) }; }));
			} catch (error) {
				flujoReserva = null;
				addHelpMessage(error.message + ' Puedes abrir “Categorías” y seleccionar “Ver perfil” para agendar desde allí.', 'bot');
			}
		}
		async function buscarAlternativas(texto) {
			var q = normalizarAyuda(texto).replace(/\b(que|otro|otros|otra|otras|profesional|profesionales|trabajador|trabajadores|hay|opcion|opciones|alternativa|alternativas|de|del|la|el|en|para|un|una|mas|busco|quiero|cambiar|dime)\b/g, ' ').replace(/\s+/g, ' ').trim();
			var palabras = q.split(' ').filter(function (palabra) { return palabra.length > 2; });
			var actual = flujoReserva.servicio;
			if (!palabras.length && !(actual && actual.Id_Categoria)) {
				flujoReserva.paso = 'alternativa';
				addHelpMessage('Claro. ¿De qué servicio o categoría quieres ver otro profesional? Por ejemplo: arreglos, plomería, aseo o belleza.', 'bot');
				return;
			}
			try {
				var response = await fetch(apiAyuda + '/servicios');
				if (!response.ok) throw new Error();
				var servicios = await response.json(); if (!Array.isArray(servicios)) servicios = servicios.value || [];
				var trabajadoresIncluidos = new Set();
				var opciones = servicios.filter(function (s) {
					if (actual && String(s.Id_Trabajador) === String(actual.Id_Trabajador)) return false;
					var datos = normalizarAyuda([s.Titulo, s.Nombre_Categoria, s.Nombre_Trabajador].join(' '));
					var coincide = palabras.length
						? palabras.some(function (palabra) { return datos.includes(palabra); })
						: String(s.Id_Categoria) === String(actual.Id_Categoria);
					if (!coincide || trabajadoresIncluidos.has(String(s.Id_Trabajador))) return false;
					trabajadoresIncluidos.add(String(s.Id_Trabajador));
					return true;
				}).slice(0, 6);
				if (!opciones.length) {
					if (!palabras.length) {
						flujoReserva.paso = 'alternativa';
						addHelpMessage('No encontré otro profesional de esta categoría. ¿Quieres buscar en otra? Escribe el servicio o categoría, por ejemplo arreglos o plomería.', 'bot');
					} else addHelpMessage('No encontré otro profesional con servicios relacionados con «' + texto + '». Prueba con el nombre de una categoría o servicio, como arreglos o plomería.', 'bot');
					return;
				}
				flujoReserva.servicios = opciones;
				flujoReserva.paso = 'elegirAlternativa';
				addHelpMessage('Encontré estas opciones. Elige el profesional con quien quieres continuar:', 'bot');
				accionesAyuda(opciones.map(function (s, i) { return { label: (s.Titulo || s.Nombre_Categoria || 'Servicio') + ' · ' + (s.Nombre_Trabajador || 'Profesional'), action: 'service', value: String(i) }; }));
			} catch (_) { addHelpMessage('No pude cargar otros profesionales en este momento. Intenta de nuevo.', 'bot'); }
		}
		async function reservarServicio(servicio, fecha, hora, direccion) {
			var diaNombre = new Intl.DateTimeFormat('es-CO', { weekday: 'long', timeZone: 'UTC' }).format(new Date(fecha + 'T12:00:00Z'));
			var diaNormal = normalizarAyuda(diaNombre);
			var resDisp = await fetch(apiAyuda + '/disponibilidad?servicio=' + encodeURIComponent(servicio.Id_Servicio));
			if (!resDisp.ok) throw new Error('No se pudo comprobar el horario publicado.');
			var horarios = await resDisp.json(); if (!Array.isArray(horarios)) horarios = horarios.value || [];
			var rangos = horarios.filter(function (h) { return String(h.Id_Servicio) === String(servicio.Id_Servicio) && normalizarAyuda(h.Dia_Semana) === diaNormal; });
			var permitido = rangos.some(function (h) {
				var fin = String(h.Hora_Fin || '').slice(0, 5);
				return hora >= String(h.Hora_Inicio || '').slice(0, 5) && (String(h.Hora_Fin) === '23:59:59' ? hora <= '23:59' : hora < fin);
			});
			if (!permitido) throw new Error('Ese día u hora no está dentro del horario publicado. Indica otra fecha y hora (formato AAAA-MM-DD y HH:MM).');
			var ocupadasRes = await fetch(apiAyuda + '/solicitudes/horarios-ocupados?trabajador=' + encodeURIComponent(servicio.Id_Trabajador) + '&fecha=' + encodeURIComponent(fecha));
			if (!ocupadasRes.ok) throw new Error('No se pudo confirmar si esa hora está ocupada. Intenta nuevamente.');
			var ocupadas = await ocupadasRes.json(); if (!Array.isArray(ocupadas)) ocupadas = ocupadas.value || [];
			if (ocupadas.some(function (h) { return String(h).slice(0, 5) === hora; })) throw new Error('Esa hora ya está ocupada. Indica otra hora disponible.');
			flujoReserva.fecha = fecha; flujoReserva.hora = hora; flujoReserva.direccion = direccion;
			flujoReserva.paso = 'confirmar';
			var precio = Number(servicio.Precio) || 0;
			addHelpMessage('Confirma los datos de tu solicitud:\n• Servicio: ' + (servicio.Titulo || 'Servicio') + '\n• Profesional: ' + (servicio.Nombre_Trabajador || 'Profesional') + '\n• Fecha: ' + fecha + ' a las ' + hora + '\n• Dirección: ' + direccion + (precio ? '\n• Precio publicado: $' + precio.toLocaleString('es-CO') : '') + '\n\n¿La envío?', 'bot');
			accionesAyuda([{ label: 'Sí, enviar solicitud', action: 'confirm' }, { label: 'Cancelar', action: 'cancel' }]);
		}
		async function responderDudaDuranteReserva(pregunta) {
			var q = normalizarAyuda(pregunta);
			var servicio = flujoReserva && flujoReserva.servicio;
			if (/horario|disponib|que dia|que hora|cuando atiende/.test(q) && servicio) {
				try {
					var response = await fetch(apiAyuda + '/disponibilidad?servicio=' + encodeURIComponent(servicio.Id_Servicio));
					if (!response.ok) throw new Error();
					var horarios = await response.json(); if (!Array.isArray(horarios)) horarios = horarios.value || [];
					horarios = horarios.filter(function (h) { return String(h.Id_Servicio) === String(servicio.Id_Servicio); });
					var texto = horarios.map(function (h) {
						var inicio = String(h.Hora_Inicio || '').slice(0, 5), fin = String(h.Hora_Fin || '').slice(0, 5);
						return h.Dia_Semana + ': ' + (String(h.Hora_Fin) === '23:59:59' ? 'todo el día' : inicio + ' a ' + fin);
					});
					var siguientePaso = flujoReserva.paso === 'fecha' ? '\n\nPara continuar, indícame una fecha como AAAA-MM-DD.' : flujoReserva.paso === 'hora' ? '\n\nPara continuar, indícame una hora como HH:MM.' : flujoReserva.paso === 'direccion' ? '\n\nLuego puedes continuar con la dirección del servicio.' : '';
					return texto.length ? 'El horario publicado para ' + (servicio.Titulo || 'este servicio') + ' es:\n• ' + texto.join('\n• ') + '\n\nLa disponibilidad puede cambiar; comprobaré la fecha y hora exactas antes de enviar la solicitud.' + siguientePaso : 'Este profesional todavía no ha publicado horarios para ese servicio. Puedes elegir otro profesional.';
				} catch (_) { return 'No pude consultar el horario ahora. Intenta de nuevo en un momento; conservaré los datos que ya ingresaste.'; }
			}
			if (/precio|cuesta|cuanto vale|valor/.test(q) && servicio) return 'El precio publicado para ' + (servicio.Titulo || 'este servicio') + ' es $' + (Number(servicio.Precio) || 0).toLocaleString('es-CO') + '. Puedes acordar detalles adicionales directamente con el profesional.';
			if (/cancel|empezar de nuevo/.test(q)) { flujoReserva = null; accionesAyuda([{ label: 'Agendar un servicio', action: 'book' }]); return 'Cancelé el agendamiento. Cuando quieras, empezamos de nuevo.'; }
			if (/como funciona|que pasa|confirm|solicitud/.test(q)) return 'Al confirmar, se envía una solicitud al profesional. Quedará pendiente hasta que la acepte. Puedes revisar su estado en “Mis citas”.';
			if (/direccion|donde/.test(q) && flujoReserva.paso === 'direccion') return 'Escribe la dirección donde se realizará el servicio. Solo se incluirá en la solicitud que verá el profesional.';
			var respuestaIA = await consultarIAChat(pregunta);
			return respuestaIA + '\n\n' + (flujoReserva.paso === 'fecha' ? 'Cuando estés listo, indícame una fecha como AAAA-MM-DD.' : flujoReserva.paso === 'hora' ? 'Cuando estés listo, indícame una hora como HH:MM.' : flujoReserva.paso === 'direccion' ? 'Cuando estés listo, indícame la dirección.' : 'Puedes responder “sí” para continuar o cancelar el agendamiento.');
		}
		async function procesarAccionAyuda(action, value) {
			if (action === 'login') { window.location.href = '/login/login'; return; }
			if (action === 'register') { window.location.href = '/login/registrar'; return; }
			if (action === 'cancel') { flujoReserva = null; accionesAyuda([{ label: 'Quiero agendar un servicio', action: 'book' }]); addHelpMessage('Listo, cancelé la solicitud. Si quieres, podemos empezar de nuevo.', 'bot'); return; }
			if (action === 'service' && flujoReserva) {
				flujoReserva.servicio = flujoReserva.servicios[Number(value)]; flujoReserva.paso = 'fecha';
				flujoReserva.fecha = ''; flujoReserva.hora = ''; flujoReserva.direccion = '';
				addHelpMessage('Elegiste ' + flujoReserva.servicio.Titulo + ' con ' + (flujoReserva.servicio.Nombre_Trabajador || 'el profesional') + '. ¿Qué fecha quieres? Escríbela como AAAA-MM-DD (por ejemplo, 2026-10-22).', 'bot');
				accionesAyuda([]); return;
			}
			if (action === 'confirm' && flujoReserva) {
				try {
					var s = flujoReserva.servicio;
					var response = await fetch(apiAyuda + '/solicitudes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
						Id_Cliente: flujoReserva.cliente.id, Id_Trabajador: s.Id_Trabajador, Id_Servicio: s.Id_Servicio,
						Fecha_Servicio: flujoReserva.fecha, Hora_Servicio: flujoReserva.hora, Direccion: flujoReserva.direccion,
						Telefono: flujoReserva.cliente.telefono || flujoReserva.cliente.Telefono || null,
						Descripcion_Solicitud: 'Solicitud creada desde el chat de ayuda.'
					}) });
					var result = await response.json().catch(function () { return {}; });
					if (!response.ok) throw new Error(result.mensaje || result.error || 'No fue posible enviar la solicitud.');
					flujoReserva = null; accionesAyuda([{ label: 'Ver mis citas', action: 'appointments' }]);
					addHelpMessage('¡Solicitud enviada! Quedó pendiente de confirmación por el profesional. Puedes consultar su estado en “Mis citas”.', 'bot');
				} catch (error) { addHelpMessage(error.message, 'bot'); accionesAyuda([{ label: 'Volver a intentar', action: 'confirm' }, { label: 'Cancelar', action: 'cancel' }]); }
			}
			if (action === 'appointments') window.location.href = '/cliente/citas/';
		}
		async function sendHelpQuestion(question) {
			var clean = question.trim();
			if (!clean) return;
			agregarMensajeUsuario(clean);
			if (flujoReserva) {
				var preguntaNormalizada = normalizarAyuda(clean);
				if (flujoReserva.paso !== 'alternativa' && /otro(s)? profesional|otro(s)? trabajador|otra(s)? opcion|alternativa|cambiar profesional/.test(preguntaNormalizada)) {
					await buscarAlternativas(clean);
					return;
				}
				if (flujoReserva.paso === 'alternativa') {
					await buscarAlternativas(clean);
					return;
				}
				var parecePregunta = /[?¿]/.test(clean) || /^(dime|cuentame|explicame|recomiend|como|que|quien|cuando|donde|por que|puedo|puedes|podrias|quiero saber|necesito saber|haz|cuenta|sabes|ayuda|busco otro)/.test(preguntaNormalizada);
				var pareceDatoEsperado = flujoReserva.paso === 'fecha' ? /^\d{4}-\d{2}-\d{2}$/.test(clean)
					: flujoReserva.paso === 'hora' ? /^([01]\d|2[0-3]):[0-5]\d$/.test(clean)
					: flujoReserva.paso === 'direccion' ? clean.length >= 5 && !parecePregunta : false;
				var esPregunta = parecePregunta || /horario|disponib|precio|cuesta|cuanto|funciona|cancel|registr|chiste/.test(preguntaNormalizada);
				if (!pareceDatoEsperado && esPregunta) {
					addHelpMessage(await responderDudaDuranteReserva(clean), 'bot');
					return;
				}
				try {
					if (flujoReserva.paso === 'fecha') {
						if (!/^\d{4}-\d{2}-\d{2}$/.test(clean)) { addHelpMessage(await responderDudaDuranteReserva(clean), 'bot'); return; }
						var fecha = new Date(clean + 'T12:00:00'); var hoy = new Date();
						var fechaLocal = [hoy.getFullYear(), String(hoy.getMonth() + 1).padStart(2, '0'), String(hoy.getDate()).padStart(2, '0')].join('-');
						if (Number.isNaN(fecha.getTime()) || fecha < new Date(fechaLocal + 'T00:00:00') || fecha.toISOString().slice(0, 10) !== clean) throw new Error('Esa fecha no es válida o ya pasó. Intenta con AAAA-MM-DD.');
						flujoReserva.fecha = clean; flujoReserva.paso = 'hora'; addHelpMessage('¿A qué hora? Usa formato de 24 horas, por ejemplo 09:30.', 'bot');
					} else if (flujoReserva.paso === 'hora') {
						if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(clean)) { addHelpMessage(await responderDudaDuranteReserva(clean), 'bot'); return; }
						flujoReserva.hora = clean; flujoReserva.paso = 'direccion'; addHelpMessage('¿En qué dirección se realizará el servicio?', 'bot');
					} else if (flujoReserva.paso === 'direccion') {
						if (clean.length < 5) throw new Error('Escribe una dirección más completa para que el profesional ubique el lugar.');
						await reservarServicio(flujoReserva.servicio, flujoReserva.fecha, flujoReserva.hora, clean);
					}
				} catch (error) {
					if (flujoReserva && flujoReserva.paso === 'direccion' && /horario|hora|fecha|ocupad|disponibilidad/i.test(error.message)) {
						flujoReserva.paso = 'fecha'; flujoReserva.fecha = ''; flujoReserva.hora = ''; flujoReserva.direccion = '';
						addHelpMessage(error.message + ' Ya consulté el horario publicado. Indica otra fecha con formato AAAA-MM-DD y continuamos.', 'bot');
					} else addHelpMessage(error.message, 'bot');
				}
				return;
			}
			var q = normalizarAyuda(clean);
			if (/(quiero|ayudame|necesito|vamos a).{0,35}(agendar|reservar|solicitar)|^(agendar|reservar|solicitar servicio)$/.test(q)) {
				await iniciarAgendamiento(clean); return;
			}
			var answerFinal = await consultarIAChat(clean);
			window.setTimeout(function () { addHelpMessage(answerFinal, 'bot'); accionesAyuda([{ label: 'Quiero agendar un servicio', action: 'book' }]); }, 200);
		}
		document.getElementById('helpChatForm').addEventListener('submit', function (e) {
			e.preventDefault();
			sendHelpQuestion(helpInput.value);
			helpInput.value = '';
		});
			document.getElementById('helpChatPrompts').addEventListener('click', function (e) {
			var button = e.target.closest('button');
			if (!button) return;
			if (button.dataset.helpAction) {
				if (button.dataset.helpAction === 'book') iniciarAgendamiento('');
				else procesarAccionAyuda(button.dataset.helpAction, button.dataset.helpValue);
			} else sendHelpQuestion(button.textContent || '');
		});
	})();
</script>
<style is:global>
  .nav-actions .btn-login[hidden],
  .nav-actions .btn-register[hidden] { display: none !important; }
</style>
