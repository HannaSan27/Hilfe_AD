			if (/cancel|empezar de nuevo/.test(q)) { flujoReserva = null; accionesAyuda([{ label: 'Agendar un servicio', action: 'book' }]); return 'Cancelé el agendamiento. Cuando quieras, empezamos de nuevo.'; }
			if (/como funciona|que pasa|confirm|solicitud/.test(q)) return 'Al confirmar, se envía una solicitud al profesional. Quedará pendiente hasta que la acepte. Puedes revisar su estado en “Mis citas”.';
			if (/direccion|donde/.test(q) && flujoReserva.paso === 'direccion') return 'Escribe la dirección donde se realizará el servicio. Solo se incluirá en la solicitud que verá el profesional.';
