		async function buscarAlternativas(texto) {
			var q = normalizarAyuda(texto).replace(/\b(que|otro|otros|otra|otras|profesional|profesionales|trabajador|trabajadores|hay|opcion|opciones|alternativa|alternativas|de|del|la|el|en|para|un|una|mas|busco|quiero|cambiar|dime)\b/g, ' ').replace(/\s+/g, ' ').trim();
			var palabras = q.split(' ').filter(function (palabra) { return palabra.length > 2; });
			var actual = flujoReserva.servicio;
			if (!palabras.length && !(actual && actual.Id_Categoria)) {
				flujoReserva.paso = 'alternativa';
				addHelpMessage('Claro. ¿De qué servicio o categoría quieres ver otro profesional? Por ejemplo: arreglos, plomería, aseo o belleza.', 'bot');
				return;
