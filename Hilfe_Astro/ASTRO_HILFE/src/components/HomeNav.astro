		async function procesarAccionAyuda(action, value) {
			registrarActividadChat();
			if (action === 'continue-chat') {
				esperaDecisionInactividad = false;
				accionesAntesInactividad = [];
				addHelpMessage('¡Claro, seguimos! ¿Qué más necesitas?', 'bot');
				return;
			}
			if (action === 'end-chat') { finalizarConversacionChat(); return; }
			if (action === 'login') { window.location.href = '/login/login'; return; }
			if (action === 'register') { window.location.href = '/login/registrar'; return; }
			if (action === 'profile') { window.location.href = value; return; }
			if (action === 'categories') { window.location.href = '/categorias/'; return; }
			if (action === 'cancel-search') { busquedaProfesional = null; accionesAyuda([]); addHelpMessage('Listo, cancelé la búsqueda.', 'bot'); return; }
			if (action === 'cancel') { flujoReserva = null; accionesAyuda([{ label: 'Quiero agendar un servicio', action: 'book' }]); addHelpMessage('Listo, cancelé la solicitud. Si quieres, podemos empezar de nuevo.', 'bot'); return; }
			if (action === 'retry-schedule' && flujoReserva) { await mostrarDisponibilidadParaAgendar(); return; }
			if (action === 'service' && flujoReserva) {
				flujoReserva.servicio = flujoReserva.servicios[Number(value)]; flujoReserva.paso = 'horario';
				flujoReserva.fecha = ''; flujoReserva.hora = ''; flujoReserva.direccion = '';
				await mostrarDisponibilidadParaAgendar(); return;
			}
			if (action === 'confirm' && flujoReserva) {
				try {
					var s = flujoReserva.servicio;
					var response = await fetch(apiAyuda + '/solicitudes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
						Id_Cliente: flujoReserva.cliente.id, Id_Trabajador: s.Id_Trabajador, Id_Servicio: s.Id_Servicio,
						Fecha_Servicio: flujoReserva.fecha, Hora_Servicio: flujoReserva.hora, Direccion: flujoReserva.direccion,
						Telefono: flujoReserva.cliente.telefono || flujoReserva.cliente.Telefono || null,
						Descripcion_Solicitud: 'Solicitud creada desde el chat de ayuda.'
					}) });
					var result = await response.json().catch(function () { return {}; });
					if (!response.ok) throw new Error(result.mensaje || result.error || 'No fue posible enviar la solicitud.');
					flujoReserva = null; accionesAyuda([{ label: 'Ver mis citas', action: 'appointments' }]);
					addHelpMessage('¡Solicitud enviada! Quedó pendiente de confirmación por el profesional. Puedes consultar su estado en “Mis citas”.', 'bot');
				} catch (error) { addHelpMessage(error.message, 'bot'); accionesAyuda([{ label: 'Volver a intentar', action: 'confirm' }, { label: 'Cancelar', action: 'cancel' }]); }
			}
			if (action === 'appointments') window.location.href = '/cliente/citas/';
		}
		async function sendHelpQuestion(question) {
			var clean = question.trim();
			if (!clean) return;
			iniciarNuevaConversacionChat();
			registrarActividadChat();
			agregarMensajeUsuario(clean);
			if (await consultarDisponibilidadChat(clean)) return;
			if (flujoReserva) {
				var preguntaNormalizada = normalizarAyuda(clean);
				if (flujoReserva.paso !== 'alternativa' && /otro(s)? profesional|otro(s)? trabajador|otra(s)? opcion|alternativa|cambiar profesional/.test(preguntaNormalizada)) {
