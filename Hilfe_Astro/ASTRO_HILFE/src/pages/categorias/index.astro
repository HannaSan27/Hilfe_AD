---
import Layout from '../../layouts/Layout.astro';
import HomeNav from '../../components/HomeNav.astro';
import ServiceCard from '../../components/ServiceCard.astro';

import '../../components/styles/categorias.css';
import '../../components/styles/design-system.css';

const categorias = [];

const catColors = [
	['#dbeafe', '#eff6ff', '#2563eb'],
	['#d1fae5', '#ecfdf5', '#059669'],
	['#fce7f3', '#fff1f2', '#db2777'],
	['#fef3c7', '#fffbeb', '#d97706'],
	['#ede9fe', '#f5f3ff', '#7c3aed'],
	['#dbeafe', '#f0f9ff', '#0284c7'],
	['#fce7f3', '#fdf2f8', '#be185d'],
	['#d1fae5', '#f0fdf4', '#16a34a'],
];

const servicios = [];

---

<Layout title="Hilf'e — Todos los servicios">
	<HomeNav />

	<section class="cat-hero">
		<h1>Todos los servicios</h1>
		<p>Encuentra el profesional ideal para cada necesidad</p>
	</section>

	<section class="cat-grid-section">
		<div class="cat-grid" id="catGrid">
			<button type="button" class="cat-grid-item active" data-cat="" onclick="selectCat(this, '')">
				<div class="cat-grid-icon" style="background: linear-gradient(135deg, #dbeafe, #eff6ff);">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
				</div>
				<span>Todos</span>
			</button>
			{categorias.map((cat, i) => {
				const c = catColors[i % catColors.length];
				const iniciales = cat.nombre.slice(0, 2).toUpperCase();
				return (
					<button type="button" class="cat-grid-item" data-cat={cat.nombre.toLowerCase()} onclick={`selectCat(this, '${cat.nombre.toLowerCase()}')`}>
						<div class="cat-grid-icon" style={`background: linear-gradient(135deg, ${c[0]}, ${c[1]});`}>
							<span style="font-size:20px;">{iniciales}</span>
						</div>
						<span>{cat.nombre}</span>
					</button>
				);
			})}
		</div>
	</section>

	<div class="page-layout">
		<aside class="filters-panel" id="filtersPanel">
			<form id="filterForm" onsubmit="event.preventDefault(); aplicarFiltros();">
				<div class="filters-header">
					<h3>Filtros</h3>
					<button type="button" onclick="limpiarFiltros()">Limpiar</button>
				</div>

				<div class="filter-group">
					<div class="filter-label">Categoría</div>
					<div class="cat-filter-list">
						<button type="button" class="cat-filter-item active" data-cat="" onclick="selectCat(this, '')">
							<span>Todos los servicios</span>
							<span class="cat-filter-count" id="allCategoryCount">0</span>
						</button>
						{categorias.map((cat, i) => {
							const count = servicios.filter((s) => s.categoria === cat.nombre).length;
							return (
								<button
									type="button"
									class="cat-filter-item"
									data-cat={cat.nombre.toLowerCase()}
									onclick={`selectCat(this, '${cat.nombre.toLowerCase()}')`}
								>
									<span>{cat.nombre}</span>
									<span class="cat-filter-count">{count}</span>
								</button>
							);
						})}
					</div>
				</div>

				<div class="filter-group">
					<div class="filter-label">Disponibilidad</div>
					<label class="filter-check">
						<input type="checkbox" name="soloDisponibles" value="true" id="soloDisponibles" onchange="aplicarFiltros()" />
						Solo disponibles hoy
					</label>
				</div>

				<div class="filter-group">
					<div class="filter-label">Calificación mínima</div>
					<div class="filter-slider-wrap">
						<input type="range" class="filter-slider" name="calificacionMin" min="0" max="5" step="0.5" value="0" id="calSlider" />
						<div class="filter-slider-value">
							<span id="calVal">0 <span style="color:var(--star);">★</span></span>
						</div>
						<div class="filter-slider-range">
							<span>Cualquiera</span>
							<span>5 ★</span>
						</div>
					</div>
				</div>

				<div class="filter-group">
					<div class="filter-label">Precio máximo</div>
					<div class="filter-slider-wrap">
						<input type="range" class="filter-slider" name="precioMax" min="10000" max="500000" step="5000" value="500000" id="priceSlider" />
						<div class="filter-slider-value">
							<span id="priceVal">$ 500.000</span>
						</div>
						<div class="filter-slider-range">
							<span>$10.000</span>
							<span>$500.000</span>
						</div>
					</div>
				</div>

				<input type="hidden" name="orden" id="ordenInput" value="calificacion" />

				<div class="filter-actions">
					<button type="submit" class="btn-apply">Aplicar filtros</button>
					<button type="button" class="btn-clear" onclick="limpiarFiltros()">Limpiar filtros</button>
				</div>
			</form>
		</aside>

		<div>
			<div class="content-header">
				<div class="search-wrap">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
					<input type="text" class="search-input" id="searchInput" placeholder="Buscar por nombre o servicio..." onkeyup="aplicarFiltros()" />
				</div>

				<select class="sort-select" id="sortSelect" onchange="changeSort(this.value)">
					<option value="calificacion" selected>Mejor calificados</option>
					<option value="precio_asc">Menor precio</option>
					<option value="precio_desc">Mayor precio</option>
				</select>
				<div class="view-toggle">
					<button class="view-btn active" id="viewList" onclick="setView('list')" aria-label="Vista lista">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
					</button>
					<button class="view-btn" id="viewGrid" onclick="setView('grid')" aria-label="Vista cuadrícula">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
					</button>
				</div>
			</div>

			<div class="results-info">
				<strong id="totalCount">{servicios.length}</strong> trabajadores encontrados
			</div>

			<div id="workersContainer" class="workers-list">
				{servicios.map((sv) => (
					<ServiceCard {...sv} />
				))}
			</div>
		</div>
	</div>

	<script is:inline>
		var catActual = '';
		var orden = 'calificacion';

		var cards = function () {
			return Array.prototype.slice.call(document.querySelectorAll('#workersContainer .worker-card'));
		};

		function aplicarFiltros() {
			var q = (document.getElementById('searchInput').value || '').toLowerCase();
			var solo = document.getElementById('soloDisponibles').checked;
			var minCal = parseFloat(document.getElementById('calSlider').value);
			var maxPrecio = parseInt(document.getElementById('priceSlider').value);
			var count = 0;

			cards().forEach(function (card) {
				var show = true;
				if (catActual && card.dataset.category !== catActual) show = false;
				if (show && q) {
					show =
						(card.dataset.name || '').indexOf(q) >= 0 ||
						(card.dataset.title || '').indexOf(q) >= 0 ||
						(card.dataset.categoryName || '').indexOf(q) >= 0;
				}
				if (show && solo && card.dataset.estado !== 'available') show = false;
				if (show && parseFloat(card.dataset.rating) < minCal) show = false;
				if (show && parseInt(card.dataset.price) > maxPrecio) show = false;
				card.style.display = show ? '' : 'none';
				if (show) count++;
			});

			document.getElementById('totalCount').textContent = count;
		}

		function ordenar() {
			var container = document.getElementById('workersContainer');
			var list = cards();
			list.sort(function (a, b) {
				if (orden === 'precio_asc') return a.dataset.price - b.dataset.price;
				if (orden === 'precio_desc') return b.dataset.price - a.dataset.price;
				return b.dataset.rating - a.dataset.rating;
			});
			list.forEach(function (c) { container.appendChild(c); });
			aplicarFiltros();
		}

		function changeSort(val) {
			orden = val;
			document.getElementById('ordenInput').value = val;
			ordenar();
		}

		function selectCat(btn, cat) {
			catActual = cat;
			document.querySelectorAll('.cat-grid-item').forEach(function (b) { b.classList.remove('active'); });
			document.querySelectorAll('.cat-filter-item').forEach(function (b) { b.classList.remove('active'); });
			var gridBtn = document.querySelector('#catGrid .cat-grid-item[data-cat="' + cat + '"]');
			var filterBtn = document.querySelector('.cat-filter-item[data-cat="' + cat + '"]');
			if (gridBtn) gridBtn.classList.add('active');
			if (filterBtn) filterBtn.classList.add('active');
			aplicarFiltros();
		}

		function limpiarFiltros() {
			catActual = '';
			document.getElementById('searchInput').value = '';
			document.getElementById('soloDisponibles').checked = false;
			document.getElementById('calSlider').value = 0;
			document.getElementById('priceSlider').value = 500000;
			document.getElementById('calVal').innerHTML = '0 <span style="color:var(--star);">★</span>';
			document.getElementById('priceVal').textContent = '$ 500.000';
			document.querySelectorAll('.cat-grid-item').forEach(function (b) { b.classList.remove('active'); });
			document.querySelectorAll('.cat-filter-item').forEach(function (b) { b.classList.remove('active'); });
			var todos = document.querySelector('.cat-grid-item[data-cat=""]');
			var todosF = document.querySelector('.cat-filter-item[data-cat=""]');
			if (todos) todos.classList.add('active');
			if (todosF) todosF.classList.add('active');
			aplicarFiltros();
		}

		var priceSlider = document.getElementById('priceSlider');
		var priceVal = document.getElementById('priceVal');
		if (priceSlider && priceVal) {
			priceSlider.addEventListener('input', function () {
				priceVal.textContent = '$ ' + parseInt(priceSlider.value).toLocaleString('es-CO');
			});
		}
		var calSlider = document.getElementById('calSlider');
		var calVal = document.getElementById('calVal');
		if (calSlider && calVal) {
			calSlider.addEventListener('input', function () {
				calVal.innerHTML = calSlider.value + ' <span style="color:var(--star);">★</span>';
			});
		}

		function setView(mode) {
			var container = document.getElementById('workersContainer');
			var listBtn = document.getElementById('viewList');
			var gridBtn = document.getElementById('viewGrid');
			if (mode === 'grid') {
				container.classList.remove('workers-list');
				container.classList.add('workers-grid-view');
				listBtn.classList.remove('active');
				gridBtn.classList.add('active');
			} else {
				container.classList.remove('workers-grid-view');
				container.classList.add('workers-list');
				gridBtn.classList.remove('active');
				listBtn.classList.add('active');
			}
			localStorage.setItem('viewMode', mode);
		}
		(function () {
			var savedView = localStorage.getItem('viewMode');
			if (savedView === 'grid') setView('grid');
		})();

		(function () {
			var params = new URLSearchParams(window.location.search);
			window.categoriaInicial = params.get('categoriaId');
			window.busquedaInicial = params.get('search');
		})();

		(function cargarCatalogo() {
			var api = 'http://127.0.0.1:8000/api';
			var colores = [
				['#dbeafe','#eff6ff','#2563eb'],['#d1fae5','#ecfdf5','#059669'],['#fce7f3','#fff1f2','#db2777'],
				['#fef3c7','#fffbeb','#d97706'],['#ede9fe','#f5f3ff','#7c3aed'],['#dbeafe','#f0f9ff','#0284c7'],
				['#fce7f3','#fdf2f8','#be185d'],['#d1fae5','#f0fdf4','#16a34a']
			];
			var seguro = function (valor) {
				return String(valor == null ? '' : valor).replace(/[&<>"']/g, function (c) {
					return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
				});
			};
			var diaHoy = new Intl.DateTimeFormat('es-CO', {weekday:'long'}).format(new Date()).toLowerCase();
			Promise.all([
				fetch(api + '/categorias').then(function (r) { if (!r.ok) throw new Error('Categorías: ' + r.status); return r.json(); }),
				fetch(api + '/servicios').then(function (r) { if (!r.ok) throw new Error('Servicios: ' + r.status); return r.json(); }),
				fetch(api + '/disponibilidad').then(function (r) { if (!r.ok) throw new Error('Disponibilidad: ' + r.status); return r.json(); })
			]).then(function (respuesta) {
				var categorias = Array.isArray(respuesta[0]) ? respuesta[0] : (respuesta[0].value || []);
				var servicios = Array.isArray(respuesta[1]) ? respuesta[1] : (respuesta[1].value || []);
				var disponibilidad = Array.isArray(respuesta[2]) ? respuesta[2] : (respuesta[2].value || []);
				var grid = document.getElementById('catGrid');
				var filtros = document.querySelector('.cat-filter-list');
				var container = document.getElementById('workersContainer');
				var conteos = {};
				servicios.forEach(function (s) { var id = String(s.Id_Categoria); conteos[id] = (conteos[id] || 0) + 1; });
				categorias.forEach(function (cat, i) {
					var id = String(cat.Id_Categoria);
					var nombre = cat.Nombre_Categoria || 'Categoría';
					var c = colores[i % colores.length];
					var bGrid = document.createElement('button');
					bGrid.type = 'button'; bGrid.className = 'cat-grid-item'; bGrid.dataset.cat = id;
					bGrid.innerHTML = '<div class="cat-grid-icon" style="background:linear-gradient(135deg,' + c[0] + ',' + c[1] + ');"><span style="font-size:20px;">' + seguro(nombre.slice(0,2).toUpperCase()) + '</span></div><span>' + seguro(nombre) + '</span>';
					bGrid.addEventListener('click', function () { selectCat(bGrid, id); }); grid.appendChild(bGrid);
					var bFiltro = document.createElement('button');
					bFiltro.type = 'button'; bFiltro.className = 'cat-filter-item'; bFiltro.dataset.cat = id;
					bFiltro.innerHTML = '<span>' + seguro(nombre) + '</span><span class="cat-filter-count">' + (conteos[id] || 0) + '</span>';
					bFiltro.addEventListener('click', function () { selectCat(bFiltro, id); }); filtros.appendChild(bFiltro);
				});
				document.getElementById('allCategoryCount').textContent = servicios.length;
				servicios.forEach(function (s) {
					var disponible = disponibilidad.some(function (d) { return String(d.Id_Servicio) === String(s.Id_Servicio) && String(d.Dia_Semana).toLowerCase() === diaHoy; });
					var nombre = s.Nombre_Trabajador || 'Trabajador'; var titulo = s.Titulo || 'Servicio';
					var cat = s.Nombre_Categoria || 'Servicio'; var precio = Number(s.Precio) || 0;
					var rating = Number(s.Calificacion_Promedio) || 0; var resenas = Number(s.Total_Resenas) || 0;
					var estado = disponible ? 'available' : 'unavailable'; var card = document.createElement('div');
					card.className = 'worker-card fade-in-up'; card.dataset.name = nombre.toLowerCase(); card.dataset.title = titulo.toLowerCase();
					card.dataset.category = String(s.Id_Categoria); card.dataset.categoryName = cat.toLowerCase(); card.dataset.price = String(precio);
					card.dataset.rating = String(rating); card.dataset.estado = estado;
					card.innerHTML = '<div class="worker-card-photo"><div class="photo-placeholder">' + seguro(nombre.charAt(0).toUpperCase()) + '</div><span class="worker-card-badge" style="background:rgba(239,68,68,0.12);color:#ef4444;">âœ— Sin verificar</span><span class="worker-card-status ' + estado + '">' + (disponible ? 'Disponible hoy' : 'No disponible') + '</span></div><div class="worker-card-body"><div class="worker-card-top"><div class="worker-card-name">' + seguro(nombre) + '</div><div class="worker-card-rating">' + rating.toFixed(1) + ' <small>(' + resenas + ')</small></div></div><div class="worker-card-service">' + seguro(titulo) + '</div><div class="worker-card-meta"><span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>' + seguro(s.Ubicacion || 'Ubicación no disponible') + '</span><span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>' + resenas + ' reseñas</span></div><div class="worker-card-tags"><span class="worker-tag">' + seguro(cat) + '</span></div><div class="worker-card-footer"><div class="worker-card-price">$' + precio.toLocaleString('es-CO') + '<small>/servicio</small></div><a href="/trabajador/perfil/?id=' + encodeURIComponent(s.Id_Trabajador) + '&servicioId=' + encodeURIComponent(s.Id_Servicio) + '" class="worker-card-btn">Ver perfil<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a></div></div>';
					container.appendChild(card);
				});
				var inicial = window.categoriaInicial;
				if (inicial) { var btn = Array.prototype.find.call(grid.querySelectorAll('.cat-grid-item'), function (b) { return b.dataset.cat === inicial; }); if (btn) selectCat(btn, inicial); }
				if (window.busquedaInicial) document.getElementById('searchInput').value = window.busquedaInicial;
				ordenar();
			}).catch(function (error) { console.error('Error cargando el catálogo:', error); });
		})();
	</script>
</Layout>
