---
import Layout from '../../layouts/Layout.astro';
import HomeNav from '../../components/HomeNav.astro';
import '../../components/styles/design-system.css';
---

<Layout title="Perfil del trabajador — Hilf'e">
	<HomeNav />

	<main class="profile-page">
		<div id="perfilError" class="profile-error" role="alert" hidden><span id="perfilErrorTexto"></span></div>
		<div class="profile-layout" id="perfilContenido" hidden>
			<div class="profile-main">
				<section class="profile-card worker-summary">
					<div class="worker-avatar"><div class="photo-placeholder" id="trabajadorInicial"></div><img id="trabajadorFoto" alt="Foto del trabajador" hidden /></div>
					<div class="summary-copy"><h1 id="trabajadorNombre"></h1><p id="trabajadorUbicacion"></p><strong id="servicioResumen"></strong><div class="summary-tags"><span id="badgeVerificacion" style="display:inline-flex;align-items:center;gap:4px;font-size:0.8rem;padding:3px 9px;border-radius:12px;font-weight:700;"></span><span id="trabajadorCategoria"></span><span id="totalResenas"></span><span id="promedioResumen"></span></div></div>
				</section>
				<section class="profile-card"><h2>Descripción profesional</h2><p id="perfilProfesionalDescripcion" hidden></p><h3 id="servicioTitulo"></h3><p id="servicioDescripcion"></p><div class="summary-tags"><span id="categoriaDescripcion"></span><span id="experienciaProfesional"></span><span id="disponibilidadResumen"></span></div></section>
						<section class="profile-card"><div class="gallery-heading"><div><h2>Trabajos realizados</h2><p>Conoce algunos de los proyectos de este trabajador.</p></div><span id="galleryCount" class="gallery-count" hidden></span></div><div class="work-gallery" id="galeriaTrabajos"><p class="gallery-state">Cargando fotos...</p></div></section>
				<section class="profile-card"><h2 id="calificacionesTitulo">Calificaciones</h2><div class="rating-summary"><strong id="promedioCalificaciones">0.0</strong><span id="estrellasResumen">☆☆☆☆☆</span><small id="cantidadCalificaciones">0 reseñas</small></div><div id="ratingBreakdown" class="rating-breakdown" aria-label="Distribución de calificaciones"></div><div id="listaCalificaciones"></div></section>
			</div>
			<aside class="profile-card booking-card">
				<div class="booking-price"><strong id="precioServicio"></strong><small class="booking-price-label">Precio del servicio</small><div class="booking-rating"><span id="estrellasLateral" aria-label="Calificación">☆☆☆☆☆</span><small id="calificacionLateral"></small></div><p id="bookingServiceTitle" class="booking-service-title"></p></div>
				<div class="booking-details"><p><b>Ubicación</b><span id="ubicacionLateral"></span></p><p><b>Contacto</b><span id="telefonoLateral"></span></p><p><b>Especialidad</b><span id="especialidadLateral"></span></p><p><b>Experiencia</b><span id="experienciaLateral"></span></p><p><b>Disponibilidad</b><span id="horariosLateral"></span></p></div>
				<button type="button" class="booking-open" id="abrirAgendamiento"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg> Agendar servicio</button>
				<p class="booking-note">Servicio disponible en tu zona</p>
			</aside>
		</div>
	</main>
	<div id="solicitudConfirmada" class="booking-success-toast" role="status" aria-live="polite" hidden></div>
	<div class="gallery-lightbox" id="galleryLightbox" hidden>
		<section class="gallery-lightbox-dialog" role="dialog" aria-modal="true" aria-label="Vista de fotos de trabajos">
			<button type="button" class="gallery-lightbox-close" id="galleryClose" aria-label="Cerrar vista de fotos">×</button>
			<button type="button" class="gallery-lightbox-nav gallery-lightbox-prev" id="galleryPrev" aria-label="Foto anterior">‹</button>
			<figure class="gallery-lightbox-figure"><figcaption id="galleryLightboxCaption"></figcaption></figure>
			<button type="button" class="gallery-lightbox-nav gallery-lightbox-next" id="galleryNext" aria-label="Foto siguiente">›</button>
			<p class="gallery-lightbox-position" id="galleryPosition" aria-live="polite"></p>
		</section>
	</div>
	<div class="booking-overlay" id="modalAgendamiento" hidden>
		<section class="booking-modal" role="dialog" aria-modal="true" aria-labelledby="tituloAgendamiento">
			<header><h2 id="tituloAgendamiento">Agendar servicio</h2><button type="button" id="cerrarAgendamiento" aria-label="Cerrar">×</button></header>
			<div class="booking-modal-content">
				<div class="selected-worker"><span class="modal-avatar" id="modalInicial"></span><div><strong id="modalNombre"></strong><small id="modalServicio"></small></div><b id="modalPrecio"></b></div>
				<div class="modal-availability"><strong>Disponibilidad</strong><div id="modalHorarios"></div></div>
				<div id="solicitudMensaje" class="booking-error-alert" role="alert" aria-live="assertive" hidden>
					<span class="booking-error-icon" aria-hidden="true">!</span>
					<div class="booking-error-copy"><strong id="solicitudMensajeTitulo">No se puede agendar en este horario</strong><p id="solicitudMensajeDetalle"></p></div>
				</div>
				<p id="iniciarSesionAviso" class="form-message" hidden><a href="/login/login">Inicia sesión como cliente para agendar este servicio.</a></p>
				<form id="solicitudForm">
					<label class="modal-field full-field" for="servicioId">Servicio<select id="servicioId" required></select></label>
					<section class="booking-deposit full-field" aria-labelledby="depositTitle">
						<div class="booking-deposit-head"><div><strong id="depositTitle">Abono para reservar</strong><small>Elige cuánto abonar ahora. El saldo se paga al finalizar.</small></div><span id="saldoWalletReserva" role="status">Consultando billetera…</span></div>
						<div class="booking-deposit-options" role="radiogroup" aria-label="Porcentaje de abono">
							<label class="booking-deposit-option"><input type="radio" name="porcentajeAbono" value="25" checked /><span><strong>25%</strong><small id="abono25">—</small></span></label>
							<label class="booking-deposit-option"><input type="radio" name="porcentajeAbono" value="50" /><span><strong>50%</strong><small id="abono50">—</small></span></label>
							<label class="booking-deposit-option"><input type="radio" name="porcentajeAbono" value="100" /><span><strong>100%</strong><small id="abono100">—</small></span></label>
						</div>
						<p id="resumenAbono" class="booking-deposit-summary">El abono se descuenta de tu billetera al confirmar e incluye 5% de comisión.</p>
						<a class="booking-wallet-link" href="/billetera#recargar">Ver saldo o recargar billetera</a>
					</section>
					<label class="modal-field full-field" for="descripcion">¿Qué necesitas?<textarea id="descripcion" rows="4" maxlength="500" placeholder="Cuéntale al trabajador qué necesitas..."></textarea><small class="description-count"><span id="descripcionCount">0</span> / 500</small></label>
					<div class="suggestions"><span>Elige una sugerencia para empezar:</span><button type="button" data-sugerencia="Reparación">Reparación</button><button type="button" data-sugerencia="Instalación">Instalación</button><button type="button" data-sugerencia="Diagnóstico">Diagnóstico</button><button type="button" data-sugerencia="Limpieza">Limpieza</button></div>
					<label class="modal-field" for="fechaServicio">Fecha<input id="fechaServicio" type="date" required /></label>
					<label class="modal-field" for="horaServicio">Hora<input id="horaServicio" type="time" required /></label>
					<div id="avisoHorario" class="booking-slot-notice full-field" role="status" hidden></div>
					<label class="modal-field" for="direccion">Dirección<input id="direccion" type="text" placeholder="Calle, número..." /></label>
					<label class="modal-field" for="telefono">Teléfono<input id="telefono" type="tel" placeholder="Tu número" /></label>
					<footer><button type="button" class="booking-cancel" id="cancelarAgendamiento">Cancelar</button><button class="booking-confirm" id="solicitarBtn" type="submit">Confirmar agendamiento</button></footer>
				</form>
			</div>
		</section>
	</div>
	<script is:inline>
		(function () {
			var api = 'http://127.0.0.1:8000/api';
			var params = new URLSearchParams(window.location.search);
			var trabajadorId = params.get('id');
			var servicioInicial = params.get('servicioId');
			var trabajador;
			var servicios = [];
			var calificaciones = [];
			var servicioActual;
			var horariosActuales = [];
			var horariosOcupados = [];
			var solicitudOcupados = 0;
			var fotosGaleria = [];
			var indiceFoto = 0;
			var focoGaleriaAnterior = null;
			var modal = document.getElementById('modalAgendamiento');
			var form = document.getElementById('solicitudForm');
			var mensaje = document.getElementById('solicitudMensaje');
			var mensajeTitulo = document.getElementById('solicitudMensajeTitulo');
			var mensajeDetalle = document.getElementById('solicitudMensajeDetalle');
			var errorBox = document.getElementById('perfilError');
			var errorTexto = document.getElementById('perfilErrorTexto');
			var selector = document.getElementById('servicioId');
			var saldoWalletReserva = null;

			function listaDe(respuesta) {
				if (Array.isArray(respuesta)) return respuesta;
				return respuesta && Array.isArray(respuesta.value) ? respuesta.value : [];
			}
			function mensajeDe(datos, respaldo) {
				return datos && (datos.mensaje || datos.error) ? (datos.mensaje || datos.error) : respaldo;
			}
			function mostrarError(texto) {
				errorTexto.textContent = texto;
				errorBox.hidden = false;
			}
			function mostrarErrorSolicitud(texto) {
				var detalle = texto || 'Revisa la fecha, la hora y la disponibilidad publicada.';
				mensajeTitulo.textContent = /horario|hora|ocupad|disponib|fecha/i.test(detalle) ? 'No se puede agendar en este horario' : 'No se pudo completar la solicitud';
				mensajeDetalle.textContent = detalle;
				mensaje.hidden = false;
			}
			function limpiarErrorSolicitud() {
				mensaje.hidden = true;
				mensajeDetalle.textContent = '';
			}
			function estrellas(valor) {
				var redondeado = Math.round(Number(valor) || 0);
				return '★'.repeat(redondeado) + '☆'.repeat(5 - redondeado);
			}
			function precioDe(servicio) {
				return '$' + (Number(servicio.Precio) || 0).toLocaleString('es-CO');
			}
			function copDeAbono(valor) {
				return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(valor);
			}
			function calcularAbono(precio, porcentaje) {
				var base = Math.round(Number(precio) * Number(porcentaje)) / 100;
				return Math.round(base * 1.05 * 100) / 100;
			}
			function actualizarResumenAbono() {
				var precio = Number(servicioActual && servicioActual.Precio) || 0;
				[25, 50, 100].forEach(function (porcentaje) {
					var destino = document.getElementById('abono' + porcentaje);
					if (destino) destino.textContent = copDeAbono(calcularAbono(precio, porcentaje));
				});
				var elegido = Number(form.querySelector('input[name="porcentajeAbono"]:checked')?.value || 25);
				var monto = calcularAbono(precio, elegido);
				var resumen = document.getElementById('resumenAbono');
				var estadoSaldo = document.getElementById('saldoWalletReserva');
				var boton = document.getElementById('solicitarBtn');
				if (saldoWalletReserva === null) {
					estadoSaldo.textContent = 'Consultando billetera…';
					resumen.textContent = 'El abono incluirá 5% de comisión y se descontará al confirmar.';
					boton.disabled = true;
					return;
				}
				estadoSaldo.textContent = 'Disponible: ' + copDeAbono(saldoWalletReserva);
				if (saldoWalletReserva < monto) {
					resumen.textContent = 'Te faltan ' + copDeAbono(monto - saldoWalletReserva) + ' para abonar el ' + elegido + '%. Recarga y vuelve a reservar.';
					resumen.classList.add('is-short');
					boton.disabled = true;
				} else {
					resumen.textContent = 'Se descontarán ' + copDeAbono(monto) + ' ahora. El abono incluye 5% de comisión Hilf’e.';
					resumen.classList.remove('is-short');
					boton.disabled = false;
				}
			}
			async function consultarSaldoReserva() {
				saldoWalletReserva = null;
				actualizarResumenAbono();
				try {
					var respuesta = await fetch('/api/billetera/saldo', { credentials: 'same-origin', cache: 'no-store' });
					var datos = await respuesta.json().catch(function () { return {}; });
					if (!respuesta.ok || !datos.ok) throw new Error('No se pudo consultar la billetera. Inicia sesión de nuevo.');
					saldoWalletReserva = Number(datos.saldo) || 0;
					actualizarResumenAbono();
				} catch (error) {
					document.getElementById('saldoWalletReserva').textContent = 'Billetera no disponible';
					document.getElementById('resumenAbono').textContent = error.message || 'No se pudo consultar tu saldo.';
					document.getElementById('resumenAbono').classList.add('is-short');
					document.getElementById('solicitarBtn').disabled = true;
				}
			}
			function horariosTexto(items) {
				if (!items.length) return 'Horario no publicado';
				return items.map(function (d) {
					if (String(d.Hora_Inicio).slice(0, 5) === '00:00' && String(d.Hora_Fin) === '23:59:59') return d.Dia_Semana + ' todo el día';
					return d.Dia_Semana + ' ' + String(d.Hora_Inicio || '').slice(0, 5) + ' - ' + String(d.Hora_Fin || '').slice(0, 5);
				}).join(' · ');
			}
			function horariosDe(servicioId) {
				return fetch(api + '/disponibilidad?servicio=' + encodeURIComponent(servicioId))
					.then(function (r) { if (!r.ok) throw new Error('No fue posible cargar la disponibilidad.'); return r.json(); })
					.then(listaDe);
			}
			function diaDeFecha(fechaTexto) {
				if (!fechaTexto) return '';
				var partes = fechaTexto.split('-').map(Number);
				return ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'][new Date(partes[0], partes[1] - 1, partes[2]).getDay()];
			}
			function validarHorarioSeleccionado() {
				var fecha = document.getElementById('fechaServicio').value;
				var hora = document.getElementById('horaServicio').value.slice(0, 5);
				var dia = diaDeFecha(fecha);
				var aviso = document.getElementById('avisoHorario');
				var rangos = horariosActuales.filter(function (h) { return h.Dia_Semana === dia; });
				var permitida = rangos.some(function (h) {
					var finCompleto = String(h.Hora_Fin) === '23:59:59';
					return hora >= String(h.Hora_Inicio).slice(0, 5) && (finCompleto ? hora <= '23:59' : hora < String(h.Hora_Fin).slice(0, 5));
				});
				var ocupada = !!hora && horariosOcupados.indexOf(hora) !== -1;
				aviso.hidden = !fecha;
				aviso.classList.toggle('is-error', !!fecha && (!rangos.length || (hora && (!permitida || ocupada))));
				if (!fecha) { aviso.textContent = ''; return false; }
				var prefijo = horariosOcupados.length ? 'Horas ocupadas este día: ' + horariosOcupados.join(', ') + '. ' : '';
				if (!rangos.length) aviso.textContent = prefijo + 'El trabajador no atiende los ' + dia + ' según su horario publicado.';
				else if (ocupada) aviso.textContent = prefijo + 'Esta hora ya está ocupada. Elige otra.';
				else if (hora && !permitida) aviso.textContent = prefijo + 'La hora debe estar dentro del horario: ' + rangos.map(function (h) { return String(h.Hora_Inicio).slice(0, 5) + '–' + (String(h.Hora_Fin) === '23:59:59' ? '23:59' : String(h.Hora_Fin).slice(0, 5)); }).join(', ') + '.';
				else aviso.textContent = prefijo + 'Horario disponible: ' + rangos.map(function (h) { return String(h.Hora_Fin) === '23:59:59' ? 'todo el día' : String(h.Hora_Inicio).slice(0, 5) + '–' + String(h.Hora_Fin).slice(0, 5); }).join(', ') + '.';
				return !!(rangos.length && hora && permitida && !ocupada);
			}
			async function cargarHorariosOcupados() {
				var fecha = document.getElementById('fechaServicio').value;
				var version = ++solicitudOcupados;
				horariosOcupados = [];
				if (!fecha || !trabajador) { validarHorarioSeleccionado(); return; }
				try {
					var respuesta = await fetch(api + '/solicitudes/horarios-ocupados?trabajador=' + encodeURIComponent(trabajador.Id_Usuario) + '&fecha=' + encodeURIComponent(fecha));
					if (!respuesta.ok) throw new Error('No fue posible revisar las horas reservadas.');
					var datos = await respuesta.json();
					if (version !== solicitudOcupados) return;
					horariosOcupados = listaDe(datos).map(function (h) { return String(h).slice(0, 5); });
					validarHorarioSeleccionado();
				} catch (_) {
					if (version === solicitudOcupados) { var aviso = document.getElementById('avisoHorario'); aviso.textContent = 'No se pudo comprobar la disponibilidad de este día. Intenta nuevamente.'; aviso.hidden = false; aviso.classList.add('is-error'); }
				}
			}
			function cargarGaleria(servicio) {
				var galeria = document.getElementById('galeriaTrabajos');
				var contador = document.getElementById('galleryCount');
				galeria.replaceChildren();
				fotosGaleria = [];
				contador.hidden = true;
				var carga = document.createElement('p');
				carga.className = 'gallery-state';
				carga.textContent = 'Cargando fotos…';
				galeria.appendChild(carga);
				return fetch(api + '/imagenes-trabajos?servicio=' + encodeURIComponent(servicio.Id_Servicio))
					.then(function (r) { if (!r.ok) throw new Error('No fue posible cargar las fotos.'); return r.json(); })
					.then(function (data) {
						var imagenes = listaDe(data);
						galeria.replaceChildren();
						if (!imagenes.length) {
							var vacia = document.createElement('div'); vacia.className = 'gallery-empty';
							vacia.innerHTML = '<span class="gallery-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg></span><strong>Aún no hay fotos publicadas</strong><span>Este trabajador podrá mostrar aquí sus próximos trabajos.</span>';
							galeria.appendChild(vacia); return;
						}
						imagenes.forEach(function (imagen, indice) {
							var boton = document.createElement('button'); boton.type = 'button'; boton.className = 'gallery-tile';
							boton.setAttribute('aria-label', 'Ver foto ' + (indice + 1) + ' de ' + imagenes.length);
							var foto = document.createElement('img');
							foto.alt = 'Trabajo realizado: ' + (servicio.Titulo || 'servicio');
							foto.src = api + '/imagenes-trabajos/' + encodeURIComponent(imagen.Id_Imagen) + '/archivo';
							foto.loading = 'lazy';
							foto.decoding = 'async';
							boton.addEventListener('click', function () { abrirFoto(indice, boton); });
							foto.addEventListener('error', function () {
								boton.remove();
								fotosGaleria = fotosGaleria.filter(function (registrada) { return registrada.src !== foto.src; });
								var restantes = galeria.querySelectorAll('.gallery-tile').length;
								if (restantes) contador.textContent = restantes + (restantes === 1 ? ' foto' : ' fotos');
								else { contador.hidden = true; var aviso = document.createElement('p'); aviso.className = 'gallery-state'; aviso.textContent = 'Las fotos registradas no están disponibles en este momento.'; galeria.appendChild(aviso); }
							}, { once: true });
							boton.appendChild(foto); galeria.appendChild(boton);
						});
						fotosGaleria = Array.from(galeria.querySelectorAll('.gallery-tile img')).map(function (foto) { return { src: foto.src, alt: foto.alt }; });
						contador.textContent = imagenes.length + (imagenes.length === 1 ? ' foto' : ' fotos'); contador.hidden = false;
					});
			}
			function mostrarFoto() {
				if (!fotosGaleria.length) return;
				var foto = fotosGaleria[indiceFoto];
				var figura = document.querySelector('.gallery-lightbox-figure');
				var imagen = document.getElementById('galleryLightboxImage');
				if (!imagen) { imagen = document.createElement('img'); imagen.id = 'galleryLightboxImage'; figura.insertBefore(imagen, figura.firstChild); }
				imagen.src = foto.src;
				imagen.alt = foto.alt;
				document.getElementById('galleryLightboxCaption').textContent = foto.alt;
				document.getElementById('galleryPosition').textContent = (indiceFoto + 1) + ' / ' + fotosGaleria.length;
			}
			function abrirFoto(indice, activador) {
				if (!fotosGaleria.length) return;
				indiceFoto = indice; focoGaleriaAnterior = activador;
				var visor = document.getElementById('galleryLightbox'); visor.hidden = false;
				document.body.style.overflow = 'hidden'; mostrarFoto(); document.getElementById('galleryClose').focus();
			}
			function cerrarFoto() {
				var visor = document.getElementById('galleryLightbox'); if (visor.hidden) return;
				visor.hidden = true; document.body.style.overflow = '';
				var imagen = document.getElementById('galleryLightboxImage'); if (imagen) imagen.remove();
				if (focoGaleriaAnterior && focoGaleriaAnterior.isConnected) focoGaleriaAnterior.focus();
			}
			function moverFoto(delta) { if (!fotosGaleria.length) return; indiceFoto = (indiceFoto + delta + fotosGaleria.length) % fotosGaleria.length; mostrarFoto(); }
			function dibujarCalificaciones() {
				var promedio = calificaciones.length ? calificaciones.reduce(function (suma, c) { return suma + (Number(c.Puntaje) || 0); }, 0) / calificaciones.length : 0;
				document.getElementById('promedioCalificaciones').textContent = promedio.toFixed(1);
				document.getElementById('estrellasResumen').textContent = estrellas(promedio);
				document.getElementById('cantidadCalificaciones').textContent = calificaciones.length + (calificaciones.length === 1 ? ' reseña' : ' reseñas');
				document.getElementById('totalResenas').textContent = calificaciones.length + (calificaciones.length === 1 ? ' reseña' : ' reseñas');
				document.getElementById('promedioResumen').textContent = promedio.toFixed(1) + ' ★';
				document.getElementById('estrellasLateral').textContent = estrellas(promedio);
				document.getElementById('calificacionLateral').textContent = promedio.toFixed(1) + ' (' + calificaciones.length + ')';
				var distribucion = document.getElementById('ratingBreakdown');
				distribucion.replaceChildren();
				distribucion.hidden = calificaciones.length === 0;
				for (var puntaje = 5; puntaje >= 1; puntaje--) {
					var cantidad = calificaciones.filter(function (c) { return Math.round(Number(c.Puntaje) || 0) === puntaje; }).length;
					var fila = document.createElement('div'); fila.className = 'rating-breakdown-row';
					var etiqueta = document.createElement('span'); etiqueta.textContent = puntaje + ' ★';
					var pista = document.createElement('span'); pista.className = 'rating-bar-track'; pista.setAttribute('aria-hidden', 'true');
					var barra = document.createElement('span'); barra.className = 'rating-bar-fill'; barra.style.width = (calificaciones.length ? cantidad / calificaciones.length * 100 : 0) + '%'; pista.appendChild(barra);
					var total = document.createElement('small'); total.textContent = String(cantidad);
					fila.append(etiqueta, pista, total); distribucion.appendChild(fila);
				}
				var lista = document.getElementById('listaCalificaciones');
				lista.replaceChildren();
				if (!calificaciones.length) { var vacia = document.createElement('p'); vacia.textContent = 'Este trabajador aún no tiene calificaciones.'; lista.appendChild(vacia); return; }
				calificaciones.forEach(function (calificacion) {
					var item = document.createElement('article'); item.className = 'review-item';
					var estrellasEl = document.createElement('strong'); estrellasEl.textContent = estrellas(calificacion.Puntaje);
					var fecha = document.createElement('span'); fecha.className = 'review-date';
					fecha.textContent = calificacion.Fecha_Calificacion ? new Date(calificacion.Fecha_Calificacion).toLocaleDateString('es-CO') : '';
					var comentario = document.createElement('p'); comentario.textContent = calificacion.Comentario || 'Sin comentario.';
					item.append(estrellasEl, document.createTextNode('  '), fecha, comentario);
					var fotos = Array.isArray(calificacion.fotos) ? calificacion.fotos : [];
					if (fotos.length) {
						var galeria = document.createElement('div'); galeria.className = 'review-photos';
						fotos.forEach(function (foto, indice) {
							if (!foto || typeof foto.url !== 'string') return;
							var urlFoto = /^https?:\/\//i.test(foto.url)
								? foto.url
								: api.replace(/\/api\/?$/, '') + (foto.url.charAt(0) === '/' ? foto.url : '/' + foto.url);
							var enlace = document.createElement('a'); enlace.className = 'review-photo'; enlace.href = urlFoto; enlace.target = '_blank'; enlace.rel = 'noopener noreferrer';
							var imagen = document.createElement('img'); imagen.src = urlFoto; imagen.alt = 'Foto ' + (indice + 1) + ' compartida en la reseña'; imagen.loading = 'lazy'; imagen.decoding = 'async';
							enlace.appendChild(imagen); galeria.appendChild(enlace);
						});
						if (galeria.childElementCount) item.appendChild(galeria);
					}
					lista.appendChild(item);
				});
			}
			function actualizarServicio(servicio) {
				servicioActual = servicio;
				actualizarResumenAbono();
				var categoria = servicio.Nombre_Categoria || 'Categoría no especificada';
				var titulo = servicio.Titulo || 'Servicio';
				document.getElementById('servicioResumen').textContent = titulo;
				document.getElementById('trabajadorCategoria').textContent = categoria;
				document.getElementById('servicioTitulo').textContent = titulo;
				document.getElementById('servicioDescripcion').textContent = servicio.Descripcion || 'Sin descripción disponible.';
				document.getElementById('categoriaDescripcion').textContent = categoria;
				document.getElementById('precioServicio').textContent = precioDe(servicio);
				document.getElementById('bookingServiceTitle').textContent = titulo;
				document.getElementById('especialidadLateral').textContent = categoria;
				document.getElementById('experienciaLateral').textContent = trabajador.Experiencia || 'No especificada';
				document.getElementById('modalServicio').textContent = titulo;
				document.getElementById('modalPrecio').textContent = 'Desde ' + precioDe(servicio);
				document.getElementById('ubicacionLateral').textContent = trabajador.Ubicacion || 'No especificada';
				document.getElementById('telefonoLateral').textContent = trabajador.Telefono || 'No publicado';
				return horariosDe(servicio.Id_Servicio).then(function (horarios) {
					horariosActuales = horarios;
					var texto = horariosTexto(horarios);
					document.getElementById('horariosLateral').textContent = texto;
					document.getElementById('modalHorarios').replaceChildren();
					document.getElementById('disponibilidadResumen').textContent = horarios.length ? 'Disponible' : 'Horario no publicado';
					if (!horarios.length) { var sin = document.createElement('span'); sin.textContent = texto; document.getElementById('modalHorarios').appendChild(sin); }
					horarios.forEach(function (h) { var chip = document.createElement('span'); chip.textContent = h.Dia_Semana + ' ' + (String(h.Hora_Inicio).slice(0,5) === '00:00' && String(h.Hora_Fin) === '23:59:59' ? 'todo el día' : String(h.Hora_Inicio).slice(0,5) + ' - ' + String(h.Hora_Fin).slice(0,5)); document.getElementById('modalHorarios').appendChild(chip); });
					validarHorarioSeleccionado();
					cargarHorariosOcupados();
				}).catch(function () {
					horariosActuales = [];
					document.getElementById('horariosLateral').textContent = 'No disponibles';
					document.getElementById('disponibilidadResumen').textContent = 'Horario no disponible';
					document.getElementById('modalHorarios').textContent = 'No fue posible cargar los horarios.';
				}).then(function () { return cargarGaleria(servicio); });
			}
			function abrirModal() {
				var sesion = null;
				try { sesion = JSON.parse(localStorage.getItem('usuario') || 'null'); } catch { sesion = null; }
				var esCliente = sesion && Number(sesion.rol) === 3 && sesion.id;
				form.hidden = !esCliente;
				document.getElementById('iniciarSesionAviso').hidden = !!esCliente;
				limpiarErrorSolicitud();
				modal.hidden = false;
				document.body.style.overflow = 'hidden';
				if (esCliente) { consultarSaldoReserva(); document.getElementById('fechaServicio').focus(); }
			}
			function cerrarModal() { modal.hidden = true; document.body.style.overflow = ''; }

			document.getElementById('abrirAgendamiento').addEventListener('click', abrirModal);
			document.getElementById('cerrarAgendamiento').addEventListener('click', cerrarModal);
			document.getElementById('cancelarAgendamiento').addEventListener('click', cerrarModal);
			modal.addEventListener('click', function (event) { if (event.target === modal) cerrarModal(); });
			document.addEventListener('keydown', function (event) {
				var visor = document.getElementById('galleryLightbox');
				if (!visor.hidden) {
					if (event.key === 'Escape') cerrarFoto();
					else if (event.key === 'ArrowRight') { event.preventDefault(); moverFoto(1); }
					else if (event.key === 'ArrowLeft') { event.preventDefault(); moverFoto(-1); }
					return;
				}
				if (event.key === 'Escape' && !modal.hidden) cerrarModal();
			});
			document.getElementById('galleryClose').addEventListener('click', cerrarFoto);
			document.getElementById('galleryPrev').addEventListener('click', function () { moverFoto(-1); });
			document.getElementById('galleryNext').addEventListener('click', function () { moverFoto(1); });
			document.getElementById('galleryLightbox').addEventListener('click', function (event) { if (event.target.id === 'galleryLightbox') cerrarFoto(); });
			document.querySelectorAll('[data-sugerencia]').forEach(function (boton) {
				boton.addEventListener('click', function () {
					var campo = document.getElementById('descripcion');
					var plantillas = {
						'Reparación': 'Necesito reparar [equipo o elemento]. El problema que presenta es [describe la falla] y comenzó [cuándo].',
						'Instalación': 'Necesito instalar [equipo o elemento] en [lugar]. Ya cuento con [materiales o equipo] / necesito asesoría para conseguirlos.',
						'Diagnóstico': 'Necesito revisar [equipo o elemento] porque [describe qué ocurre]. El problema empezó [cuándo o en qué situación].',
						'Limpieza': 'Necesito una limpieza de [espacio, equipo o superficie]. El área aproximada es [tamaño] y requiere atención en [detalle].'
					};
					campo.value = plantillas[boton.dataset.sugerencia] || '';
					document.getElementById('descripcionCount').textContent = String(campo.value.length);
					document.querySelectorAll('[data-sugerencia]').forEach(function (otra) { var activa = otra === boton; otra.classList.toggle('is-selected', activa); otra.setAttribute('aria-pressed', String(activa)); });
					campo.focus();
				});
			});
			document.getElementById('descripcion').addEventListener('input', function (event) { document.getElementById('descripcionCount').textContent = String(event.target.value.length); });
			selector.addEventListener('change', function () {
				limpiarErrorSolicitud();
				var seleccionado = servicios.find(function (s) { return String(s.Id_Servicio) === selector.value; });
				if (seleccionado) actualizarServicio(seleccionado);
			});
			document.getElementById('fechaServicio').addEventListener('change', function () { limpiarErrorSolicitud(); cargarHorariosOcupados(); });
			document.getElementById('horaServicio').addEventListener('input', function () { limpiarErrorSolicitud(); validarHorarioSeleccionado(); });
			form.querySelectorAll('input[name="porcentajeAbono"]').forEach(function (opcion) { opcion.addEventListener('change', actualizarResumenAbono); });

			async function iniciar() {
				if (!trabajadorId) { mostrarError('No se indicó el identificador del trabajador.'); return; }
				try {
					var respuestas = await Promise.all([
						fetch(api + '/trabajadores/' + encodeURIComponent(trabajadorId)),
						fetch(api + '/servicios'),
						fetch(api + '/calificaciones/trabajador/' + encodeURIComponent(trabajadorId))
					]);
					var datosTrabajador = await respuestas[0].json();
					var datosServicios = await respuestas[1].json();
					var datosCalificaciones = await respuestas[2].json();
					if (!respuestas[0].ok) throw new Error(mensajeDe(datosTrabajador, 'No fue posible cargar el trabajador.'));
					if (!respuestas[1].ok) throw new Error(mensajeDe(datosServicios, 'No fue posible cargar los servicios.'));
					trabajador = datosTrabajador;
					var descripcionPerfil = document.getElementById('perfilProfesionalDescripcion');
					if (trabajador.Descripcion_Profesional) {
						descripcionPerfil.textContent = trabajador.Descripcion_Profesional;
						descripcionPerfil.hidden = false;
					}
					document.getElementById('experienciaProfesional').textContent = trabajador.Experiencia || '';
					servicios = listaDe(datosServicios).filter(function (s) { return String(s.Id_Trabajador) === String(trabajadorId); });
					calificaciones = respuestas[2].ok ? listaDe(datosCalificaciones) : [];
					if (!servicios.length) throw new Error('Este trabajador no tiene servicios disponibles.');
					var nombre = trabajador.Nombre || 'Trabajador';
					document.getElementById('trabajadorNombre').textContent = nombre;
					var verificado = trabajador.Verificado === 1 || trabajador.Verificado === true;
					var badgeEl = document.getElementById('badgeVerificacion');
					if (badgeEl) {
						if (verificado) {
							badgeEl.style.background = '#dcfce7';
							badgeEl.style.color = '#15803d';
							badgeEl.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg> Identidad Verificada';
							badgeEl.title = 'Documento de identidad revisado contra registros oficiales por la administración de Hilf\\\'e';
						} else {
							badgeEl.style.background = '#fef3c7';
							badgeEl.style.color = '#b45309';
							badgeEl.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg> Verificación en trámite';
						}
					}
					document.getElementById('trabajadorInicial').textContent = nombre.charAt(0).toUpperCase();
					document.getElementById('modalInicial').textContent = nombre.charAt(0).toUpperCase();
					document.getElementById('modalNombre').textContent = nombre;
					document.getElementById('trabajadorUbicacion').textContent = trabajador.Ubicacion || 'Ubicación no especificada';
					document.getElementById('ubicacionLateral').textContent = trabajador.Ubicacion || 'No especificada';
					document.getElementById('telefonoLateral').textContent = trabajador.Telefono || 'No publicado';
					if (trabajador.Foto_Perfil) {
						var foto = document.getElementById('trabajadorFoto');
						var inicialTrabajador = document.getElementById('trabajadorInicial');
						foto.hidden = true;
						foto.addEventListener('load', function () {
							foto.hidden = false;
							inicialTrabajador.style.display = 'none';
						}, {once:true});
						foto.addEventListener('error', function () {
							foto.hidden = true;
							inicialTrabajador.style.display = '';
						}, {once:true});
						foto.src = api + '/usuarios/' + encodeURIComponent(trabajadorId) + '/foto-perfil';
					}
					servicios.forEach(function (s) { var opcion = document.createElement('option'); opcion.value = s.Id_Servicio; opcion.textContent = (s.Titulo || 'Servicio') + ' · ' + precioDe(s); selector.appendChild(opcion); });
					var inicial = servicios.find(function (s) { return String(s.Id_Servicio) === String(servicioInicial); }) || servicios[0];
					selector.value = String(inicial.Id_Servicio);
					if (calificaciones.length) {
						var prom = calificaciones.reduce(function (suma, c) { return suma + (Number(c.Puntaje) || 0); }, 0) / calificaciones.length;
						document.getElementById('promedioResumen').textContent = prom.toFixed(1) + ' ★';
					}
					dibujarCalificaciones();
					var minFecha = new Date(); minFecha.setMinutes(minFecha.getMinutes() - minFecha.getTimezoneOffset());
					document.getElementById('fechaServicio').min = minFecha.toISOString().slice(0,10);
					document.getElementById('perfilContenido').hidden = false;
					await actualizarServicio(inicial);
				} catch (error) { mostrarError(error.message || 'No fue posible cargar el perfil.'); }
			}

			form.addEventListener('submit', async function (evento) {
				evento.preventDefault();
				if (form.dataset.solicitudEnviada === 'true' || form.dataset.solicitudEnviando === 'true') return;
				var sesion;
				try { sesion = JSON.parse(localStorage.getItem('usuario') || 'null'); } catch { sesion = null; }
				if (!sesion || Number(sesion.rol) !== 3 || !sesion.id) { form.hidden = true; document.getElementById('iniciarSesionAviso').hidden = false; return; }
				var boton = document.getElementById('solicitarBtn');
				form.dataset.solicitudEnviando = 'true';
				boton.disabled = true; limpiarErrorSolicitud();
				try {
					if (!validarHorarioSeleccionado()) throw new Error('Selecciona una fecha y una hora disponible dentro del horario publicado.');
					var respuesta = await fetch(api + '/solicitudes', {
						method: 'POST', headers: {'Content-Type':'application/json', Authorization: 'Bearer ' + (localStorage.getItem('token') || '')},
						body: JSON.stringify({
							Id_Cliente: sesion.id, Id_Trabajador: trabajador.Id_Usuario, Id_Servicio: selector.value,
							Fecha_Servicio: document.getElementById('fechaServicio').value,
							Hora_Servicio: document.getElementById('horaServicio').value,
							Direccion: document.getElementById('direccion').value || null,
							Telefono: document.getElementById('telefono').value || null,
							Descripcion_Solicitud: document.getElementById('descripcion').value || null,
							porcentajeAbono: Number(form.querySelector('input[name="porcentajeAbono"]:checked').value)
						})
					});
					var resultado = await respuesta.json().catch(function () { return {}; });
					if (!respuesta.ok) throw new Error(mensajeDe(resultado, 'No fue posible enviar la solicitud.'));
					form.dataset.solicitudEnviada = 'true';
					var confirmacion = document.getElementById('solicitudConfirmada');
					confirmacion.innerHTML = '<span><strong></strong><button type="button" aria-label="Cerrar confirmación">×</button></span>';
					confirmacion.querySelector('strong').textContent = resultado.mensaje || 'Solicitud creada correctamente.';
					confirmacion.style.cssText = 'position:fixed;inset:0;z-index:2100;display:grid;place-items:center;padding:20px;background:rgba(15,23,42,.42);backdrop-filter:blur(3px);font-size:16px;font-weight:600;';
					confirmacion.querySelector('span').style.cssText = 'position:relative;display:block;width:min(100%,420px);padding:32px 48px;border:1px solid #bbf7d0;border-radius:16px;background:#f0fdf4;color:#166534;box-shadow:0 20px 60px rgba(15,23,42,.25);text-align:center;';
					var cerrarConfirmacion = confirmacion.querySelector('button');
					cerrarConfirmacion.style.cssText = 'position:absolute;top:8px;right:10px;border:0;background:transparent;color:#166534;font-size:24px;line-height:1;cursor:pointer;padding:4px 8px;';
					cerrarConfirmacion.addEventListener('click', function () { confirmacion.hidden = true; confirmacion.style.display = 'none'; });
					confirmacion.hidden = false;
					cerrarModal();
				} catch (error) { mostrarErrorSolicitud(error.message || 'No fue posible enviar la solicitud.'); if (/ocupado/i.test(error.message || '')) cargarHorariosOcupados(); }
				finally {
					delete form.dataset.solicitudEnviando;
					boton.disabled = form.dataset.solicitudEnviada === 'true';
				}
			});
			iniciar();
		})();
	</script>
