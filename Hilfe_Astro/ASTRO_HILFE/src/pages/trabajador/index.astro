---
import Layout from '../../layouts/Layout.astro';
import UserMenu from '../../components/UserMenu.astro';
import '../../components/styles/design-system.css';
import '../../components/styles/trabajador-index.css';

const usuario = { nombre: 'Trabajador', inicial: 'T', rol: 'Trabajador' };

const servicios: any[] = [];

const solicitudes: any[] = [];

const estadoInfo: Record<string, { clase: string; label: string; icono: string }> = {
	pendiente: { clase: 'badge-warning', label: 'Pendiente', icono: 'clock' },
	aceptado: { clase: 'badge-primary', label: 'Aceptado', icono: 'check-circle' },
	en_proceso: { clase: 'badge-info', label: 'En proceso', icono: 'arrow-repeat' },
	rumbo_a_ubicacion: { clase: 'badge-info', label: 'Rumbo a ubicación', icono: 'geo-alt' },
	trabajo_realizado: { clase: 'badge-success', label: 'Trabajo realizado', icono: 'check2-circle' },
	finalizado: { clase: 'badge-neutral', label: 'Finalizado', icono: 'check-all' },
	rechazado: { clase: 'badge-danger', label: 'Rechazado', icono: 'x-circle' },
};

const calificaciones = [
	{ puntaje: 5, fecha: '25/09/2026', comentario: 'Excelente trabajo, muy puntual y profesional.' },
	{ puntaje: 4, fecha: '20/09/2026', comentario: 'Buen servicio, quedó todo funcionando perfectamente.' },
	{ puntaje: 5, fecha: '15/09/2026', comentario: 'Muy atento y limpio. Volvería a contratarlo.' },
];

const promedio = 4.7;
const estrellasLlenas = Math.round(promedio);
const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);

const conteos = {
	pendiente: solicitudes.filter((s) => s.estado === 'pendiente').length,
	aceptado: solicitudes.filter((s) => s.estado === 'aceptado').length,
	en_proceso: solicitudes.filter((s) => s.estado === 'en_proceso').length,
	rumbo_a_ubicacion: solicitudes.filter((s) => s.estado === 'rumbo_a_ubicacion').length,
	trabajo_realizado: solicitudes.filter((s) => s.estado === 'trabajo_realizado').length,
	finalizado: solicitudes.filter((s) => s.estado === 'finalizado').length,
};
const pendientes = conteos.pendiente;
const nombre = usuario.nombre;
---

<Layout title="Panel Trabajador — Hilf'e">
	<slot name="head" slot="head">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
	</slot>

	<nav class="navbar-hilfe" id="mainNav">
		<div class="nav-inner">
			<a href="/" class="logo">Hilf<span class="logo-accent">'e</span></a>
			<div class="nav-actions">
				<button type="button" class="theme-toggle" aria-label="Toggle theme">
					<svg class="theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
					<svg class="theme-icon-dark" style="display:none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
				</button>
				<UserMenu />
			</div>
		</div>
	</nav>

	<div class="page-layout page-layout-offset">
		<aside class="sidebar">
			<div class="sidebar-section">General</div>
			<button class="sidebar-item active" id="nav-dashboard" onclick="showSection('dashboard')">
				<i class="bi bi-grid-1x2-fill"></i> Dashboard
			</button>

			<div class="sidebar-section">Mis Servicios</div>
			<button class="sidebar-item" id="nav-servicios" onclick="showSection('servicios')">
				<i class="bi bi-briefcase-fill"></i> Mis Servicios
			</button>
			<button type="button" class="sidebar-item" onclick="abrirAgregarServicio()">
				<i class="bi bi-plus-circle-fill"></i> Agregar Servicio
			</button>

			<div class="sidebar-section">Solicitudes</div>
			<button class="sidebar-item" id="nav-solicitudes" onclick="showSection('solicitudes')" aria-label="Solicitudes, 0 pendientes">
				<i class="bi bi-calendar-check-fill"></i><span>Solicitudes</span>
				<span class="solicitudes-bell-area" aria-hidden="true"><i class="bi bi-bell-fill"></i><span id="campanaSolicitudesPendientes" class="solicitudes-badge" hidden>0</span></span>
			</button>

			<div class="sidebar-section">Calificaciones</div>
			<button class="sidebar-item" id="nav-calificaciones" onclick="showSection('calificaciones')">
				<i class="bi bi-star-fill"></i> Calificaciones
			</button>

			<div class="sidebar-section">Cuenta</div>
			<a href="/trabajador/?section=perfil" class="sidebar-item" id="nav-perfil">
				<i class="bi bi-person-fill"></i> Mi Perfil
			</a>
			<a href="/login/login" class="sidebar-item danger">
				<i class="bi bi-box-arrow-right"></i> Cerrar sesión
			</a>
		</aside>
		<main>

			<div class="content-header">
				<h2 id="page-title" class="section-title-page">Dashboard</h2>
				<div class="welcome-text" style="margin-left: auto;">
					Bienvenido, <strong>{nombre}</strong>
				</div>
			</div>
			<div id="section-dashboard" class="section-view active">
				<div class="stats-grid">
					<div class="stat-card">
						<div class="stat-card-icon primary">
							<i class="bi bi-briefcase-fill"></i>
						</div>
						<div class="stat-card-body">
							<div class="stat-card-value" id="totalServicios">{servicios.length}</div>
							<div class="stat-card-label">Servicios registrados</div>
							<div class="stat-card-trend up">Activos</div>
						</div>
					</div>
					<div class="stat-card">
						<div class="stat-card-icon success">
							<i class="bi bi-calendar-check-fill"></i>
						</div>
						<div class="stat-card-body">
							<div class="stat-card-value" id="totalSolicitudesTrabajador">{solicitudes.length}</div>
							<div class="stat-card-label">Solicitudes recibidas</div>
							<div class="stat-card-trend">Total</div>
						</div>
					</div>
					<div class="stat-card">
						<div class="stat-card-icon warning">
							<i class="bi bi-star-fill"></i>
						</div>
						<div class="stat-card-body">
							<div class="stat-card-value">{promedio}</div>
							<div class="stat-card-label">Calificación promedio</div>
							<div class="stat-card-trend">General</div>
						</div>
					</div>
					<div class="stat-card">
						<div class="stat-card-icon warning">
							<i class="bi bi-clock-fill"></i>
						</div>
						<div class="stat-card-body">
							<div class="stat-card-value" id="totalPendientesTrabajador">{pendientes}</div>
							<div class="stat-card-label">Pendientes</div>
							<div class="stat-card-trend">Requieren atención</div>
						</div>
					</div>
				</div>

				<h3 class="quick-access-title">Accesos Rápidos</h3>
				<div class="stats-grid">
					<div class="card clickable-card" onclick="showSection('servicios')">
						<div class="card-body flex items-center gap-md">
							<div class="stat-card-icon primary">
								<i class="bi bi-briefcase-fill"></i>
							</div>
							<div>
								<div class="font-bold" style="color: var(--text);">Mis Servicios</div>
								<div class="text-secondary" style="font-size: 13px;">Gestiona tus servicios activos</div>
							</div>
						</div>
					</div>
					<div class="card clickable-card" onclick="showSection('solicitudes')">
						<div class="card-body flex items-center gap-md">
							<div class="stat-card-icon success">
								<i class="bi bi-calendar-check-fill"></i>
							</div>
							<div>
								<div class="font-bold" style="color: var(--text);">Solicitudes</div>
								<div class="text-secondary" style="font-size: 13px;">Revisa tus solicitudes recibidas</div>
							</div>
						</div>
					</div>
					<div class="card clickable-card" onclick="showSection('calificaciones')">
						<div class="card-body flex items-center gap-md">
							<div class="stat-card-icon warning">
								<i class="bi bi-star-fill"></i>
							</div>
							<div>
								<div class="font-bold" style="color: var(--text);">Calificaciones</div>
								<div class="text-secondary" style="font-size: 13px;">Ve lo que dicen tus clientes</div>
							</div>
						</div>
					</div>
				</div>

				<h3 class="quick-access-title">Estado de Solicitudes</h3>
				<div class="stats-grid">
					<div class="stat-card">
						<div class="stat-card-icon primary"><i class="bi bi-check-circle-fill"></i></div>
						<div class="stat-card-body">
							<div class="stat-card-value" id="conteoAceptadasTrabajador">{conteos.aceptado}</div>
							<div class="stat-card-label">Aceptados</div>
						</div>
					</div>
					<div class="stat-card">
						<div class="stat-card-icon primary"><i class="bi bi-arrow-repeat"></i></div>
						<div class="stat-card-body">
							<div class="stat-card-value" id="conteoProcesoTrabajador">{conteos.en_proceso}</div>
							<div class="stat-card-label">En proceso</div>
						</div>
					</div>
					<div class="stat-card">
						<div class="stat-card-icon primary"><i class="bi bi-geo-alt-fill"></i></div>
						<div class="stat-card-body">
							<div class="stat-card-value" id="conteoRumboTrabajador">{conteos.rumbo_a_ubicacion}</div>
							<div class="stat-card-label">Rumbo a ubicación</div>
						</div>
					</div>
					<div class="stat-card">
						<div class="stat-card-icon success"><i class="bi bi-check2-circle"></i></div>
						<div class="stat-card-body">
							<div class="stat-card-value" id="conteoRealizadoTrabajador">{conteos.trabajo_realizado}</div>
							<div class="stat-card-label">Trabajo realizado</div>
						</div>
					</div>
					<div class="stat-card">
						<div class="stat-card-icon success"><i class="bi bi-check-all"></i></div>
						<div class="stat-card-body">
							<div class="stat-card-value" id="conteoFinalizadoTrabajador">{conteos.finalizado}</div>
							<div class="stat-card-label">Finalizados</div>
						</div>
					</div>
				</div>
			</div>
			<div id="section-servicios" class="section-view">
				<div class="workers-grid">
					{servicios.map((s) => (
						<div class="worker-card">
							<div class="worker-banner" style="background: linear-gradient(135deg, var(--primary-soft), var(--primary-light));">
								<div class="worker-avatar" style="background: var(--primary);">
									<i class="bi bi-briefcase"></i>
								</div>
							</div>
							<div class="worker-info">
								<h4>{s.titulo}</h4>
								<div class="worker-service">{s.categoria}</div>
								<p>{s.descripcion}</p>
								<div class="worker-footer">
									<strong>$ {s.precio.toLocaleString('es-CO')}</strong>
									{s.disponible ? (
										<span class="badge badge-success">Disponible</span>
									) : (
										<span class="badge badge-neutral">No disponible</span>
									)}
								</div>
								<div class="flex gap-sm" style="margin-top: 12px;">
									<a href={`/trabajador/editar-servicio/${s.id}`} class="btn btn-sm btn-secondary"><i class="bi bi-pencil-fill"></i> Editar</a>
									<a href={`/trabajador/subir-imagen/${s.id}`} class="btn btn-sm btn-secondary"><i class="bi bi-camera-fill"></i> Fotos</a>
									<button type="button" class="btn btn-sm btn-outline-danger" onclick="mostrarToast('Eliminación disponible cuando el backend esté conectado (demo)')"><i class="bi bi-trash-fill"></i> Eliminar</button>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
			<template id="plantillaServicio">
				<div class="worker-card">
					<div class="worker-banner" style="background: linear-gradient(135deg, var(--primary-soft), var(--primary-light));">
						<div class="worker-avatar" style="background: var(--primary);"><i class="bi bi-briefcase"></i></div>
					</div>
					<div class="worker-info">
						<h4 data-campo="titulo"></h4>
						<div class="worker-service" data-campo="categoria"></div>
						<p data-campo="descripcion"></p>
						<div class="worker-footer"><strong data-campo="precio"></strong><span data-campo="disponibilidad"></span></div>
						<div class="flex gap-sm" style="margin-top: 12px;">
							<button type="button" class="btn btn-sm btn-secondary" data-accion="editar"><i class="bi bi-pencil-fill"></i> Editar</button>
							<a class="btn btn-sm btn-secondary" data-accion="fotos"><i class="bi bi-camera-fill"></i> Fotos</a>
							<button type="button" class="btn btn-sm btn-outline-danger" data-accion="eliminar"><i class="bi bi-trash-fill"></i> Eliminar</button>
						</div>
					</div>
				</div>
			</template>
			<div id="section-solicitudes" class="section-view">
				<div class="flex filter-bar gap-sm">
					<button class="btn btn-sm btn-secondary filtro-btn active" onclick="filtrarSolicitudes('todos', this)">
						Todos <span class="badge badge-neutral badge-sm" id="filtroTodosTrabajador">{solicitudes.length}</span>
					</button>
					<button class="btn btn-sm btn-secondary filtro-btn" onclick="filtrarSolicitudes('pendiente', this)">
						Pendientes <span class="badge badge-warning badge-sm" id="filtroPendientesTrabajador">{conteos.pendiente}</span>
					</button>
					<button class="btn btn-sm btn-secondary filtro-btn" onclick="filtrarSolicitudes('aceptado', this)">
						Aceptados <span class="badge badge-primary badge-sm" id="filtroAceptadosTrabajador">{conteos.aceptado}</span>
					</button>
					<button class="btn btn-sm btn-secondary filtro-btn" onclick="filtrarSolicitudes('en_proceso', this)">
						En proceso <span class="badge badge-info badge-sm" id="filtroProcesoTrabajador">{conteos.en_proceso}</span>
					</button>
					<button class="btn btn-sm btn-secondary filtro-btn" onclick="filtrarSolicitudes('rumbo_a_ubicacion', this)">
						Rumbo <span class="badge badge-info badge-sm" id="filtroRumboTrabajador">{conteos.rumbo_a_ubicacion}</span>
					</button>
					<button class="btn btn-sm btn-secondary filtro-btn" onclick="filtrarSolicitudes('trabajo_realizado', this)">
						Realizado <span class="badge badge-success badge-sm" id="filtroRealizadoTrabajador">{conteos.trabajo_realizado}</span>
					</button>
					<button class="btn btn-sm btn-secondary filtro-btn" onclick="filtrarSolicitudes('finalizado', this)">
						Finalizados <span class="badge badge-neutral badge-sm" id="filtroFinalizadosTrabajador">{conteos.finalizado}</span>
					</button>
				</div>

				<div id="lista-solicitudes">
					{solicitudes.map((sol) => {
						const info = estadoInfo[sol.estado];
						return (
							<div class="card solicitud-card" data-id={sol.id} data-estado={sol.estado}>
								<div class="card-body">
									<div class="solicitud-info">
										<div class="cliente">
											<i class="bi bi-person-fill"></i> {sol.cliente}
										</div>
										<div class="servicio">
											<i class="bi bi-briefcase"></i> {sol.servicio}
										</div>
										<div class="meta">
											<i class="bi bi-calendar3"></i> {sol.fecha}
											› <i class="bi bi-clock"></i> {sol.hora}
											{sol.direccion ? (
												<span> › <i class="bi bi-geo-alt"></i> {sol.direccion}</span>
											) : null}
										</div>
									</div>
									<div class="solicitud-actions">
										<span class="badge {info.clase} estado-badge">
											<i class="bi bi-{info.icono}"></i> {info.label}
										</span>
                                        <div class="accion-celda">
									{sol.estado === 'pendiente' ? (
									<>
									<button type="button" class="btn btn-sm btn-success" onclick={`aceptarSolicitud(${sol.id})`}><i class="bi bi-check-lg"></i> Aceptar</button>
									<button type="button" class="btn btn-sm btn-outline-danger js-rechazar-solicitud" data-solicitud-id={sol.id}><i class="bi bi-x-lg"></i> Rechazar</button>
									</>
									) : sol.estado === 'aceptado' ? (
									<button type="button" class="btn btn-sm btn-primary" onclick={`avanzarSolicitud(${sol.id})`}><i class="bi bi-arrow-repeat"></i> En proceso</button>
									) : sol.estado === 'en_proceso' ? (
									<button type="button" class="btn btn-sm btn-primary" onclick={`avanzarSolicitud(${sol.id})`}><i class="bi bi-geo-alt"></i> Rumbo a ubicación</button>
									) : sol.estado === 'rumbo_a_ubicacion' ? (
									<button type="button" class="btn btn-sm btn-success" onclick={`avanzarSolicitud(${sol.id})`}><i class="bi bi-check2-circle"></i> Trabajo realizado</button>
									) : sol.estado === 'trabajo_realizado' ? (
									<button type="button" class="btn btn-sm btn-primary" onclick={`avanzarSolicitud(${sol.id})`}><i class="bi bi-check-all"></i> Finalizar</button>
									) : null}
									</div>
									</div>
								</div>
							</div>
						);
					})}
				</div>
			</div>
			<div id="section-calificaciones" class="section-view">
				<div class="card" style="margin-bottom: 20px;">
					<div class="card-body flex items-center gap-lg" style="flex-wrap: wrap;">
						<div class="text-center">
							<div class="promedio-valor">{promedio}</div>
							<div class="promedio-label">Promedio</div>
						</div>
						<div>
							<div class="estrellas-grandes">{stars(estrellasLlenas)}</div>
							<div class="text-secondary" style="font-size: 13px; margin-top: 4px;">
								Basado en {calificaciones.length} calificación(es)
							</div>
						</div>
					</div>
				</div>

				{calificaciones.map((c) => (
					<div class="card calificacion-card">
						<div class="card-body">
							<div class="flex justify-between items-center" style="margin-bottom: 8px;">
								<span class="estrellas">{stars(c.puntaje)}</span>
								<span class="calificacion-fecha">
									<i class="bi bi-calendar3"></i> {c.fecha}
								</span>
							</div>
							{c.comentario ? (
								<p class="calificacion-comentario">"{c.comentario}"</p>
							) : (
								<p class="calificacion-sin-comentario">Sin comentario</p>
							)}
						</div>
					</div>
				))}
			</div>
			<div id="section-perfil" class="section-view">
				<div class="content-header worker-profile-heading">
					<div>
						<p>Actualiza tus datos de contacto y tu foto. El correo no se puede modificar.</p>
					</div>
				</div>
				<div class="card worker-profile-card">
					<div class="worker-profile-photo-panel">
						<div class="worker-profile-photo" id="perfilFotoVista">
							<span id="perfilFotoInicial">C</span>
							<img id="perfilFotoImagen" alt="Foto de perfil" hidden />
						</div>
						<div class="worker-profile-photo-copy">
							<strong>Foto de perfil</strong>
							<span>JPG o PNG</span>
							<label class="btn btn-outline-primary worker-photo-button" for="perfilFotoArchivo">Elegir foto</label>
							<input id="perfilFotoArchivo" type="file" accept="image/jpeg,image/png" hidden />
						</div>
					</div>
					<div id="perfilTrabajadorMensaje" class="worker-profile-message" role="status" hidden></div>
					<form id="formPerfilTrabajador" class="worker-profile-form">
						<div class="form-group">
							<label for="perfilTrabajadorNombre">Nombre completo</label>
							<input class="form-control" id="perfilTrabajadorNombre" name="nombre" autocomplete="name" required />
						</div>
						<div class="form-group">
							<label for="perfilTrabajadorCorreo">Correo electrónico</label>
							<input class="form-control" id="perfilTrabajadorCorreo" type="email" autocomplete="email" disabled />
							<small class="worker-profile-hint">El correo no se puede modificar.</small>
						</div>
						<div class="form-group">
							<label for="perfilTrabajadorTelefono">Teléfono</label>
							<input class="form-control" id="perfilTrabajadorTelefono" name="telefono" type="tel" autocomplete="tel" />
						</div>
						<div class="form-group">
							<label for="perfilTrabajadorUbicacion">Ubicación</label>
							<input class="form-control" id="perfilTrabajadorUbicacion" name="ubicacion" autocomplete="address-level2" />
						</div>
						<div class="worker-profile-actions">
							<button type="submit" class="btn btn-primary" id="guardarPerfilTrabajador"><i class="bi bi-check2-circle"></i> Guardar cambios</button>
						</div>
					</form>
				</div>
			</div>

		</main>
	</div>

	<div class="modal-overlay" id="modalEditarServicio">
		<div class="modal service-editor-modal">
			<div class="modal-header">
				<h3 id="tituloModalServicio">Editar servicio</h3>
				<button type="button" class="btn-modal-close" id="cerrarEditarServicio" aria-label="Cerrar">&times;</button>
			</div>
			<form id="formEditarServicio">
				<div class="modal-body">
					<input type="hidden" id="editarServicioId" />
					<div class="service-fields-grid">
					<div class="form-group"><label for="editarTitulo">Título</label><input class="form-control" id="editarTitulo" required /></div>
					<div class="form-group"><label for="editarCategoria">Categoría</label><select class="form-control" id="editarCategoria" required></select></div>
					<div class="form-group"><label for="editarDescripcion">Descripción</label><textarea class="form-control" id="editarDescripcion" rows="3"></textarea></div>
					<div class="form-group"><label for="editarPrecio">Precio</label><input class="form-control" id="editarPrecio" type="number" min="0" step="1" required /></div>
					<div class="form-group"><label for="editarTipoServicio">Tipo de servicio</label><input class="form-control" id="editarTipoServicio" /></div>
					</div>
					<div class="form-group">
						<div class="schedule-heading"><div><label>Disponibilidad</label><small>Define cuándo pueden reservar tus servicios.</small></div></div>
						<label class="availability-247-option" for="disponible247"><input id="disponible247" type="checkbox" /><span><strong>Disponible 24/7</strong><small>Todos los días, a cualquier hora</small></span></label>
						<div id="mensaje247" class="availability-247-message" hidden>Tu servicio estará disponible todos los días, durante todo el día.</div>
						<div id="horariosServicio" class="weekly-schedule-editor"></div>
						<small class="schedule-help">O elige los días y horarios en los que trabajas.</small>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" id="cancelarEditarServicio">Cancelar</button>
					<button type="submit" class="btn btn-primary" id="guardarEditarServicio">Guardar cambios</button>
				</div>
			</form>
		</div>
	</div>

	<script is:inline>
		(function () {
			function mostrarToast(msg) {
				var existing = document.getElementById('panelToast');
				if (existing) existing.remove();
				var toast = document.createElement('div');
				toast.id = 'panelToast';
				toast.className = 'toast-notification toast-success';
				toast.innerHTML =
					'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>' +
					'<span>' + msg + '</span>';
				document.body.appendChild(toast);
				setTimeout(function () {
					toast.classList.add('hide');
					setTimeout(function () { toast.remove(); }, 400);
				}, 3500);
			}
			window.mostrarToast = mostrarToast;

			})();

		var titles = {
			dashboard: 'Dashboard',
			servicios: 'Mis Servicios',
			solicitudes: 'Solicitudes',
			calificaciones: 'Calificaciones',
			perfil: 'Mi Perfil'
		};

		function showSection(name) {
			document.querySelectorAll('.section-view').forEach(function (s) { s.classList.remove('active'); });
			document.querySelectorAll('.sidebar-item').forEach(function (s) { s.classList.remove('active'); });
			var section = document.getElementById('section-' + name);
			if (section) section.classList.add('active');
			var navItem = document.getElementById('nav-' + name);
			if (navItem) navItem.classList.add('active');
			var title = document.getElementById('page-title');
			if (title) title.textContent = titles[name] || name;
		}

		function filtrarSolicitudes(estado, btn) {
			filtroEstadoSolicitudes = estado;
			var cards = document.querySelectorAll('#lista-solicitudes .solicitud-card');
			cards.forEach(function (card) {
				card.style.display = (estado === 'todos' || card.dataset.estado === estado) ? '' : 'none';
			});
			document.querySelectorAll('.filtro-btn').forEach(function (b) { b.classList.remove('active'); });
			if (btn) btn.classList.add('active');
		}

		var estadoInfo = {
			pendiente: { clase: 'badge-warning', label: 'Pendiente', icono: 'clock' },
			aceptado: { clase: 'badge-primary', label: 'Aceptado', icono: 'check-circle' },
			en_proceso: { clase: 'badge-info', label: 'En proceso', icono: 'arrow-repeat' },
			rumbo_a_ubicacion: { clase: 'badge-info', label: 'Rumbo a ubicación', icono: 'geo-alt' },
			trabajo_realizado: { clase: 'badge-success', label: 'Trabajo realizado', icono: 'check2-circle' },
			finalizado: { clase: 'badge-neutral', label: 'Finalizado', icono: 'check-all' },
			rechazado: { clase: 'badge-danger', label: 'Rechazado', icono: 'x-circle' },
			cancelada: { clase: 'badge-danger', label: 'Cancelada', icono: 'x-circle' }
		};
		var transicionesSolicitud = { aceptado: 'en_proceso', en_proceso: 'rumbo_a_ubicacion', rumbo_a_ubicacion: 'trabajo_realizado', trabajo_realizado: 'finalizado' };

		async function actualizarEstadoSolicitud(id, estado) {
			try {
				var respuesta = await fetch('http://127.0.0.1:8000/api/solicitudes/' + encodeURIComponent(id) + '/estado', {
					method: 'PUT', headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ Estado_Solicitudes: estado })
				});
				var resultado = await respuesta.json().catch(function () { return {}; });
				if (!respuesta.ok) throw new Error(resultado.mensaje || 'No fue posible actualizar la solicitud.');
				window.mostrarToast(resultado.mensaje || 'Solicitud actualizada.');
				await cargarSolicitudesTrabajador(true);
				return true;
			} catch (error) {
				window.mostrarToast(error.message || 'No fue posible actualizar la solicitud.');
				return false;
			}
		}

		function avanzarSolicitud(id) {
			var card = document.querySelector('.solicitud-card[data-id="' + id + '"]');
			var siguiente = card && transicionesSolicitud[card.dataset.estado];
			if (siguiente) actualizarEstadoSolicitud(id, siguiente);
		}

		function aceptarSolicitud(id) { actualizarEstadoSolicitud(id, 'aceptado'); }

		var listaSolicitudes = document.getElementById('lista-solicitudes');
		if (listaSolicitudes) listaSolicitudes.addEventListener('click', function (e) {
			var boton = e.target.closest('.js-rechazar-solicitud');
			if (boton && window.confirm('¿Deseas rechazar esta solicitud?')) actualizarEstadoSolicitud(boton.dataset.solicitudId, 'rechazado');
		});

		var filtroEstadoSolicitudes = 'todos';
		function fechaSolicitud(fecha) {
			if (!fecha) return '—';
			var partes = String(fecha).slice(0, 10).split('-');
			return partes.length === 3 ? partes[2] + '/' + partes[1] + '/' + partes[0] : String(fecha);
		}
		function textoElemento(tag, clase, texto) {
			var nodo = document.createElement(tag);
			if (clase) nodo.className = clase;
			nodo.textContent = texto || '—';
			return nodo;
		}
		function botonAccionSolicitud(texto, clase, icono, accion) {
			var boton = document.createElement('button');
			boton.type = 'button'; boton.className = 'btn btn-sm ' + clase;
			var icon = document.createElement('i'); icon.className = 'bi bi-' + icono;
			boton.append(icon, document.createTextNode(' ' + texto));
			if (accion) boton.addEventListener('click', accion);
			return boton;
		}
		function agregarAccionesSolicitud(celda, solicitud) {
			var id = solicitud.Id_Solicitud;
			var estado = solicitud.Estado_Solicitudes;
			if (estado === 'pendiente') {
				celda.append(
					botonAccionSolicitud('Aceptar', 'btn-success', 'check-lg', function () { aceptarSolicitud(id); }),
					botonAccionSolicitud('Rechazar', 'btn-outline-danger', 'x-lg', function () {
						if (window.confirm('¿Deseas rechazar esta solicitud?')) actualizarEstadoSolicitud(id, 'rechazado');
					})
				);
				return;
			}
			var acciones = {
				aceptado: ['En proceso', 'btn-primary', 'arrow-repeat'],
				en_proceso: ['Rumbo a ubicación', 'btn-primary', 'geo-alt'],
				rumbo_a_ubicacion: ['Trabajo realizado', 'btn-success', 'check2-circle'],
				trabajo_realizado: ['Finalizar', 'btn-primary', 'check-all']
			};
			if (acciones[estado]) celda.appendChild(botonAccionSolicitud(acciones[estado][0], acciones[estado][1], acciones[estado][2], function () { avanzarSolicitud(id); }));
		}
		function crearTarjetaSolicitud(solicitud) {
			var estado = String(solicitud.Estado_Solicitudes || 'pendiente').toLowerCase();
			var tarjeta = document.createElement('div'); tarjeta.className = 'card solicitud-card';
			tarjeta.dataset.id = solicitud.Id_Solicitud; tarjeta.dataset.estado = estado;
			var cuerpo = document.createElement('div'); cuerpo.className = 'card-body';
			var info = document.createElement('div'); info.className = 'solicitud-info';
			var cliente = textoElemento('div', 'cliente', solicitud.Nombre_Cliente || 'Cliente');
			var clienteIcon = document.createElement('i'); clienteIcon.className = 'bi bi-person-fill'; cliente.prepend(clienteIcon);
			var servicio = textoElemento('div', 'servicio', solicitud.Titulo_Servicio || 'Servicio');
			var servicioIcon = document.createElement('i'); servicioIcon.className = 'bi bi-briefcase'; servicio.prepend(servicioIcon);
			var meta = document.createElement('div'); meta.className = 'meta';
			var calendario = document.createElement('i'); calendario.className = 'bi bi-calendar3';
			var reloj = document.createElement('i'); reloj.className = 'bi bi-clock';
			meta.append(calendario, document.createTextNode(' ' + fechaSolicitud(solicitud.Fecha_Servicio) + ' › '), reloj, document.createTextNode(' ' + String(solicitud.Hora_Servicio || '').slice(0, 5)));
			if (solicitud.Direccion) { var ubicacion = document.createElement('span'); var pin = document.createElement('i'); pin.className = 'bi bi-geo-alt'; ubicacion.append(document.createTextNode(' › '), pin, document.createTextNode(' ' + solicitud.Direccion)); meta.appendChild(ubicacion); }
			if (solicitud.Telefono) { var telefono = document.createElement('span'); telefono.textContent = ' › Teléfono: ' + solicitud.Telefono; meta.appendChild(telefono); }
			info.append(cliente, servicio, meta);
			if (solicitud.Descripcion_Solicitud) info.appendChild(textoElemento('p', 'meta', solicitud.Descripcion_Solicitud));
			var acciones = document.createElement('div'); acciones.className = 'solicitud-actions';
			var datosEstado = estadoInfo[estado] || { clase: 'badge-neutral', label: estado, icono: 'info-circle' };
			var badge = textoElemento('span', 'badge ' + datosEstado.clase + ' estado-badge', datosEstado.label);
			var estadoIcono = document.createElement('i'); estadoIcono.className = 'bi bi-' + datosEstado.icono; badge.prepend(estadoIcono);
			var celda = document.createElement('div'); celda.className = 'accion-celda'; agregarAccionesSolicitud(celda, solicitud);
			acciones.append(badge, celda); cuerpo.append(info, acciones); tarjeta.appendChild(cuerpo);
			return tarjeta;
		}

		async function cargarSolicitudesTrabajador(silencioso) {
			var usuario;
			try { usuario = JSON.parse(localStorage.getItem('usuario') || 'null'); } catch { usuario = null; }
			if (!usuario || Number(usuario.rol) !== 2 || !usuario.id) {
				if (!silencioso) window.mostrarToast('Inicia sesión como trabajador para consultar las solicitudes.');
				return;
			}
			try {
				var respuesta = await fetch('http://127.0.0.1:8000/api/solicitudes?trabajador=' + encodeURIComponent(usuario.id));
				var datos = await respuesta.json().catch(function () { return {}; });
				if (!respuesta.ok) throw new Error(datos.mensaje || 'No se pudieron cargar las solicitudes.');
				var items = Array.isArray(datos) ? datos : (Array.isArray(datos.value) ? datos.value : []);
				items.sort(function (a, b) { return Number(b.Id_Solicitud || 0) - Number(a.Id_Solicitud || 0); });
				var lista = document.getElementById('lista-solicitudes');
				lista.replaceChildren();
				var conteosEstado = { pendiente: 0, aceptado: 0, en_proceso: 0, rumbo_a_ubicacion: 0, trabajo_realizado: 0, finalizado: 0, rechazado: 0, cancelada: 0 };
				items.forEach(function (solicitud) {
					var estado = String(solicitud.Estado_Solicitudes || 'pendiente').toLowerCase();
					conteosEstado[estado] = (conteosEstado[estado] || 0) + 1;
					lista.appendChild(crearTarjetaSolicitud(solicitud));
				});
				if (!items.length) lista.appendChild(textoElemento('div', 'card card-body', 'Aún no tienes solicitudes de servicio.'));
				var idsConteo = { pendiente: 'filtroPendientesTrabajador', aceptado: 'filtroAceptadosTrabajador', en_proceso: 'filtroProcesoTrabajador', rumbo_a_ubicacion: 'filtroRumboTrabajador', trabajo_realizado: 'filtroRealizadoTrabajador', finalizado: 'filtroFinalizadosTrabajador' };
				Object.keys(idsConteo).forEach(function (estado) { var el = document.getElementById(idsConteo[estado]); if (el) el.textContent = String(conteosEstado[estado] || 0); });
				var numeroPendientes = Number(conteosEstado.pendiente || 0);
				var campana = document.getElementById('campanaSolicitudesPendientes');
				if (campana) { campana.textContent = numeroPendientes > 99 ? '99+' : String(numeroPendientes); campana.hidden = numeroPendientes === 0; }
				var botonSolicitudes = document.getElementById('nav-solicitudes');
				if (botonSolicitudes) botonSolicitudes.setAttribute('aria-label', 'Solicitudes, ' + numeroPendientes + ' pendientes');
				var total = document.getElementById('totalSolicitudesTrabajador'); if (total) total.textContent = String(items.length);
				var totalTodos = document.getElementById('filtroTodosTrabajador'); if (totalTodos) totalTodos.textContent = String(items.length);
				var pendientes = document.getElementById('totalPendientesTrabajador'); if (pendientes) pendientes.textContent = String(conteosEstado.pendiente || 0);
				var aceptadas = document.getElementById('conteoAceptadasTrabajador'); if (aceptadas) aceptadas.textContent = String(conteosEstado.aceptado || 0);
				var proceso = document.getElementById('conteoProcesoTrabajador'); if (proceso) proceso.textContent = String(conteosEstado.en_proceso || 0);
				var rumbo = document.getElementById('conteoRumboTrabajador'); if (rumbo) rumbo.textContent = String(conteosEstado.rumbo_a_ubicacion || 0);
				var realizado = document.getElementById('conteoRealizadoTrabajador'); if (realizado) realizado.textContent = String(conteosEstado.trabajo_realizado || 0);
				var finalizado = document.getElementById('conteoFinalizadoTrabajador'); if (finalizado) finalizado.textContent = String(conteosEstado.finalizado || 0);
				filtrarSolicitudes(filtroEstadoSolicitudes, document.querySelector('.filtro-btn.active'));
			} catch (error) { if (!silencioso) window.mostrarToast(error.message || 'No se pudieron cargar las solicitudes.'); }
		}
		cargarSolicitudesTrabajador(false);
		window.setInterval(function () { cargarSolicitudesTrabajador(true); }, 12000);
		window.addEventListener('focus', function () { cargarSolicitudesTrabajador(true); });

		(function conectarServiciosTrabajador() {
			var api = 'http://127.0.0.1:8000/api';
			var grid = document.querySelector('#section-servicios .workers-grid');
			var template = document.getElementById('plantillaServicio');
			var contador = document.getElementById('totalServicios');
			var modal = document.getElementById('modalEditarServicio');
			var formulario = document.getElementById('formEditarServicio');
			var categorias = [];
			var serviciosPorId = {};
			var horariosPorServicio = {};
			var modoCreacion = false;
			var diasSemana = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
			var horariosGuardadosAntes247 = null;

			function pintarEditorHorarios(horarios) {
				var contenedor = document.getElementById('horariosServicio');
				contenedor.replaceChildren();
				var porDia = {};
				(horarios || []).forEach(function (h) { porDia[h.Dia_Semana] = h; });
				var disponible247 = diasSemana.every(function (dia) {
					var h = porDia[dia];
					return h && String(h.Hora_Inicio).slice(0, 5) === '00:00' && String(h.Hora_Fin) === '23:59:59';
				}) && Object.keys(porDia).length === diasSemana.length;
				var opcion247 = document.getElementById('disponible247');
				opcion247.checked = disponible247;
				document.getElementById('mensaje247').hidden = !disponible247;
				contenedor.hidden = disponible247;
				var encabezado = document.createElement('div'); encabezado.className = 'weekly-schedule-header';
				['Día', 'Desde', 'Hasta'].forEach(function (texto) { var celda = document.createElement('span'); celda.textContent = texto; encabezado.appendChild(celda); });
				contenedor.appendChild(encabezado);
				diasSemana.forEach(function (dia) {
					var existente = porDia[dia];
					var fila = document.createElement('div'); fila.className = 'weekly-schedule-row';
					var etiqueta = document.createElement('label'); etiqueta.className = 'weekly-schedule-day';
					var check = document.createElement('input'); check.type = 'checkbox'; check.dataset.dia = dia; check.checked = !!existente;
					etiqueta.append(check, document.createTextNode(dia));
					var inicio = document.createElement('input'); inicio.type = 'time'; inicio.dataset.inicio = dia; inicio.value = existente ? String(existente.Hora_Inicio).slice(0, 5) : '08:00'; inicio.setAttribute('aria-label', 'Hora de inicio ' + dia);
					var fin = document.createElement('input'); fin.type = 'time'; fin.dataset.fin = dia; fin.value = existente ? String(existente.Hora_Fin).slice(0, 5) : '17:00'; fin.setAttribute('aria-label', 'Hora de fin ' + dia);
					if (disponible247) { check.checked = true; inicio.value = '00:00'; fin.value = '23:59'; check.disabled = true; inicio.disabled = true; fin.disabled = true; }
					var inicioCampo = document.createElement('label'); inicioCampo.className = 'weekly-time-field'; var inicioTexto = document.createElement('span'); inicioTexto.textContent = 'Desde'; inicioCampo.append(inicioTexto, inicio);
					var finCampo = document.createElement('label'); finCampo.className = 'weekly-time-field'; var finTexto = document.createElement('span'); finTexto.textContent = 'Hasta'; finCampo.append(finTexto, fin);
					fila.append(etiqueta, inicioCampo, finCampo); contenedor.appendChild(fila);
				});
			}

			function leerHorariosEditor(ignorarModo247) {
				if (!ignorarModo247 && document.getElementById('disponible247').checked) return diasSemana.map(function (dia) { return { Dia_Semana: dia, Hora_Inicio: '00:00', Hora_Fin: '23:59:59' }; });
				return Array.from(document.querySelectorAll('#horariosServicio [data-dia]:checked')).map(function (check) {
					var dia = check.dataset.dia;
					return { Dia_Semana: dia, Hora_Inicio: document.querySelector('[data-inicio="' + dia + '"]').value, Hora_Fin: document.querySelector('[data-fin="' + dia + '"]').value };
				});
			}

			document.getElementById('disponible247').addEventListener('change', function (evento) {
				if (evento.target.checked) {
					horariosGuardadosAntes247 = leerHorariosEditor(true);
					pintarEditorHorarios(diasSemana.map(function (dia) { return { Dia_Semana: dia, Hora_Inicio: '00:00', Hora_Fin: '23:59:59' }; }));
				} else {
					pintarEditorHorarios(horariosGuardadosAntes247 || []);
					horariosGuardadosAntes247 = null;
				}
			});

			async function guardarHorarios(servicioId, trabajadorId) {
				var horarios = leerHorariosEditor();
				if (horarios.some(function (h) { return !h.Hora_Inicio || !h.Hora_Fin || h.Hora_Inicio >= h.Hora_Fin; })) throw new Error('Revisa los horarios: la hora de inicio debe ser anterior a la hora de fin.');
				await leerRespuesta(await fetch(api + '/disponibilidad/servicio/' + encodeURIComponent(servicioId), {
					method: 'PUT', headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ Id_Trabajador: Number(trabajadorId), horarios: horarios })
				}));
				horariosPorServicio[String(servicioId)] = horarios;
			}

			async function leerRespuesta(respuesta) {
				var datos = await respuesta.json().catch(function () { return {}; });
				if (!respuesta.ok) throw new Error(datos.mensaje || datos.error || 'No fue posible completar la operación.');
				return datos;
			}

			function mostrarError(error) { window.mostrarToast(error.message || String(error)); }

			function actualizarContador() {
				if (contador) contador.textContent = String(grid.querySelectorAll('.worker-card').length);
			}

			function llenarModal(servicio) {
				modoCreacion = false;
				document.getElementById('tituloModalServicio').textContent = 'Editar servicio';
				document.getElementById('guardarEditarServicio').textContent = 'Guardar cambios';
				document.getElementById('editarServicioId').value = servicio.Id_Servicio;
				document.getElementById('editarTitulo').value = servicio.Titulo || '';
				document.getElementById('editarDescripcion').value = servicio.Descripcion || '';
				document.getElementById('editarPrecio').value = Number(servicio.Precio) || 0;
				document.getElementById('editarTipoServicio').value = servicio.TipoServicio || '';
				var selector = document.getElementById('editarCategoria');
				selector.replaceChildren();
				categorias.forEach(function (categoria) {
					var opcion = document.createElement('option');
					opcion.value = categoria.Id_Categoria;
					opcion.textContent = categoria.Nombre_Categoria;
					selector.appendChild(opcion);
				});
				selector.value = String(servicio.Id_Categoria);
				pintarEditorHorarios(horariosPorServicio[String(servicio.Id_Servicio)] || []);
				modal.classList.add('open');
			}

			window.abrirAgregarServicio = function () {
				if (!categorias.length) {
					window.mostrarToast('Espera a que carguen las categorías y vuelve a intentarlo.');
					return;
				}
				modoCreacion = true;
				horariosGuardadosAntes247 = null;
				document.getElementById('tituloModalServicio').textContent = 'Agregar servicio';
				document.getElementById('guardarEditarServicio').textContent = 'Agregar servicio';
				document.getElementById('editarServicioId').value = '';
				document.getElementById('editarTitulo').value = '';
				document.getElementById('editarDescripcion').value = '';
				document.getElementById('editarPrecio').value = '';
				document.getElementById('editarTipoServicio').value = '';
				pintarEditorHorarios([]);
				var selector = document.getElementById('editarCategoria');
				selector.replaceChildren();
				categorias.forEach(function (categoria) {
					var opcion = document.createElement('option');
					opcion.value = categoria.Id_Categoria;
					opcion.textContent = categoria.Nombre_Categoria;
					selector.appendChild(opcion);
				});
				if (typeof showSection === 'function') showSection('servicios');
				modal.classList.add('open');
			};

			function crearTarjeta(servicio, idsDisponibles) {
				var tarjeta = template.content.firstElementChild.cloneNode(true);
				var id = String(servicio.Id_Servicio);
				serviciosPorId[id] = servicio;
				tarjeta.dataset.servicioId = id;
				tarjeta.querySelector('[data-campo="titulo"]').textContent = servicio.Titulo || '';
				tarjeta.querySelector('[data-campo="categoria"]').textContent = servicio.Nombre_Categoria || '';
				tarjeta.querySelector('[data-campo="descripcion"]').textContent = servicio.Descripcion || '';
				tarjeta.querySelector('[data-campo="precio"]').textContent = '$ ' + Number(servicio.Precio || 0).toLocaleString('es-CO');
				var estado = tarjeta.querySelector('[data-campo="disponibilidad"]');
				var tieneDisponibilidad = idsDisponibles.has(id);
				estado.className = tieneDisponibilidad ? 'badge badge-success' : 'badge badge-neutral';
				estado.textContent = tieneDisponibilidad ? 'Disponible' : 'No disponible';
				tarjeta.querySelector('[data-accion="editar"]').addEventListener('click', function () { llenarModal(servicio); });
				tarjeta.querySelector('[data-accion="fotos"]').href = '/trabajador/fotos/?servicioId=' + encodeURIComponent(id);
				tarjeta.querySelector('[data-accion="eliminar"]').addEventListener('click', async function () {
					if (!window.confirm('¿Eliminar este servicio?')) return;
					try {
						await leerRespuesta(await fetch(api + '/servicios/' + encodeURIComponent(id), { method: 'DELETE' }));
						tarjeta.remove();
						delete serviciosPorId[id];
						actualizarContador();
						window.mostrarToast('Servicio eliminado correctamente.');
					} catch (error) { mostrarError(error); }
				});
				return tarjeta;
			}

			function cerrarModal() { modal.classList.remove('open'); }
			document.getElementById('cerrarEditarServicio').addEventListener('click', cerrarModal);
			document.getElementById('cancelarEditarServicio').addEventListener('click', cerrarModal);
			modal.addEventListener('click', function (evento) { if (evento.target === modal) cerrarModal(); });

			formulario.addEventListener('submit', async function (evento) {
				evento.preventDefault();
				var id = document.getElementById('editarServicioId').value;
				var servicio = serviciosPorId[id];
				var boton = document.getElementById('guardarEditarServicio');
				boton.disabled = true;
				try {
					var usuario = JSON.parse(localStorage.getItem('usuario') || 'null');
					var body = {
						Id_Categoria: Number(document.getElementById('editarCategoria').value),
						Titulo: document.getElementById('editarTitulo').value.trim(),
						Descripcion: document.getElementById('editarDescripcion').value.trim() || null,
						Precio: Number(document.getElementById('editarPrecio').value),
						TipoServicio: document.getElementById('editarTipoServicio').value.trim() || null
					};
					if (modoCreacion) {
						if (!usuario?.id || Number(usuario.rol) !== 2) throw new Error('Inicia sesión como trabajador para agregar un servicio.');
						if (!body.Id_Categoria || !body.Titulo || !Number.isFinite(body.Precio) || body.Precio < 0) throw new Error('Completa el título, categoría y precio del servicio.');
						var nuevoServicio = await leerRespuesta(await fetch(api + '/servicios', {
							method: 'POST', headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ Id_Trabajador: Number(usuario.id), ...body })
						}));
						if (!nuevoServicio.Id_Servicio) throw new Error('El servicio se creó, pero el servidor no devolvió su identificador para guardar los horarios.');
						id = String(nuevoServicio.Id_Servicio);
						document.getElementById('editarServicioId').value = id;
						servicio = { Id_Servicio: id, Id_Trabajador: Number(usuario.id), ...body };
						serviciosPorId[id] = servicio;
						modoCreacion = false;
						document.getElementById('tituloModalServicio').textContent = 'Editar servicio';
						document.getElementById('guardarEditarServicio').textContent = 'Guardar cambios';
						await guardarHorarios(nuevoServicio.Id_Servicio, usuario.id);
						cerrarModal();
						await cargarServicios();
						window.mostrarToast(nuevoServicio.mensaje || 'Servicio agregado correctamente.');
						return;
					}
					await leerRespuesta(await fetch(api + '/servicios/' + encodeURIComponent(id), {
						method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
					}));
					var usuarioActual = JSON.parse(localStorage.getItem('usuario') || 'null');
					await guardarHorarios(id, usuarioActual && usuarioActual.id);
					Object.assign(servicio, body);
					var tarjeta = grid.querySelector('[data-servicio-id="' + id + '"]');
					if (tarjeta) {
						tarjeta.querySelector('[data-campo="titulo"]').textContent = body.Titulo;
						tarjeta.querySelector('[data-campo="categoria"]').textContent = categorias.find(function (c) { return Number(c.Id_Categoria) === body.Id_Categoria; })?.Nombre_Categoria || '';
						tarjeta.querySelector('[data-campo="descripcion"]').textContent = body.Descripcion || '';
						tarjeta.querySelector('[data-campo="precio"]').textContent = '$ ' + body.Precio.toLocaleString('es-CO');
					}
					cerrarModal();
					window.mostrarToast('Servicio actualizado correctamente.');
				} catch (error) { mostrarError(error); }
				finally { boton.disabled = false; }
			});

			async function cargarServicios() {
				try {
					var usuario = JSON.parse(localStorage.getItem('usuario') || 'null');
					if (!usuario || Number(usuario.rol) !== 2 || !usuario.id) throw new Error('Inicia sesión como trabajador para ver tus servicios.');
				var respuestas = await Promise.all([
					fetch(api + '/servicios'), fetch(api + '/disponibilidad'), fetch(api + '/categorias')
					]);
					var datos = await Promise.all(respuestas.map(leerRespuesta));
					var serviciosDelTrabajador = datos[0].filter(function (servicio) { return Number(servicio.Id_Trabajador) === Number(usuario.id); });
					var idsDisponibles = new Set(datos[1].map(function (registro) { return String(registro.Id_Servicio); }));
					horariosPorServicio = {};
					datos[1].forEach(function (registro) { (horariosPorServicio[String(registro.Id_Servicio)] ||= []).push(registro); });
					categorias = datos[2];
					grid.replaceChildren();
					serviciosPorId = {};
					serviciosDelTrabajador.forEach(function (servicio) { grid.appendChild(crearTarjeta(servicio, idsDisponibles)); });
					actualizarContador();
				} catch (error) { mostrarError(error); }
			}
			cargarServicios();
		})();

		(async function cargarPerfilTrabajador() {
			var token = localStorage.getItem('token');
			var usuarioGuardado;

			try {
				usuarioGuardado = JSON.parse(localStorage.getItem('usuario') || 'null');
			} catch {
				return;
			}

			if (!token || !usuarioGuardado?.id) return;

			var nombreSesion = usuarioGuardado.nombre || 'Trabajador';
			var nombreBoton = document.querySelector('.account-trigger-name');
			var nombreMenu = document.querySelector('.yo-menu-header h4');
			var bienvenida = document.querySelector('.welcome-text strong');
			if (nombreBoton) nombreBoton.textContent = nombreSesion;
			if (nombreMenu) nombreMenu.textContent = nombreSesion;
			if (bienvenida) bienvenida.textContent = nombreSesion;
			document.querySelectorAll('.yo-avatar-placeholder').forEach(function (placeholder) {
				placeholder.textContent = nombreSesion.charAt(0).toUpperCase();
			});

			try {
				var response = await fetch('http://127.0.0.1:8000/api/usuarios/' + encodeURIComponent(usuarioGuardado.id), {
					headers: { Authorization: 'Bearer ' + token }
				});
				if (!response.ok) return;

				var perfil = await response.json();
				var nombreReal = perfil.Nombre || usuarioGuardado.nombre;
				if (nombreReal) {
					nombreBoton = document.querySelector('.account-trigger-name');
					nombreMenu = document.querySelector('.yo-menu-header h4');
					bienvenida = document.querySelector('.welcome-text strong');
					if (nombreBoton) nombreBoton.textContent = nombreReal;
					if (nombreMenu) nombreMenu.textContent = nombreReal;
					if (bienvenida) bienvenida.textContent = nombreReal;
					document.querySelectorAll('.yo-avatar-placeholder').forEach(function (placeholder) {
						placeholder.textContent = nombreReal.charAt(0).toUpperCase();
					});
				}

				if (perfil.Foto_Perfil) {
					var fotoUrl = 'http://127.0.0.1:8000/api/usuarios/' + encodeURIComponent(usuarioGuardado.id) + '/foto-perfil';
					document.querySelectorAll('.yo-avatar').forEach(function (avatar) {
						var imagen = document.createElement('img');
						var inicial = avatar.querySelector('.yo-avatar-placeholder');
						imagen.hidden = true;
						imagen.alt = nombreReal ? 'Foto de ' + nombreReal : 'Foto de perfil';
						imagen.onload = function () {
							imagen.hidden = false;
							if (inicial) { inicial.hidden = true; inicial.style.display = 'none'; }
						};
						imagen.onerror = function () {
							imagen.remove();
							if (inicial) { inicial.hidden = false; inicial.style.display = ''; }
						};
						avatar.appendChild(imagen);
						imagen.src = fotoUrl;
					});
				}
			} catch (error) {
				console.error('No fue posible cargar el perfil del trabajador.', error);
			}
		})();

		(function () {
			var params = new URLSearchParams(window.location.search);
			var section = params.get('section');
			if (section && ['dashboard', 'servicios', 'solicitudes', 'calificaciones', 'perfil'].indexOf(section) >= 0) {
				showSection(section);
			}
		})();
	</script>
	<script is:inline>
		(function () {
			var api = 'http://127.0.0.1:8000/api';
			var form = document.getElementById('formPerfilTrabajador');
			var feedback = document.getElementById('perfilTrabajadorMensaje');
			var photoInput = document.getElementById('perfilFotoArchivo');
			var photoImage = document.getElementById('perfilFotoImagen');
			var photoInitial = document.getElementById('perfilFotoInicial');
			var photoPreviewUrl = null;
			var profileLoaded = false;

			function getSession() {
				try {
					var usuario = JSON.parse(localStorage.getItem('usuario') || 'null');
					var token = localStorage.getItem('token');
					if (!usuario || Number(usuario.rol) !== 2 || !usuario.id || !token) return null;
					return { usuario: usuario, token: token };
				} catch { return null; }
			}
			function showFeedback(text, isError) {
				feedback.textContent = text;
				feedback.classList.toggle('is-error', Boolean(isError));
				feedback.hidden = false;
			}
			function setPhoto(src, name) {
				photoInitial.textContent = (name || 'T').trim().charAt(0).toUpperCase();
				photoInitial.hidden = false;
				photoImage.hidden = true;
				photoImage.removeAttribute('src');
				if (src) {
					photoImage.onload = function () { photoImage.hidden = false; photoInitial.hidden = true; };
					photoImage.onerror = function () { photoImage.hidden = true; photoInitial.hidden = false; };
					photoImage.src = src;
				}
			}
			function updatePanelIdentity(name, photoUrl) {
				var nameButton = document.querySelector('.account-trigger-name');
				var nameMenu = document.querySelector('.yo-menu-header h4');
				var welcome = document.querySelector('.welcome-text strong');
				if (nameButton) nameButton.textContent = name;
				if (nameMenu) nameMenu.textContent = name;
				if (welcome) welcome.textContent = name;
				document.querySelectorAll('.yo-avatar-placeholder').forEach(function (placeholder) {
					placeholder.textContent = name.trim().charAt(0).toUpperCase();
				});
				if (photoUrl) document.querySelectorAll('.yo-avatar').forEach(function (avatar) {
					var image = avatar.querySelector('img');
					if (!image) { image = document.createElement('img'); avatar.appendChild(image); }
					var initial = avatar.querySelector('.yo-avatar-placeholder');
					if (initial) { initial.hidden = false; initial.style.display = ''; }
					image.hidden = true;
					image.alt = 'Foto de ' + name;
					image.onload = function () {
						image.hidden = false;
						if (initial) { initial.hidden = true; initial.style.display = 'none'; }
					};
					image.onerror = function () {
						image.hidden = true;
						if (initial) { initial.hidden = false; initial.style.display = ''; }
					};
					image.src = photoUrl;
				});
			}
			async function readResponse(response) {
				var result = await response.json().catch(function () { return {}; });
				if (!response.ok) throw new Error(result.mensaje || result.error || 'No se pudo completar la solicitud.');
				return result;
			}
			async function loadProfile() {
				if (profileLoaded) return;
				var session = getSession();
				if (!session) {
					showFeedback('Inicia sesión como trabajador para editar tu perfil.', true);
					return;
				}
				try {
					var response = await fetch(api + '/usuarios/' + encodeURIComponent(session.usuario.id), {
						headers: { Authorization: 'Bearer ' + session.token }
					});
					var perfil = await readResponse(response);
					document.getElementById('perfilTrabajadorNombre').value = perfil.Nombre || session.usuario.nombre || '';
					document.getElementById('perfilTrabajadorCorreo').value = perfil.Correo || session.usuario.correo || '';
					document.getElementById('perfilTrabajadorTelefono').value = perfil.Telefono || '';
					document.getElementById('perfilTrabajadorUbicacion').value = perfil.Ubicacion || '';
					if (perfil.Foto_Perfil) setPhoto(api + '/usuarios/' + encodeURIComponent(session.usuario.id) + '/foto-perfil?v=' + Date.now(), perfil.Nombre || session.usuario.nombre);
					else setPhoto('', perfil.Nombre || session.usuario.nombre);
					profileLoaded = true;
				} catch (error) {
					showFeedback(error instanceof Error ? error.message : 'No se pudo cargar tu perfil.', true);
				}
			}

			if (!form) return;
			window.cargarPerfilTrabajador = loadProfile;
			var query = new URLSearchParams(window.location.search);
			if (query.get('section') === 'perfil') loadProfile();

			photoInput.addEventListener('change', function () {
				var file = photoInput.files && photoInput.files[0];
				if (!file) return;
				if (!['image/jpeg', 'image/png'].includes(file.type)) {
					photoInput.value = '';
					showFeedback('La foto debe ser JPG o PNG.', true);
					return;
				}
				if (photoPreviewUrl) URL.revokeObjectURL(photoPreviewUrl);
				photoPreviewUrl = URL.createObjectURL(file);
				setPhoto(photoPreviewUrl, document.getElementById('perfilTrabajadorNombre').value);
				feedback.hidden = true;
			});

			form.addEventListener('submit', async function (event) {
				event.preventDefault();
				var session = getSession();
				if (!session) { showFeedback('Inicia sesión como trabajador para guardar los cambios.', true); return; }
				var button = document.getElementById('guardarPerfilTrabajador');
				button.disabled = true;
				feedback.hidden = true;
				try {
					var nombre = document.getElementById('perfilTrabajadorNombre').value.trim();
					var response = await fetch(api + '/usuarios/' + encodeURIComponent(session.usuario.id), {
						method: 'PUT',
						headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + session.token },
						body: JSON.stringify({
							nombre: nombre,
							telefono: document.getElementById('perfilTrabajadorTelefono').value.trim(),
							ubicacion: document.getElementById('perfilTrabajadorUbicacion').value.trim()
						})
					});
					var result = await readResponse(response);
					localStorage.setItem('usuario', JSON.stringify({ ...session.usuario, nombre: nombre }));
					updatePanelIdentity(nombre);
					profileLoaded = true;
					if (photoInput.files && photoInput.files[0]) {
						var photoData = new FormData();
						photoData.append('foto_Perfil', photoInput.files[0]);
						try {
							var photoResponse = await fetch(api + '/usuarios/' + encodeURIComponent(session.usuario.id) + '/foto-perfil', {
								method: 'POST', headers: { Authorization: 'Bearer ' + session.token }, body: photoData
							});
							await readResponse(photoResponse);
							photoInput.value = '';
							if (photoPreviewUrl) { URL.revokeObjectURL(photoPreviewUrl); photoPreviewUrl = null; }
							var photoUrl = api + '/usuarios/' + encodeURIComponent(session.usuario.id) + '/foto-perfil?v=' + Date.now();
							setPhoto(photoUrl, nombre);
							updatePanelIdentity(nombre, photoUrl);
						} catch (photoError) {
							showFeedback('Tus datos se guardaron, pero no se pudo actualizar la foto: ' + (photoError instanceof Error ? photoError.message : 'inténtalo de nuevo.'), true);
							return;
						}
					}
					showFeedback(result.mensaje || 'Perfil actualizado correctamente.', false);
				} catch (error) {
					showFeedback(error instanceof Error ? error.message : 'No se pudo guardar el perfil.', true);
				} finally {
					button.disabled = false;
				}
			});
		})();
	</script>
