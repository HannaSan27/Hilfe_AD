---
import Layout from "../../layouts/Layout.astro";
import "../../components/styles/design-system.css";
import "../../components/styles/auth-premium.css";
---

<Layout title="Registro de Trabajador Profesional | Hilf'e Colombia">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  </Fragment>

  <div class="wizard-page-layout">
    <!-- BARRA SUPERIOR -->
    <header class="wizard-navbar">
      <a href="/" class="wizard-brand">
        Hilf<span style="color:var(--primary);">'e</span>
      </a>

      <div style="display:flex;align-items:center;gap:12px;">
        <button
          type="button"
          class="theme-toggle"
          aria-label="Cambiar tema de color"
          style="width:38px;height:38px;border-radius:50%;border:1.5px solid var(--border);background:var(--bg-card);cursor:pointer;display:flex;align-items:center;justify-content:center;"
        >
          <svg class="theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="theme-icon-dark" style="display:none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <a href="/login/registrar" style="font-size:0.875rem;color:var(--text-secondary);text-decoration:none;font-weight:600;display:flex;align-items:center;gap:4px;">
          <i class="bi bi-x-lg"></i>
          <span>Cancelar</span>
        </a>
      </div>
    </header>

    <div class="worker-registration-stage">
      <aside class="worker-intro-panel" aria-label="Tu registro profesional en Hilf'e">
        <div class="worker-intro-topline">
          <span class="worker-live-mark" aria-hidden="true"></span>
          <span>HILF’E · RED DE OFICIOS</span>
        </div>

        <div class="worker-network-art" aria-hidden="true">
          <svg viewBox="0 0 430 220" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M49 151 142 66l84 99 77-112 78 75M142 66l36 107 125-120M49 151l129 22 148-8" stroke="currentColor" stroke-opacity=".42" stroke-width="1.5" />
            <circle cx="49" cy="151" r="7" fill="currentColor" />
            <circle cx="142" cy="66" r="10" fill="currentColor" />
            <circle cx="226" cy="165" r="6" fill="currentColor" />
            <circle cx="303" cy="53" r="13" fill="currentColor" />
            <circle cx="381" cy="128" r="8" fill="currentColor" />
            <circle cx="178" cy="173" r="3" fill="currentColor" fill-opacity=".55" />
            <circle cx="326" cy="165" r="4" fill="currentColor" fill-opacity=".65" />
          </svg>
          <span class="worker-network-caption">Habilidades · confianza · comunidad</span>
        </div>

        <div class="worker-intro-copy">
          <p class="worker-intro-kicker">TU SIGUIENTE PASO EMPIEZA AQUÍ</p>
          <h1>Tu oficio merece un lugar propio.</h1>
          <p>Construye tu perfil en Hilf’e y prepara una vitrina profesional para conectar con personas que necesitan lo que sabes hacer.</p>
        </div>

        <ol class="worker-journey" aria-label="Etapas del registro">
          <li><span>01</span><div><strong>Abre tu cuenta</strong><small>Datos de contacto y acceso</small></div></li>
          <li><span>02</span><div><strong>Confirma tu identidad</strong><small>Información de tu documento</small></div></li>
          <li><span>03</span><div><strong>Cuenta qué haces</strong><small>Especialidad y presentación</small></div></li>
          <li><span>04</span><div><strong>Envía tu solicitud</strong><small>Lectura de condiciones</small></div></li>
        </ol>

        <div class="worker-intro-footnote">
          <i class="bi bi-shield-check" aria-hidden="true"></i>
          <span>La verificación de identidad se revisa antes de habilitar la publicación de servicios.</span>
        </div>
      </aside>

      <!-- ASISTENTE MULTI-PASO DEL TRABAJADOR -->
      <main class="wizard-card" id="workerWizardCard">
      <!-- INDICADOR DE PROGRESO (4 PASOS) -->
      <nav class="wizard-progress-bar" aria-label="Progreso del registro de trabajador">
        <div class="wizard-progress-fill" id="progressFill" style="width: 0%; background: var(--primary);"></div>

        <button type="button" class="step-indicator active" data-step="1" id="stepIndicator1">
          <div class="step-bubble">1</div>
          <span class="step-title">Datos Básicos</span>
        </button>

        <button type="button" class="step-indicator" data-step="2" id="stepIndicator2">
          <div class="step-bubble">2</div>
          <span class="step-title">Identidad</span>
        </button>

        <button type="button" class="step-indicator" data-step="3" id="stepIndicator3">
          <div class="step-bubble">3</div>
          <span class="step-title">Perfil y Foto</span>
        </button>

        <button type="button" class="step-indicator" data-step="4" id="stepIndicator4">
          <div class="step-bubble">4</div>
          <span class="step-title">Revisión Legal</span>
        </button>
      </nav>

      <!-- MENSAJE DE ERROR GLOBAL -->
      <div id="generalErrorAlert" class="auth-verification-alert alert-rejected" style="display:none;" role="alert">
        <i class="bi bi-exclamation-triangle-fill" style="font-size:1.2rem;"></i>
        <div id="generalErrorText"></div>
      </div>

      <form id="trabajadorWizardForm" novalidate>
        <!-- ============================================================
             PASO 1: DATOS BÁSICOS
             ============================================================ -->
        <section class="wizard-step-panel active" id="stepPanel1" data-step="1">
          <div class="step-header">
            <div class="step-header-tag" style="color:var(--accent);">Paso 1 de 4 • Cuenta Profesional</div>
            <h2>Comienza tu perfil de prestador de servicios</h2>
            <p>Ingresa tus datos personales reales para iniciar tu proceso de vinculación y verificación en Hilf'e.</p>
          </div>

          <div class="form-grid-2">
            <div class="field-group">
              <label class="field-label" for="nombresInput">
                Nombres <span class="required-dot">*</span>
              </label>
              <div class="input-container">
                <i class="bi bi-person input-lead-icon"></i>
                <input
                  type="text"
                  id="nombresInput"
                  class="field-control"
                  placeholder="Ej. Jorge Andrés"
                  required
                  autocomplete="given-name"
                />
              </div>
              <div class="field-error-msg" id="err-nombres" style="display:none;"></div>
            </div>

            <div class="field-group">
              <label class="field-label" for="apellidosInput">
                Apellidos <span class="required-dot">*</span>
              </label>
              <div class="input-container">
                <i class="bi bi-person input-lead-icon"></i>
                <input
                  type="text"
                  id="apellidosInput"
                  class="field-control"
                  placeholder="Ej. Muñoz Castro"
                  required
                  autocomplete="family-name"
                />
              </div>
              <div class="field-error-msg" id="err-apellidos" style="display:none;"></div>
            </div>
          </div>

          <div class="form-grid-2">
            <div class="field-group">
              <label class="field-label" for="correoInput">
                Correo electrónico profesional <span class="required-dot">*</span>
              </label>
              <div class="input-container">
                <i class="bi bi-envelope input-lead-icon"></i>
                <input
                  type="email"
                  id="correoInput"
                  class="field-control"
                  placeholder="tu.correo@ejemplo.com"
                  required
                  autocomplete="email"
                />
              </div>
              <div class="field-error-msg" id="err-correo" style="display:none;"></div>
            </div>

            <div class="field-group">
              <label class="field-label" for="telefonoInput">
                Teléfono de atención a clientes <span class="required-dot">*</span>
              </label>
              <div class="input-container">
                <i class="bi bi-telephone input-lead-icon"></i>
                <input
                  type="tel"
                  id="telefonoInput"
                  class="field-control"
                  placeholder="Ej. 3209876543"
                  maxlength="10"
                  required
                  autocomplete="tel"
                />
              </div>
              <div class="field-error-msg" id="err-telefono" style="display:none;"></div>
            </div>
          </div>

          <div class="form-grid-2">
            <div class="field-group">
              <label class="field-label" for="passwordInput">
                Contraseña de acceso <span class="required-dot">*</span>
              </label>
              <div class="input-container">
                <i class="bi bi-lock input-lead-icon"></i>
                <input
                  type="password"
                  id="passwordInput"
                  class="field-control"
                  placeholder="Mínimo 8 caracteres"
                  required
                  autocomplete="new-password"
                />
                <button type="button" class="toggle-password-btn" data-target="passwordInput" aria-label="Mostrar contraseña">
                  <i class="bi bi-eye-slash"></i>
                </button>
              </div>
            </div>

            <div class="field-group">
              <label class="field-label" for="confirmPasswordInput">
                Confirmar contraseña <span class="required-dot">*</span>
              </label>
              <div class="input-container">
                <i class="bi bi-shield-lock input-lead-icon"></i>
                <input
                  type="password"
                  id="confirmPasswordInput"
                  class="field-control"
                  placeholder="Repite tu contraseña"
                  required
                  autocomplete="new-password"
                />
                <button type="button" class="toggle-password-btn" data-target="confirmPasswordInput" aria-label="Mostrar contraseña">
                  <i class="bi bi-eye-slash"></i>
                </button>
              </div>
              <div class="field-error-msg" id="err-confirmPassword" style="display:none;"></div>
            </div>
          </div>

          <!-- MEDIDOR DE FORTALEZA -->
          <div class="password-meter" id="passwordMeter">
            <div class="meter-status-header">
              <span class="meter-status-title">Nivel de seguridad de la contraseña:</span>
              <span class="meter-status-label label-weak" id="meterLabel">Pendiente</span>
            </div>
            <div class="meter-track">
              <div class="meter-segment" id="seg1"></div>
              <div class="meter-segment" id="seg2"></div>
              <div class="meter-segment" id="seg3"></div>
              <div class="meter-segment" id="seg4"></div>
              <div class="meter-segment" id="seg5"></div>
            </div>
            <ul class="password-rules">
              <li id="rule-len"><i class="bi bi-circle"></i> Mínimo 8 caracteres</li>
              <li id="rule-may"><i class="bi bi-circle"></i> Al menos una mayúscula</li>
              <li id="rule-min"><i class="bi bi-circle"></i> Al menos una minúscula</li>
              <li id="rule-num"><i class="bi bi-circle"></i> Al menos un número</li>
              <li id="rule-sym"><i class="bi bi-circle"></i> Al menos un símbolo (!@#$)</li>
            </ul>
          </div>

          <div class="wizard-actions-bar">
            <span style="font-size:0.875rem;color:var(--text-secondary);">
              ¿Ya tienes cuenta activa? <a href="/login/login" style="color:var(--primary);font-weight:600;text-decoration:none;">Inicia sesión</a>
            </span>
            <button type="button" class="btn-nav-next" id="btnNext1" style="background:var(--accent);">
              <span>Continuar</span>
              <i class="bi bi-arrow-right"></i>
            </button>
          </div>
        </section>

        <!-- ============================================================
             PASO 2: DOCUMENTO DE IDENTIDAD
             ============================================================ -->
        <section class="wizard-step-panel" id="stepPanel2" data-step="2">
          <div class="step-header">
            <div class="step-header-tag" style="color:var(--accent);">Paso 2 de 4 • Verificación de Confianza</div>
            <h2>Documento de identidad del trabajador</h2>
            <p>Para otorgar el sello oficial de Verificación y proteger la seguridad de los clientes, validamos manualmente tus datos en la Registraduría.</p>
          </div>

          <div class="field-group">
            <label class="field-label" for="tipoDocumentoSelect">
              Tipo de documento <span class="required-dot">*</span>
            </label>
            <div class="input-container">
              <i class="bi bi-card-text input-lead-icon"></i>
              <select id="tipoDocumentoSelect" class="field-control" required style="cursor:pointer;">
                <option value="CC" selected>Cédula de Ciudadanía (CC)</option>
                <option value="CE">Cédula de Extranjería (CE)</option>
                <option value="TI">Tarjeta de Identidad (TI)</option>
                <option value="PASAPORTE">Pasaporte</option>
                <option value="PPT">Permiso por Protección Temporal (PPT)</option>
              </select>
            </div>
          </div>

          <div class="field-group">
            <label class="field-label" for="numeroDocumentoInput">
              Número de documento <span class="required-dot">*</span>
              <span class="field-hint">Solo dígitos numéricos sin separadores</span>
            </label>
            <div class="input-container">
              <i class="bi bi-hash input-lead-icon"></i>
              <input
                type="text"
                id="numeroDocumentoInput"
                class="field-control"
                placeholder="Ej. 1018273645"
                inputmode="numeric"
                required
              />
            </div>
            <div class="field-error-msg" id="err-numeroDocumento" style="display:none;"></div>
          </div>

          <!-- SELECTOR DE FECHA CON CALENDARIO GREGORIANO -->
          <div class="field-group">
            <label class="field-label">
              Fecha de expedición del documento <span class="required-dot">*</span>
              <span class="field-hint">Día / Mes / Año</span>
            </label>
            <div class="date-selector-row">
              <select id="expDiaSelect" class="field-control" required aria-label="Día de expedición">
                <option value="">Día</option>
              </select>

              <select id="expMesSelect" class="field-control" required aria-label="Mes de expedición">
                <option value="">Mes</option>
                <option value="01">Enero</option>
                <option value="02">Febrero</option>
                <option value="03">Marzo</option>
                <option value="04">Abril</option>
                <option value="05">Mayo</option>
                <option value="06">Junio</option>
                <option value="07">Julio</option>
                <option value="08">Agosto</option>
                <option value="09">Septiembre</option>
                <option value="10">Octubre</option>
                <option value="11">Noviembre</option>
                <option value="12">Diciembre</option>
              </select>

              <select id="expAnioSelect" class="field-control" required aria-label="Año de expedición">
                <option value="">Año</option>
              </select>
            </div>
            <div class="field-error-msg" id="err-fechaExp" style="display:none;"></div>
          </div>

          <div class="colombia-law-notice">
            <i class="bi bi-info-circle-fill" style="color:var(--accent);font-size:1.1rem;"></i>
            <span>
              <strong>Revisión manual:</strong> Esta información no será visible en tu perfil público de trabajador. Se utiliza exclusivamente para la revisión de vigencia en la Registraduría Nacional de Colombia.
            </span>
          </div>

          <div class="wizard-actions-bar">
            <button type="button" class="btn-nav-prev" id="btnPrev2">
              <i class="bi bi-arrow-left"></i>
              <span>Anterior</span>
            </button>
            <button type="button" class="btn-nav-next" id="btnNext2" style="background:var(--accent);">
              <span>Continuar</span>
              <i class="bi bi-arrow-right"></i>
            </button>
          </div>
        </section>

        <!-- ============================================================
             PASO 3: PERFIL PROFESIONAL Y FOTOGRAFÍA
             ============================================================ -->
        <section class="wizard-step-panel" id="stepPanel3" data-step="3">
          <div class="step-header">
            <div class="step-header-tag" style="color:var(--accent);">Paso 3 de 4 • Vitrina Profesional</div>
            <h2>Tu perfil público y especialidades</h2>
            <p>Esta es la información que verán los clientes interesados en contratar tus servicios.</p>
          </div>

          <!-- FOTOGRAFÍA DE PERFIL -->
          <div class="field-group">
            <label class="field-label">
              Fotografía de perfil profesional <span class="required-dot">*</span>
              <span class="field-hint">Formatos JPG o PNG (máx. 5MB)</span>
            </label>
            <div class="avatar-upload-wrapper">
              <div class="avatar-preview-box" id="avatarPreviewContainer">
                <i class="bi bi-person-fill" id="avatarPlaceholderIcon" style="font-size:2.2rem;"></i>
                <img id="avatarImgPreview" style="display:none;" alt="Vista previa de perfil" />
              </div>
              <div class="avatar-upload-info">
                <label for="fotoPerfilInput" class="avatar-upload-btn">
                  <i class="bi bi-camera-fill"></i>
                  <span>Seleccionar foto</span>
                </label>
                <input type="file" id="fotoPerfilInput" accept="image/jpeg,image/png" style="display:none;" />
                <span id="fotoFileName" style="font-size:0.8rem;color:var(--text-secondary);">Ningún archivo seleccionado</span>
              </div>
            </div>
            <div class="field-error-msg" id="err-foto" style="display:none;"></div>
          </div>

          <div class="form-grid-2">
            <div class="field-group">
              <label class="field-label" for="categoriaSelect">
                Especialidad o Categoría principal <span class="required-dot">*</span>
              </label>
              <div class="input-container">
                <i class="bi bi-briefcase input-lead-icon"></i>
                <select id="categoriaSelect" class="field-control" required style="cursor:pointer;">
                  <option value="">Cargando categorías...</option>
                </select>
              </div>
              <div class="field-error-msg" id="err-categoria" style="display:none;"></div>
            </div>

            <div class="field-group">
              <label class="field-label" for="experienciaSelect">
                Años de experiencia <span class="required-dot">*</span>
              </label>
              <div class="input-container">
                <i class="bi bi-award input-lead-icon"></i>
                <select id="experienciaSelect" class="field-control" required style="cursor:pointer;">
                  <option value="Menos de 1 año">Menos de 1 año</option>
                  <option value="1 a 3 años" selected>1 a 3 años</option>
                  <option value="3 a 5 años">3 a 5 años</option>
                  <option value="Más de 5 años">Más de 5 años</option>
                  <option value="Más de 10 años">Más de 10 años</option>
                </select>
              </div>
            </div>
          </div>

          <div class="field-group">
            <label class="field-label" for="ubicacionInput">
              Ciudad y zona de cobertura <span class="required-dot">*</span>
              <span class="field-hint">Ej. Bogotá (Zona Norte y Chapinero) / Medellín</span>
            </label>
            <div class="input-container">
              <i class="bi bi-geo-alt input-lead-icon"></i>
              <input
                type="text"
                id="ubicacionInput"
                class="field-control"
                placeholder="Ciudad y sectores donde prestas servicio"
                required
              />
            </div>
            <div class="field-error-msg" id="err-ubicacion" style="display:none;"></div>
          </div>

          <div class="field-group">
            <label class="field-label" for="descripcionInput">
              Descripción profesional y servicios ofrecidos <span class="required-dot">*</span>
              <span class="field-hint">Mínimo 30 caracteres</span>
            </label>
            <textarea
              id="descripcionInput"
              class="field-control"
              rows="3"
              placeholder="Describe tu experiencia, herramientas, puntualidad y tipo de trabajos que realizas con mayor frecuencia..."
              style="padding-left:1rem;resize:vertical;"
              required
            ></textarea>
            <div class="field-error-msg" id="err-descripcion" style="display:none;"></div>
          </div>

          <div class="wizard-actions-bar">
            <button type="button" class="btn-nav-prev" id="btnPrev3">
              <i class="bi bi-arrow-left"></i>
              <span>Anterior</span>
            </button>
            <button type="button" class="btn-nav-next" id="btnNext3" style="background:var(--accent);">
              <span>Continuar</span>
              <i class="bi bi-arrow-right"></i>
            </button>
          </div>
        </section>

        <!-- ============================================================
             PASO 4: DOCUMENTOS LEGALES Y REVISIÓN
             ============================================================ -->
        <section class="wizard-step-panel" id="stepPanel4" data-step="4">
          <div class="step-header">
            <div class="step-header-tag" style="color:var(--accent);">Paso 4 de 4 • Términos y Confirmación</div>
            <h2>Acuerdos legales y confirmación de datos</h2>
            <p>Revisa la información antes del envío y acepta las condiciones aplicables a trabajadores independientes en Colombia.</p>
          </div>

          <div class="summary-card-block">
            <div class="summary-header-row">
              <h4>Datos del prestador independiente</h4>
              <button type="button" class="summary-edit-btn" data-goto="1">Editar datos</button>
            </div>
            <div class="summary-details-grid">
              <div class="summary-item">
                <span class="summary-item-label">Nombre completo</span>
                <span class="summary-item-value" id="sumNombre">—</span>
              </div>
              <div class="summary-item">
                <span class="summary-item-label">Correo electrónico</span>
                <span class="summary-item-value" id="sumCorreo">—</span>
              </div>
              <div class="summary-item">
                <span class="summary-item-label">Teléfono de atención</span>
                <span class="summary-item-value" id="sumTelefono">—</span>
              </div>
              <div class="summary-item">
                <span class="summary-item-label">Rol en la plataforma</span>
                <span class="summary-item-value" style="color:var(--accent);">Trabajador Independiente</span>
              </div>
            </div>
          </div>

          <div class="summary-card-block">
            <div class="summary-header-row">
              <h4>Identidad y perfil profesional</h4>
              <button type="button" class="summary-edit-btn" data-goto="2">Editar identidad</button>
            </div>
            <div class="summary-details-grid">
              <div class="summary-item">
                <span class="summary-item-label">Documento</span>
                <span class="summary-item-value">
                  <span id="sumTipoDoc">CC</span>
                  <span class="summary-masked-badge" id="sumNumeroDocMasked">••••</span>
                </span>
              </div>
              <div class="summary-item">
                <span class="summary-item-label">Fecha de expedición</span>
                <span class="summary-item-value" id="sumFechaExp">—</span>
              </div>
              <div class="summary-item">
                <span class="summary-item-label">Especialidad</span>
                <span class="summary-item-value" id="sumEspecialidad">—</span>
              </div>
              <div class="summary-item">
                <span class="summary-item-label">Zona de cobertura</span>
                <span class="summary-item-value" id="sumUbicacion">—</span>
              </div>
            </div>
          </div>

          <!-- ACEPTACIÓN DE CONDICIONES LEGALES PARA TRABAJADORES -->
          <div class="legal-acceptance-box">
            <h4 style="font-size:0.95rem;font-weight:700;color:var(--text);margin-bottom:0.85rem;">
              Aceptaciones obligatorias para prestadores (Colombia Ley 1581 de 2012)
            </h4>

            <div class="legal-item">
              <input type="checkbox" id="checkTerminosTrabajador" class="legal-checkbox" required />
              <div class="legal-text-wrapper">
                <label for="checkTerminosTrabajador">
                  He leído íntegramente y acepto los
                </label>
                <button type="button" class="legal-link-btn" data-doc="terminos_condiciones">
                  Términos y Condiciones Generales (v1.0.0)
                </button>
                y las
                <button type="button" class="legal-link-btn" data-doc="condiciones_trabajador">
                  Condiciones Específicas para Trabajadores Independientes
                </button>.
              </div>
            </div>

            <div class="legal-item">
              <input type="checkbox" id="checkDatosTrabajador" class="legal-checkbox" required />
              <div class="legal-text-wrapper">
                <label for="checkDatosTrabajador">
                  Autorizo el tratamiento de mis datos personales según la
                </label>
                <button type="button" class="legal-link-btn" data-doc="politica_privacidad">
                  Política de Privacidad
                </button>
                y la
                <button type="button" class="legal-link-btn" data-doc="autorizacion_datos">
                  Autorización de Cotejo Documental
                </button>.
              </div>
            </div>

            <div class="field-error-msg" id="err-legales" style="display:none;"></div>
          </div>

          <div class="colombia-law-notice" style="margin-bottom:1.5rem;">
            <i class="bi bi-shield-lock" style="color:var(--accent);font-size:1.1rem;"></i>
            <span>
              <strong>Aviso de Verificación:</strong> Al finalizar, tu cuenta quedará en estado <em>Pendiente de Verificación</em>. No podrás publicar nuevos servicios ni agendar citas hasta que el administrador coteje el documento en la Registraduría y autorice el perfil.
            </span>
          </div>

          <div class="wizard-actions-bar">
            <button type="button" class="btn-nav-prev" id="btnPrev4">
              <i class="bi bi-arrow-left"></i>
              <span>Anterior</span>
            </button>
            <button type="button" class="btn-nav-next" id="btnSubmitWorker" style="background:var(--success);padding:0.9rem 2.25rem;">
              <span id="btnSubmitText">
                <i class="bi bi-check2-circle"></i>
                Completar Registro Profesional
              </span>
              <div id="btnSubmitSpinner" style="display:none;width:20px;height:20px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite;"></div>
            </button>
          </div>
        </section>

        <!-- ============================================================
             PANTALLA DE CONFIRMACIÓN POST-REGISTRO TRABAJADOR
             ============================================================ -->
        <section class="verification-pending-card" id="stepSuccessPanel" style="display:none;">
          <div class="pending-shield-icon" style="background:var(--primary-soft);color:var(--primary);">
            <i class="bi bi-hourglass-split"></i>
          </div>
          <h2>¡Tu perfil profesional fue enviado a revisión!</h2>
          <p>
            Tu cuenta de Trabajador ha sido registrada con estado <strong>Pendiente de Verificación</strong>. Nuestro equipo administrativo cotejará la vigencia de tu cédula en el portal de la Registraduría Nacional del Estado Civil. Te notificaremos cuando tu perfil sea aprobado para que puedas comenzar a publicar tus servicios.
          </p>
          <p id="workerPhotoNotice" class="worker-photo-notice" hidden>Tu cuenta quedó creada. La foto no se pudo subir ahora; podrás agregarla desde tu perfil.</p>
          <div style="display:flex;justify-content:center;gap:1rem;flex-wrap:wrap;">
            <a href="/login/login" class="btn-nav-next" style="text-decoration:none;background:var(--primary);">
              <i class="bi bi-box-arrow-in-right"></i>
              <span>Ir al Inicio de Sesión</span>
            </a>
          </div>
        </section>
      </form>
      </main>
    </div>
  </div>

  <!-- MODAL DE VISUALIZACIÓN DE TÉRMINOS Y PRIVACIDAD -->
  <div class="legal-modal-backdrop" id="legalModal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="legal-modal-window">
      <div class="legal-modal-header">
        <h3 id="legalModalTitle">Documento Legal</h3>
        <button type="button" class="legal-modal-close-btn" id="closeLegalModal" aria-label="Cerrar modal">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="legal-modal-body" id="legalModalBody">
        <p>Cargando contenido del documento...</p>
      </div>
      <div class="legal-modal-footer">
        <button type="button" class="btn-nav-prev" id="btnUnderstoodLegal" style="padding:0.6rem 1.25rem;font-size:0.875rem;">
          Entendido y leído
        </button>
      </div>
    </div>
  </div>

  <!-- SCRIPT CLIENT-SIDE DEL ASISTENTE DE TRABAJADOR -->
  <script is:inline>
    (function () {
      let currentStep = 1;
      let formEnviado = false;
      let selectedPhotoFile = null;
      const apiBase = `${window.location.protocol}//${window.location.hostname}:8000/api`;
      let googlePendiente = null;
      try {
        googlePendiente = JSON.parse(sessionStorage.getItem("googlePendiente") || "null");
      } catch {
        sessionStorage.removeItem("googlePendiente");
      }
      const registroConGoogle = Boolean(googlePendiente?.registroToken && Number(googlePendiente.rol) === 2);

      // Estado en memoria
      const state = {
        nombres: "",
        apellidos: "",
        correo: "",
        telefono: "",
        contrasena: "",
        tipoDocumento: "CC",
        numeroDocumento: "",
        fechaExpedicion: "",
        categoria: "",
        categoriaTexto: "",
        experiencia: "1 a 3 años",
        ubicacion: "",
        descripcion: "",
        aceptaciones: ["terminos_condiciones", "condiciones_trabajador", "politica_privacidad", "autorizacion_datos"]
      };

      if (registroConGoogle) {
        const partesNombre = String(googlePendiente.nombre || "").trim().split(/\s+/).filter(Boolean);
        const apellido = partesNombre.length > 1 ? partesNombre.pop() : "";
        document.getElementById("nombresInput").value = partesNombre.join(" ");
        document.getElementById("apellidosInput").value = apellido;
        const correoGoogle = document.getElementById("correoInput");
        correoGoogle.value = String(googlePendiente.correo || "");
        correoGoogle.readOnly = true;
        const contrasena = document.getElementById("passwordInput");
        const confirmarContrasena = document.getElementById("confirmPasswordInput");
        if (contrasena) contrasena.required = false;
        if (confirmarContrasena) confirmarContrasena.required = false;
        contrasena?.closest(".form-grid-2")?.setAttribute("hidden", "");
        document.getElementById("passwordMeter")?.setAttribute("hidden", "");
      }

      // Inicializar selectores de días y años
      const diaSelect = document.getElementById("expDiaSelect");
      const anioSelect = document.getElementById("expAnioSelect");
      const mesSelect = document.getElementById("expMesSelect");

      for (let d = 1; d <= 31; d++) {
        const opt = document.createElement("option");
        opt.value = d < 10 ? "0" + d : String(d);
        opt.textContent = String(d);
        diaSelect?.appendChild(opt);
      }

      const anioActual = new Date().getFullYear();
      for (let y = anioActual; y >= 1930; y--) {
        const opt = document.createElement("option");
        opt.value = String(y);
        opt.textContent = String(y);
        anioSelect?.appendChild(opt);
      }

      // Cargar categorías del backend
      const categoriaSelect = document.getElementById("categoriaSelect");
      async function cargarCategorias() {
        try {
          const res = await fetch(`${apiBase}/categorias`);
          if (res.ok) {
            const data = await res.json();
            categoriaSelect.innerHTML = '<option value="">Selecciona tu especialidad...</option>';
            data.forEach((cat) => {
              const opt = document.createElement("option");
              opt.value = cat.Id_Categoria;
              opt.textContent = cat.Nombre_Categoria;
              categoriaSelect.appendChild(opt);
            });
            return;
          }
        } catch {}
        // Fallback si la API aún no está activa al compilar
        categoriaSelect.innerHTML = `
          <option value="">Selecciona tu especialidad...</option>
          <option value="1">Plomería y Fontanería</option>
          <option value="2">Electricidad e Iluminación</option>
          <option value="3">Pintura y Acabados</option>
          <option value="4">Carpintería y Muebles</option>
          <option value="5">Cerrajería y Seguridad</option>
          <option value="6">Reparaciones Generales</option>
        `;
      }
      cargarCategorias();

      // Password strength tester
      const pwInput = document.getElementById("passwordInput");
      const meterLabel = document.getElementById("meterLabel");
      const segments = [
        document.getElementById("seg1"),
        document.getElementById("seg2"),
        document.getElementById("seg3"),
        document.getElementById("seg4"),
        document.getElementById("seg5"),
      ];
      const rules = [
        { id: "rule-len", test: (v) => v.length >= 8 },
        { id: "rule-may", test: (v) => /[A-Z]/.test(v) },
        { id: "rule-min", test: (v) => /[a-z]/.test(v) },
        { id: "rule-num", test: (v) => /\d/.test(v) },
        { id: "rule-sym", test: (v) => /[^A-Za-z0-9]/.test(v) },
      ];

      function evaluarContrasena() {
        const val = pwInput.value || "";
        let score = 0;
        rules.forEach((r) => {
          const ok = r.test(val);
          const el = document.getElementById(r.id);
          if (el) {
            el.classList.toggle("met", ok);
            const icon = el.querySelector("i");
            if (icon) icon.className = ok ? "bi bi-check-circle-fill" : "bi bi-circle";
          }
          if (ok) score++;
        });

        const labels = ["Muy débil", "Débil", "Regular", "Buena", "Muy fuerte"];
        const classes = ["weak", "weak", "fair", "good", "strong"];

        meterLabel.textContent = val.length ? labels[score - 1] || "Muy débil" : "Pendiente";
        meterLabel.className = "meter-status-label label-" + (classes[score - 1] || "weak");

        segments.forEach((seg, idx) => {
          seg.className = "meter-segment";
          if (idx < score) {
            seg.classList.add("filled-" + classes[score - 1]);
          }
        });
      }
      pwInput?.addEventListener("input", evaluarContrasena);

      // Password visibility toggles
      document.querySelectorAll(".toggle-password-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetId = btn.getAttribute("data-target");
          const input = document.getElementById(targetId);
          if (!input) return;
          const isPw = input.type === "password";
          input.type = isPw ? "text" : "password";
          btn.setAttribute("aria-label", isPw ? "Ocultar contraseña" : "Mostrar contraseña");
          const icon = btn.querySelector("i");
          if (icon) icon.className = isPw ? "bi bi-eye" : "bi bi-eye-slash";
        });
      });

      // Manejo y preview de fotografía
      const fotoInput = document.getElementById("fotoPerfilInput");
      const fotoPreview = document.getElementById("avatarImgPreview");
      const placeholderIcon = document.getElementById("avatarPlaceholderIcon");
      const fotoFileName = document.getElementById("fotoFileName");
      const errFoto = document.getElementById("err-foto");

      fotoInput?.addEventListener("change", (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;

        if (!["image/jpeg", "image/png"].includes(file.type)) {
          errFoto.textContent = "El formato debe ser JPG o PNG.";
          errFoto.style.display = "flex";
          fotoInput.value = "";
          return;
        }

        if (file.size > 5 * 1024 * 1024) {
          errFoto.textContent = "La imagen no debe superar los 5MB.";
          errFoto.style.display = "flex";
          fotoInput.value = "";
          return;
        }

        errFoto.style.display = "none";
        selectedPhotoFile = file;
        fotoFileName.textContent = file.name;

        const reader = new FileReader();
        reader.onload = (event) => {
          fotoPreview.src = event.target.result;
          fotoPreview.style.display = "block";
          placeholderIcon.style.display = "none";
        };
        reader.readAsDataURL(file);
      });

      // Paso del asistente
      function setStep(newStep) {
        if (newStep < 1 || newStep > 4) return;
        currentStep = newStep;

        document.querySelectorAll(".wizard-step-panel").forEach((panel) => {
          panel.classList.toggle("active", Number(panel.getAttribute("data-step")) === currentStep);
        });

        const progressFill = document.getElementById("progressFill");
        const pct = ((currentStep - 1) / 3) * 100;
        if (progressFill) progressFill.style.width = pct + "%";

        document.querySelectorAll(".step-indicator").forEach((ind) => {
          const s = Number(ind.getAttribute("data-step"));
          ind.classList.toggle("active", s === currentStep);
          ind.classList.toggle("completed", s < currentStep);
        });

        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      // Validar Paso 1
      function validarPaso1() {
        let valid = true;
        const nombres = document.getElementById("nombresInput").value.trim();
        const apellidos = document.getElementById("apellidosInput").value.trim();
        const correo = document.getElementById("correoInput").value.trim();
        const telefono = document.getElementById("telefonoInput").value.trim();
        const pw = document.getElementById("passwordInput").value;
        const confirmPw = document.getElementById("confirmPasswordInput").value;

        const errNombres = document.getElementById("err-nombres");
        if (nombres.length < 2) {
          errNombres.textContent = "Ingresa tus nombres completos.";
          errNombres.style.display = "flex";
          valid = false;
        } else errNombres.style.display = "none";

        const errApellidos = document.getElementById("err-apellidos");
        if (apellidos.length < 2) {
          errApellidos.textContent = "Ingresa tus apellidos.";
          errApellidos.style.display = "flex";
          valid = false;
        } else errApellidos.style.display = "none";

        const errCorreo = document.getElementById("err-correo");
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo)) {
          errCorreo.textContent = "Ingresa un correo electrónico profesional válido.";
          errCorreo.style.display = "flex";
          valid = false;
        } else errCorreo.style.display = "none";

        const errTel = document.getElementById("err-telefono");
        if (!/^\d{7,10}$/.test(telefono)) {
          errTel.textContent = "Ingresa un teléfono válido (7 a 10 dígitos).";
          errTel.style.display = "flex";
          valid = false;
        } else errTel.style.display = "none";

        const errConfirm = document.getElementById("err-confirmPassword");
        if (!registroConGoogle) {
          const rulesPassed = rules.filter((r) => r.test(pw)).length;
          if (rulesPassed < 4) {
            errConfirm.textContent = "La contraseña debe cumplir con los requisitos mínimos de seguridad.";
            errConfirm.style.display = "flex";
            valid = false;
          } else if (pw !== confirmPw) {
            errConfirm.textContent = "Las contraseñas no coinciden.";
            errConfirm.style.display = "flex";
            valid = false;
          } else errConfirm.style.display = "none";
        } else errConfirm.style.display = "none";

        if (valid) {
          state.nombres = nombres;
          state.apellidos = apellidos;
          state.correo = correo;
          state.telefono = telefono;
          state.contrasena = registroConGoogle ? "" : pw;
        }

        return valid;
      }

      // Validar Paso 2
      function validarPaso2() {
        let valid = true;
        const tipoDoc = document.getElementById("tipoDocumentoSelect").value;
        const numDoc = document.getElementById("numeroDocumentoInput").value.trim();
        const d = diaSelect.value;
        const m = mesSelect.value;
        const y = anioSelect.value;

        const errDoc = document.getElementById("err-numeroDocumento");
        if (tipoDoc === "CC" || tipoDoc === "TI" || tipoDoc === "CE") {
          if (!/^\d{5,12}$/.test(numDoc)) {
            errDoc.textContent = "El documento debe contener exclusivamente dígitos numéricos (5 a 12 dígitos).";
            errDoc.style.display = "flex";
            valid = false;
          } else errDoc.style.display = "none";
        } else {
          if (numDoc.length < 5 || numDoc.length > 16) {
            errDoc.textContent = "Ingresa un número de documento válido.";
            errDoc.style.display = "flex";
            valid = false;
          } else errDoc.style.display = "none";
        }

        const errFecha = document.getElementById("err-fechaExp");
        if (!d || !m || !y) {
          errFecha.textContent = "Selecciona día, mes y año de expedición.";
          errFecha.style.display = "flex";
          valid = false;
        } else {
          const diaNum = Number(d);
          const mesNum = Number(m);
          const anioNum = Number(y);
          const esBisiesto = (anioNum % 4 === 0 && anioNum % 100 !== 0) || anioNum % 400 === 0;
          const maxDias = [31, esBisiesto ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][mesNum - 1];

          if (diaNum > maxDias) {
            errFecha.textContent = `El día ${diaNum} no es válido para el mes seleccionado en el año ${anioNum}.`;
            errFecha.style.display = "flex";
            valid = false;
          } else {
            const fechaExp = new Date(anioNum, mesNum - 1, diaNum, 23, 59, 59);
            if (fechaExp > new Date()) {
              errFecha.textContent = "La fecha de expedición no puede ser una fecha futura.";
              errFecha.style.display = "flex";
              valid = false;
            } else {
              errFecha.style.display = "none";
              state.tipoDocumento = tipoDoc;
              state.numeroDocumento = numDoc;
              state.fechaExpedicion = `${y}-${m}-${d}`;
            }
          }
        }

        return valid;
      }

      // Validar Paso 3
      function validarPaso3() {
        let valid = true;

        if (!selectedPhotoFile) {
          errFoto.textContent = "Por favor selecciona una foto de perfil profesional para tu cuenta.";
          errFoto.style.display = "flex";
          valid = false;
        } else errFoto.style.display = "none";

        const cat = categoriaSelect.value;
        const errCat = document.getElementById("err-categoria");
        if (!cat) {
          errCat.textContent = "Selecciona tu categoría o especialidad profesional.";
          errCat.style.display = "flex";
          valid = false;
        } else {
          errCat.style.display = "none";
          state.categoria = cat;
          state.categoriaTexto = categoriaSelect.options[categoriaSelect.selectedIndex].text;
        }

        const ubicacion = document.getElementById("ubicacionInput").value.trim();
        const errUbic = document.getElementById("err-ubicacion");
        if (ubicacion.length < 3) {
          errUbic.textContent = "Indica la ciudad y sectores donde prestas tus servicios.";
          errUbic.style.display = "flex";
          valid = false;
        } else {
          errUbic.style.display = "none";
          state.ubicacion = ubicacion;
        }

        const desc = document.getElementById("descripcionInput").value.trim();
        const errDesc = document.getElementById("err-descripcion");
        if (desc.length < 25) {
          errDesc.textContent = "Escribe una descripción profesional más detallada (mínimo 25 caracteres).";
          errDesc.style.display = "flex";
          valid = false;
        } else {
          errDesc.style.display = "none";
          state.descripcion = desc;
        }

        state.experiencia = document.getElementById("experienciaSelect").value;
        return valid;
      }

      // Actualizar Resumen en Paso 4
      function actualizarResumen() {
        document.getElementById("sumNombre").textContent = `${state.nombres} ${state.apellidos}`;
        document.getElementById("sumCorreo").textContent = state.correo;
        document.getElementById("sumTelefono").textContent = state.telefono;
        document.getElementById("sumTipoDoc").textContent = state.tipoDocumento;

        const masked = state.numeroDocumento.length > 4
          ? "••••" + state.numeroDocumento.slice(-4)
          : state.numeroDocumento;
        document.getElementById("sumNumeroDocMasked").textContent = masked;

        document.getElementById("sumFechaExp").textContent = state.fechaExpedicion;
        document.getElementById("sumEspecialidad").textContent = state.categoriaTexto || "Especialidad registrada";
        document.getElementById("sumUbicacion").textContent = state.ubicacion;
      }

      // Navegación entre pasos
      document.getElementById("btnNext1")?.addEventListener("click", () => {
        if (validarPaso1()) setStep(2);
      });
      document.getElementById("btnPrev2")?.addEventListener("click", () => setStep(1));

      document.getElementById("btnNext2")?.addEventListener("click", () => {
        if (validarPaso2()) setStep(3);
      });
      document.getElementById("btnPrev3")?.addEventListener("click", () => setStep(2));

      document.getElementById("btnNext3")?.addEventListener("click", () => {
        if (validarPaso3()) {
          actualizarResumen();
          setStep(4);
        }
      });
      document.getElementById("btnPrev4")?.addEventListener("click", () => setStep(3));

      document.querySelectorAll(".summary-edit-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = Number(btn.getAttribute("data-goto"));
          if (target) setStep(target);
        });
      });

      // ENVÍO FINAL DEL ASISTENTE DE TRABAJADOR
      const submitBtn = document.getElementById("btnSubmitWorker");
      const submitText = document.getElementById("btnSubmitText");
      const submitSpinner = document.getElementById("btnSubmitSpinner");
      const generalErrorAlert = document.getElementById("generalErrorAlert");
      const generalErrorText = document.getElementById("generalErrorText");

      submitBtn?.addEventListener("click", async () => {
        if (formEnviado) return;

        const chkTerminos = document.getElementById("checkTerminosTrabajador").checked;
        const chkDatos = document.getElementById("checkDatosTrabajador").checked;
        const errLegales = document.getElementById("err-legales");

        if (!chkTerminos || !chkDatos) {
          errLegales.textContent = "Debes aceptar los Términos para Trabajadores y la Autorización de Datos para continuar.";
          errLegales.style.display = "flex";
          return;
        }
        errLegales.style.display = "none";
        generalErrorAlert.style.display = "none";

        formEnviado = true;
        submitBtn.disabled = true;
        submitText.style.display = "none";
        submitSpinner.style.display = "inline-block";

        await cargarDocumentosLegales();

        const payload = {
          idRol: 2, // Trabajador
          nombre: `${state.nombres} ${state.apellidos}`.trim(),
          correo: state.correo,
          contrasena: state.contrasena,
          telefono: state.telefono,
          ubicacion: state.ubicacion,
          idCategoriaProfesional: Number(state.categoria),
          experiencia: state.experiencia,
          descripcionProfesional: state.descripcion,
          tipoDocumento: state.tipoDocumento,
          numeroDocumento: state.numeroDocumento,
          fechaExpedicionDocumento: state.fechaExpedicion,
          aceptacionesLegales: state.aceptaciones.map((codigo) => ({ codigo, version: docMap?.[codigo]?.version })),
        };

        const payloadSolicitud = registroConGoogle
          ? {
              registroToken: googlePendiente.registroToken,
              rol: 2,
              nombre: payload.nombre,
              telefono: payload.telefono,
              ubicacion: payload.ubicacion,
              idCategoriaProfesional: payload.idCategoriaProfesional,
              experiencia: payload.experiencia,
              descripcionProfesional: payload.descripcionProfesional,
              tipoDocumento: payload.tipoDocumento,
              numeroDocumento: payload.numeroDocumento,
              fechaExpedicionDocumento: payload.fechaExpedicionDocumento,
              aceptacionesLegales: payload.aceptacionesLegales,
            }
          : payload;

        try {
          // 1. Registro del usuario y verificación
          const endpointRegistro = registroConGoogle ? `${apiBase}/auth/google/completar` : `${apiBase}/auth/registro`;
          const regRes = await fetch(endpointRegistro, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payloadSolicitud),
          });
          const regData = await regRes.json().catch(() => ({}));

          if (!regRes.ok) {
            throw new Error(regData.mensaje || regData.error || "No fue posible crear la cuenta de trabajador.");
          }

          if (registroConGoogle) sessionStorage.removeItem("googlePendiente");

          const userId = regData.idUsuario;
          const token = regData.token;

          // 2. Subida de la fotografía de perfil
          let fotoPendiente = false;
          if (selectedPhotoFile && userId && token) {
            const photoData = new FormData();
            photoData.append("foto_Perfil", selectedPhotoFile);
            try {
              const photoRes = await fetch(`${apiBase}/usuarios/${userId}/foto-perfil`, {
                method: "POST",
                headers: { Authorization: `Bearer ${token}` },
                body: photoData,
              });
              fotoPendiente = !photoRes.ok;
            } catch {
              fotoPendiente = true;
            }
          }

          // Éxito: Ocultar pasos y mostrar confirmación pendiente
          document.querySelectorAll(".wizard-step-panel").forEach((p) => (p.style.display = "none"));
          document.querySelector(".wizard-progress-bar").style.display = "none";
          document.getElementById("workerPhotoNotice").hidden = !fotoPendiente;
          document.getElementById("stepSuccessPanel").style.display = "block";
        } catch (error) {
          generalErrorText.textContent = error instanceof TypeError
            ? "No se pudo conectar con la API de Hilf'e en el puerto 8000. Inicia el servidor Deno y vuelve a intentarlo. XAMPP debe mantener MySQL activo."
            : error.message || "No fue posible completar el registro.";
          generalErrorAlert.style.display = "flex";
          window.scrollTo({ top: 0, behavior: "smooth" });
          formEnviado = false;
          submitBtn.disabled = false;
          submitText.style.display = "inline-flex";
          submitSpinner.style.display = "none";
        }
      });

      // MODAL DE LECTURA LEGAL
      const legalModal = document.getElementById("legalModal");
      const legalModalTitle = document.getElementById("legalModalTitle");
      const legalModalBody = document.getElementById("legalModalBody");
      const closeLegalModal = document.getElementById("closeLegalModal");
      const btnUnderstoodLegal = document.getElementById("btnUnderstoodLegal");

      let docMap = null;
      async function cargarDocumentosLegales() {
        if (docMap) return;
        try {
          const res = await fetch(`${apiBase}/legal/documentos`);
          if (res.ok) {
            const list = await res.json();
            docMap = {};
            list.forEach((doc) => {
              docMap[doc.codigo] = doc;
            });
          }
        } catch {}
      }

      function renderizarDocumentoLegal(contenido) {
        const fragment = document.createDocumentFragment();
        let lista = null;
        const insertarTextoConFormato = (elemento, texto) => {
          texto.split(/(\*\*[^*]+\*\*|\*[^*]+\*)/g).forEach((parte) => {
            if (parte.startsWith("**") && parte.endsWith("**")) {
              const strong = document.createElement("strong");
              strong.textContent = parte.slice(2, -2);
              elemento.appendChild(strong);
            } else if (parte.startsWith("*") && parte.endsWith("*")) {
              const em = document.createElement("em");
              em.textContent = parte.slice(1, -1);
              elemento.appendChild(em);
            } else {
              elemento.appendChild(document.createTextNode(parte));
            }
          });
        };
        String(contenido || "").replace(/\r\n?/g, "\n").split("\n").forEach((linea) => {
          const texto = linea.trim();
          if (!texto) { lista = null; return; }
          const titulo = texto.match(/^(#{1,3})\s+(.+)$/);
          const elementoLista = texto.match(/^[-*]\s+(.+)$/) || texto.match(/^\d+\.\s+(.+)$/);
          if (titulo) {
            lista = null;
            const h = document.createElement(titulo[1].length === 1 ? "h2" : "h3");
            insertarTextoConFormato(h, titulo[2]);
            fragment.appendChild(h);
          } else if (elementoLista) {
            if (!lista) {
              lista = document.createElement(/^\d+\./.test(texto) ? "ol" : "ul");
              fragment.appendChild(lista);
            }
            const li = document.createElement("li");
            insertarTextoConFormato(li, elementoLista[1]);
            lista.appendChild(li);
          } else {
            lista = null;
            const p = document.createElement("p");
            insertarTextoConFormato(p, texto);
            fragment.appendChild(p);
          }
        });
        legalModalBody.replaceChildren(fragment);
      }

      document.querySelectorAll(".legal-link-btn").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          e.preventDefault();
          const docKey = btn.getAttribute("data-doc");
          await cargarDocumentosLegales();

          if (docMap && docMap[docKey]) {
            const d = docMap[docKey];
            legalModalTitle.textContent = `${d.titulo} (v${d.version})`;
            renderizarDocumentoLegal(d.contenido);
          } else {
            legalModalTitle.textContent = "Documento de cumplimiento legal (Colombia Ley 1581 de 2012)";
            legalModalBody.innerHTML = `
              <p><strong>Aviso Regulatorio:</strong> El presente documento rige las condiciones para la prestación de servicios independientes en Hilf'e.</p>
              <p>Para consultas sobre privacidad, comunícate con <em>soportehilfe2@gmail.com</em>.</p>
            `;
          }

          legalModal.classList.add("open");
          legalModal.setAttribute("aria-hidden", "false");
        });
      });

      function cerrarModal() {
        legalModal.classList.remove("open");
        legalModal.setAttribute("aria-hidden", "true");
      }
      closeLegalModal?.addEventListener("click", cerrarModal);
      btnUnderstoodLegal?.addEventListener("click", cerrarModal);
      legalModal?.addEventListener("click", (e) => {
        if (e.target === legalModal) cerrarModal();
      });
    })();
  </script>
</Layout>
