---
import Layout from "../../layouts/Layout.astro";
import "../../components/styles/registrartrabajador.css";

---

<Layout title="Registro Trabajador | Hilf'e">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/design-system.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  </Fragment>

  <div style="position:fixed;top:20px;right:24px;z-index:1000;">
    <button class="theme-toggle" id="themeToggle" aria-label="Cambiar tema" style="width:36px;height:36px;border-radius:50%;border:1.5px solid var(--border);background:var(--bg-card, #fff);cursor:pointer;display:flex;align-items:center;justify-content:center;">
      <svg class="theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="theme-icon-dark" style="display:none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
  </div>

  <div class="simple-form-container">
    <div class="simple-form-box">

      <!-- ICONO -->
      <div class="register-icon">
        <i class="bi bi-briefcase-fill"></i>
      </div>

      <h2>Registro Trabajador</h2>

      <p class="register-subtitle">
        Completa tu perfil profesional para comenzar
      </p>

      <div class="error-message" id="registerError" role="alert" hidden></div>

      <!-- FORM -->
      <form method="post" action="http://127.0.0.1:8000/api/auth/registro" enctype="multipart/form-data" id="registerTrabajadorForm">

        <!-- NOMBRE -->
        <div class="modern-input">
          <i class="bi bi-person"></i>
          <input type="text" name="nombre" placeholder="Nombre completo" required />
        </div>

        <!-- CORREO -->
        <div class="modern-input" style="position:relative;">
          <i class="bi bi-envelope"></i>
          <input type="email" name="correo" id="correoInput" placeholder="Correo electrónico" required autocomplete="email" />
          <span class="email-status" id="emailStatus" style="position:absolute;right:16px;top:50%;transform:translateY(-50%);font-size:18px;"></span>
        </div>
        <div class="email-feedback" id="emailFeedback" style="font-size:12px;font-weight:600;margin:-14px 0 18px 4px;min-height:16px;transition:color .2s;"></div>

        <!-- CONTRASEÑA -->
        <div class="modern-input password-box">
          <i class="bi bi-lock"></i>
          <input type="password" id="password" name="contrasena" placeholder="Contraseña" required />
          <!-- OJITO -->
          <i class="bi bi-eye-slash toggle-password" id="togglePassword"></i>
        </div>

        <!-- INDICADOR DE SEGURIDAD -->
        <div class="ps-panel" id="psPanel">
          <div class="ps-bar-track">
            <div class="ps-bar" id="psBar"></div>
          </div>
          <div class="ps-label" id="psLabel">Muy débil</div>
          <ul class="ps-reqs" id="psReqs">
            <li id="req-len"><span class="ps-icon" id="icon-len"><i class="bi bi-circle"></i></span> 8 caracteres</li>
            <li id="req-may"><span class="ps-icon" id="icon-may"><i class="bi bi-circle"></i></span> Una mayúscula</li>
            <li id="req-min"><span class="ps-icon" id="icon-min"><i class="bi bi-circle"></i></span> Una minúscula</li>
            <li id="req-num"><span class="ps-icon" id="icon-num"><i class="bi bi-circle"></i></span> Un número</li>
            <li id="req-sym"><span class="ps-icon" id="icon-sym"><i class="bi bi-circle"></i></span> Un símbolo especial</li>
          </ul>
        </div>

        <!-- TELEFONO -->
        <div class="modern-input">
          <i class="bi bi-telephone"></i>
          <input type="text" name="telefono" placeholder="Teléfono" required />
        </div>

        <!-- FOTO -->
        <div class="photo-section">
          <span class="photo-label">Foto de perfil</span>

          <!-- TARJETA FOTO -->
          <label for="fotoPerfil" class="photo-card">
            <div class="photo-icon">
              <i class="bi bi-camera-fill"></i>
            </div>

            <div class="photo-info">
              <h4>Añadir foto</h4>
              <p>Selecciona una imagen desde tu galería</p>
            </div>

            <div class="photo-plus">
              <i class="bi bi-plus-lg"></i>
            </div>
          </label>

          <!-- INPUT FILE -->
          <input type="file" id="fotoPerfil" name="foto_Perfil" accept=".jpg,.jpeg,.png" required style="display:none;" />

          <!-- TEXTO -->
          <p id="nombreImagen" class="photo-filename"></p>
        </div>

        <!-- UBICACION -->
        <div class="modern-input">
          <i class="bi bi-geo-alt"></i>
          <input type="text" name="ubicacion" placeholder="Ubicación" required />
        </div>

        <!-- BOTON -->
        <button type="submit" class="btn-register" id="registerBtn" disabled>
          <span class="btn-text">
            <i class="bi bi-person-plus"></i>
            Registrarse
          </span>
          <div class="btn-spinner" style="display:none;width:20px;height:20px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite;"></div>
        </button>

      </form>

      <!-- LOGIN -->
      <div class="login-redirect">
        ¿Ya tienes cuenta?
        <a href="/login/login">Inicia sesión</a>
      </div>

    </div>
  </div>

  <script is:inline>
    (function () {
      const form = document.getElementById("registerTrabajadorForm");
      const password = document.getElementById("password");
      const photo = document.getElementById("fotoPerfil");
      const button = document.getElementById("registerBtn");
      const errorBox = document.getElementById("registerError");
      const errorPrevio = new URLSearchParams(window.location.search).get("error");
      let cuentaRegistrada = false;
      let tokenSesion = null;
      let usuarioSesion = null;
      let enviando = false;

      const mostrarError = (message) => {
        errorBox.textContent = message;
        errorBox.hidden = false;
      };
      const ocultarError = () => { errorBox.hidden = true; errorBox.textContent = ""; };
      if (errorPrevio) mostrarError(errorPrevio);

      const requisitos = [
        { id: "req-len", test: (value) => value.length >= 8 },
        { id: "req-may", test: (value) => /[A-Z]/.test(value) },
        { id: "req-min", test: (value) => /[a-z]/.test(value) },
        { id: "req-num", test: (value) => /\d/.test(value) },
        { id: "req-sym", test: (value) => /[^A-Za-z0-9]/.test(value) },
      ];
      const actualizarBoton = () => {
        button.disabled = enviando || !form.checkValidity();
      };
      const actualizarSeguridad = () => {
        const value = password.value;
        const cumplidos = requisitos.filter((item) => item.test(value)).length;
        document.getElementById("psPanel").classList.toggle("active", value.length > 0);
        document.getElementById("psBar").className = "ps-bar ps-" + cumplidos;
        const etiqueta = document.getElementById("psLabel");
        etiqueta.textContent = ["Muy débil", "Muy débil", "Débil", "Regular", "Fuerte", "Muy fuerte"][cumplidos];
        requisitos.forEach((item) => {
          const fila = document.getElementById(item.id);
          const icono = fila.querySelector(".ps-icon i");
          const logrado = item.test(value);
          fila.classList.toggle("met", logrado);
          if (icono) icono.className = logrado ? "bi bi-check-circle-fill" : "bi bi-circle";
        });
        actualizarBoton();
      };

      form.addEventListener("input", () => { ocultarError(); actualizarBoton(); });
      form.addEventListener("change", () => { ocultarError(); actualizarBoton(); });
      password.addEventListener("input", () => { ocultarError(); actualizarSeguridad(); });
      photo.addEventListener("change", () => {
        const archivo = photo.files && photo.files[0];
        document.getElementById("nombreImagen").textContent = archivo ? archivo.name : "";
        ocultarError();
        actualizarBoton();
      });
      document.getElementById("togglePassword").addEventListener("click", function () {
        const mostrar = password.type === "password";
        password.type = mostrar ? "text" : "password";
        this.classList.toggle("bi-eye", mostrar);
        this.classList.toggle("bi-eye-slash", !mostrar);
      });
      const themeButton = document.getElementById("themeToggle");
      const theme = localStorage.getItem("theme") || "light";
      document.documentElement.setAttribute("data-theme", theme);
      themeButton.addEventListener("click", function () {
        const next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
        this.querySelector(".theme-icon-light").style.display = next === "dark" ? "none" : "";
        this.querySelector(".theme-icon-dark").style.display = next === "dark" ? "" : "none";
      });
      themeButton.querySelector(".theme-icon-light").style.display = theme === "dark" ? "none" : "";
      themeButton.querySelector(".theme-icon-dark").style.display = theme === "dark" ? "" : "none";
      actualizarSeguridad();

      const leerRespuesta = async (response) => response.json().catch(() => ({}));
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (enviando || !form.checkValidity()) { form.reportValidity(); return; }
        enviando = true;
        button.classList.add("loading");
        actualizarBoton();
        ocultarError();
        const formData = new FormData(form);
        const correo = formData.get("correo");
        const contrasena = formData.get("contrasena");
        try {
          if (!cuentaRegistrada) {
            const registroResponse = await fetch("http://127.0.0.1:8000/api/auth/registro", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                idRol: 2,
                nombre: formData.get("nombre"),
                correo,
                contrasena,
                telefono: formData.get("telefono"),
                ubicacion: formData.get("ubicacion"),
              }),
            });
            const registroData = await leerRespuesta(registroResponse);
            if (!registroResponse.ok) throw new Error(registroData.mensaje || registroData.error || "No fue posible crear la cuenta.");
            cuentaRegistrada = true;
          }

          if (!tokenSesion || !usuarioSesion) {
            const loginResponse = await fetch("http://127.0.0.1:8000/api/auth/login", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ correo, contrasena }),
            });
            const loginData = await leerRespuesta(loginResponse);
            if (!loginResponse.ok || !loginData.token || !loginData.usuario?.id) {
              throw new Error(loginData.mensaje || "La cuenta ya se creó, pero no se pudo iniciar sesión. Vuelve a intentar.");
            }
            tokenSesion = loginData.token;
            usuarioSesion = loginData.usuario;
          }

          const fotoFormData = new FormData();
          fotoFormData.append("foto_Perfil", photo.files[0]);
          const fotoResponse = await fetch(`http://127.0.0.1:8000/api/usuarios/${usuarioSesion.id}/foto-perfil`, {
            method: "POST",
            headers: { Authorization: `Bearer ${tokenSesion}` },
            body: fotoFormData,
          });
          const fotoData = await leerRespuesta(fotoResponse);
          if (!fotoResponse.ok) {
            throw new Error(fotoData.mensaje || "La cuenta ya se creó, pero no se pudo guardar la foto. Selecciona la imagen e inténtalo otra vez.");
          }

          localStorage.setItem("token", tokenSesion);
          localStorage.setItem("usuario", JSON.stringify(usuarioSesion));
          window.location.assign("/trabajador");
        } catch (error) {
          mostrarError(error.message || "No se pudo completar el registro. Revisa la conexión con el servidor.");
        } finally {
          enviando = false;
          button.classList.remove("loading");
          actualizarBoton();
        }
      });
    })();
  </script>

  <!-- SCRIPT -->
</Layout>
