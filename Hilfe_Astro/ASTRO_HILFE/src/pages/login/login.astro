---
import Layout from "../../layouts/Layout.astro";
import "../../components/styles/login.css";

// TODO: cuando conectes tu backend, estos vendrán de tu lógica real de auth
// (por ahora se leen como query params, ej: /login?error=Credenciales+inválidas)
const returnUrl = Astro.url.searchParams.get("returnUrl") ?? "";
const correoRecordado = Astro.url.searchParams.get("correoRecordado") ?? "";
const error = Astro.url.searchParams.get("error");
const needsVerification = Astro.url.searchParams.get("needsVerification") === "true";
const correoPendiente = Astro.url.searchParams.get("correoPendiente");
const registroExitoso = Astro.url.searchParams.get("registroExitoso");
const loginExitoso = Astro.url.searchParams.get("loginExitoso");

// NUEVO: si viene ?vista=registroExitoso se muestra la pantalla completa
// de "Registro Exitoso" en vez del formulario de login, dentro de este mismo archivo.
// Ej: /login?vista=registroExitoso
const mostrarRegistroExitoso = Astro.url.searchParams.get("vista") === "registroExitoso";

// Client ID de Google (viene del .env del frontend: PUBLIC_GOOGLE_CLIENT_ID)
const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ?? "";
---

<Layout title="Hilf'e — Iniciar sesión">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/design-system.css" />
    <link rel="stylesheet" href="/css/auth.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  </Fragment>

  {mostrarRegistroExitoso ? (
    <div class="auth-container">
      <div class="auth-card">
        <div class="auth-header">
          <h2>✅ Registro Exitoso</h2>
          <p>Tu cuenta fue creada correctamente</p>
        </div>

        <a href="/login/login" class="btn-auth">
          Ir al Login
        </a>
      </div>
    </div>
  ) : (
    <div class="login-wrap">
      {/* LEFT */}
      <div class="login-left">
        <div class="nebula nebula-1"></div>
        <div class="nebula nebula-2"></div>
        <div class="nebula nebula-3"></div>
        <div class="grid-overlay"></div>

        <div class="particles" id="particles"></div>

        <div class="ambient">
          <div></div><div></div><div></div><div></div><div></div><div></div>
        </div>



        <div class="shooting-star" style="top:15%;left:55%;animation:shoot1 7s 2s infinite;transform:rotate(50deg);"></div>
        <div class="shooting-star" style="top:28%;left:72%;animation:shoot2 9s 6s infinite;transform:rotate(-35deg);"></div>
        <div class="shooting-star" style="top:10%;left:45%;animation:shoot3 8s 11s infinite;transform:rotate(65deg);"></div>
        <div class="shooting-star" style="top:22%;left:78%;animation:shoot4 10s 17s infinite;transform:rotate(-50deg);"></div>

        <div class="login-logo">
          <div class="logo-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <rect x="3" y="3" width="18" height="18" rx="4"/>
              <line x1="12" y1="7" x2="12" y2="17"/>
              <line x1="7" y1="12" x2="17" y2="12"/>
            </svg>
          </div>
          <h2 aria-label="Hilf'e">
            <span class="logo-letter" aria-hidden="true">H</span>
            <span class="logo-letter" aria-hidden="true">i</span>
            <span class="logo-letter" aria-hidden="true">l</span>
            <span class="logo-letter" aria-hidden="true">f</span>
            <span class="logo-letter is-accent" aria-hidden="true">'</span>
            <span class="logo-letter is-accent" aria-hidden="true">e</span>
          </h2>
        </div>

      </div>

      {/* RIGHT - FORM */}
      <div class="login-right">
        <div class="login-card">
          <div class="mini-nav">
            <h2>Hilf<span>'e</span></h2>
            <button type="button" class="theme-toggle" aria-label="Cambiar tema" style="width:38px;height:38px;border-radius:50%;border:1.5px solid var(--border);background:var(--bg-card);cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:var(--transition-fast);">
              <svg class="theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              <svg class="theme-icon-dark" style="display:none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </button>
          </div>

          <div class="form-title">Inicia sesión para continuar</div>

          {error && (
            <div class="msg-toast error">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
              {error}
              {needsVerification && correoPendiente && (
                <div style="margin-top:10px;width:100%">
                  <a href={`/account/verifyotp?correo=${encodeURIComponent(correoPendiente)}`} style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:var(--radius);font-size:14px;font-weight:700;font-family:'Inter',sans-serif;background:#d97706;color:#fff;text-decoration:none;transition:all .2s;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    Verificar ahora
                  </a>
                </div>
              )}
            </div>
          )}

          {registroExitoso && (
            <div class="msg-toast success">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              {registroExitoso}
            </div>
          )}

          {loginExitoso && (
            <div class="msg-toast info">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              {loginExitoso}
            </div>
          )}

          <form method="post" action="/api/account/login" id="loginForm">
            {returnUrl && <input type="hidden" name="returnUrl" value={returnUrl} />}

            <div class="form-group">
              <div class="input-wrap">
                <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <input type="email" name="correo" placeholder="Correo electrónico" value={correoRecordado} required />
              </div>
            </div>

            <div class="form-group">
              <div class="input-wrap">
                <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <input type="password" name="contrasena" id="passwordInput" placeholder="Contraseña" required />
                <button type="button" class="toggle-pw" aria-label="Mostrar contraseña" aria-pressed="false">
                  <i class="bi bi-eye-slash"></i>
                </button>
              </div>
            </div>

            <div class="form-options">
              <label>
                <input type="checkbox" name="recordarme" value="true" checked={!!correoRecordado} />
                Recordarme
              </label>
              <a href="/account/forgotpassword">¿Olvidaste tu contraseña?</a>
            </div>

            <button type="submit" class="btn-login-modern" id="loginBtn">
              <span class="btn-text">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                Ingresar
              </span>
              <div class="spinner"></div>
            </button>

            {/* INICIAR CON GOOGLE */}
            <div class="divider-o"><span>o</span></div>
            <div id="googleBtn" data-client-id={googleClientId} style="display:flex;justify-content:center;min-height:44px;"></div>

            <div class="register-link">
              ¿No tienes cuenta? <a href="/login/registrar">Registrarse</a>
            </div>

            <div class="login-footer">
              <a href="/" id="loginVerSitio">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                Ver sitio
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  )}

  {!mostrarRegistroExitoso && (
    <Fragment>
      <script is:inline>
        const inputContrasena = document.getElementById("passwordInput");
        const botonVerContrasena = document.querySelector(".toggle-pw");
        botonVerContrasena?.addEventListener("click", () => {
          if (!inputContrasena) return;
          const mostrar = inputContrasena.type === "password";
          inputContrasena.type = mostrar ? "text" : "password";
          botonVerContrasena.setAttribute("aria-pressed", String(mostrar));
          botonVerContrasena.setAttribute("aria-label", mostrar ? "Ocultar contraseña" : "Mostrar contraseña");
          const icono = botonVerContrasena.querySelector("i");
          icono?.classList.toggle("bi-eye", mostrar);
          icono?.classList.toggle("bi-eye-slash", !mostrar);
        });

        document.getElementById("loginVerSitio")?.addEventListener("click", () => {
          localStorage.removeItem("token");
          localStorage.removeItem("usuario");
        });

        const loginForm = document.getElementById("loginForm");

        loginForm?.addEventListener("submit", async (event) => {
          event.preventDefault();

          const formData = new FormData(loginForm);
          const errorUrl = (message) => `/login/login?error=${encodeURIComponent(message)}`;

          try {
            const response = await fetch("http://127.0.0.1:8000/api/auth/login", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                correo: formData.get("correo"),
                contrasena: formData.get("contrasena"),
              }),
            });

            const data = await response.json();

            if (!response.ok) {
              window.location.assign(errorUrl(data.mensaje || data.error || "No fue posible iniciar sesión."));
              return;
            }

            localStorage.setItem("token", data.token);
            localStorage.setItem("usuario", JSON.stringify(data.usuario));

            const rolesValidos = [1, 2, 3];
            if (!rolesValidos.includes(Number(data.usuario?.rol))) {
              window.location.assign(errorUrl("El rol de usuario no es válido."));
              return;
            }

            window.location.assign("/");
          } catch {
            window.location.assign(errorUrl("No se pudo conectar con el servidor."));
          }
        });

        // ===== Iniciar con Google =====
        const googleBtn = document.getElementById("googleBtn");
        const destinosGoogle = { 1: "/admin/admin", 2: "/trabajador", 3: "/cliente" };

        async function manejarGoogle(respuesta) {
          const errorGoogle = (m) => `/login/login?error=${encodeURIComponent(m)}`;
          try {
            const response = await fetch("http://127.0.0.1:8000/api/auth/google", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ credential: respuesta.credential }),
            });
            const data = await response.json();

            if (!response.ok) {
              window.location.assign(errorGoogle(data.mensaje || "No se pudo iniciar con Google."));
              return;
            }

            // Cuenta existente: entra directo a su panel
            if (data.existe) {
              localStorage.setItem("token", data.token);
              localStorage.setItem("usuario", JSON.stringify(data.usuario));
              const destino = destinosGoogle[data.usuario?.rol];
              window.location.assign(destino ?? errorGoogle("El rol de usuario no es válido."));
              return;
            }

            // Cuenta nueva: guardar datos temporales y elegir rol
            sessionStorage.setItem("googlePendiente", JSON.stringify({
              registroToken: data.registroToken,
              correo: data.correo,
              nombre: data.nombre,
              creado: Date.now(),
            }));
            window.location.assign("/login/registrar");
          } catch {
            window.location.assign(errorGoogle("No se pudo conectar con el servidor."));
          }
        }

        function mostrarErrorGoogle(mensaje) {
          if (!googleBtn) return;
          googleBtn.innerHTML = "";
          const aviso = document.createElement("p");
          aviso.textContent = mensaje;
          aviso.style.cssText = "font-size:12px;line-height:1.4;color:#b45309;text-align:center;margin:0;";
          googleBtn.appendChild(aviso);
        }

        function iniciarGoogle() {
          if (!googleBtn) return true;

          const clientId = (googleBtn.dataset.clientId || "").trim();
          if (!clientId) {
            mostrarErrorGoogle("Google no está configurado: falta PUBLIC_GOOGLE_CLIENT_ID en el .env de Astro (reinicia astro dev).");
            return true;
          }

          if (!window.google?.accounts?.id) return false; // la librería aún no cargó

          try {
            google.accounts.id.initialize({ client_id: clientId, callback: manejarGoogle });
            google.accounts.id.renderButton(googleBtn, {
              theme: "outline",
              size: "large",
              shape: "pill",
              text: "continue_with",
              width: 320,
              locale: "es",
            });
          } catch (e) {
            mostrarErrorGoogle("Error al iniciar Google: " + e.message);
          }
          return true;
        }

        // Reintenta cada 200 ms hasta que la librería de Google esté lista (máx. ~10 s)
        let intentosGoogle = 0;
        const temporizadorGoogle = setInterval(() => {
          intentosGoogle++;
          if (iniciarGoogle()) {
            clearInterval(temporizadorGoogle);
          } else if (intentosGoogle >= 50) {
            clearInterval(temporizadorGoogle);
            mostrarErrorGoogle("No se pudo cargar Google. Desactiva el bloqueador de anuncios o revisa tu internet.");
          }
        }, 200);
      </script>
      <script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
      <script is:inline src="/js/pages/login.js"></script>
      <script is:inline src="/js/site.js"></script>
    </Fragment>
  )}
</Layout>