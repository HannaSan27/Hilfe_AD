---
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/adminsidebar.astro';
import AdminTopbar from '../../components/admintopbar.astro';
import '../../components/styles/admincitas.css';

interface Solicitud {
  Id_Solicitud: number;
  Cliente: string;
  Trabajador: string;
  Servicio: string;
  Fecha_Servicio: string; // YYYY-MM-DD
  Hora_Servicio: string;
  Estado: 'pendiente' | 'confirmada' | 'finalizada' | 'cancelada' | string;
}

// Antes: @model List<Hilfe.Models.Solicitud>. Reemplaza por tu backend.
const citas: Solicitud[] = [
  { Id_Solicitud: 1, Cliente: 'Laura Gómez', Trabajador: 'Carlos Ruiz', Servicio: 'Plomería', Fecha_Servicio: '2026-09-22', Hora_Servicio: '09:00', Estado: 'confirmada' },
  { Id_Solicitud: 2, Cliente: 'Andrés Peña', Trabajador: 'María Torres', Servicio: 'Electricidad', Fecha_Servicio: '2026-09-21', Hora_Servicio: '14:30', Estado: 'pendiente' },
  { Id_Solicitud: 3, Cliente: 'Sofía Rojas', Trabajador: 'Juan Díaz', Servicio: 'Pintura', Fecha_Servicio: '2026-09-19', Hora_Servicio: '10:15', Estado: 'finalizada' },
  { Id_Solicitud: 4, Cliente: 'Camilo Ortiz', Trabajador: 'Pedro León', Servicio: 'Carpintería', Fecha_Servicio: '2026-09-18', Hora_Servicio: '16:00', Estado: 'cancelada' },
];

const badgeClass = (estado: string) =>
  ({
    confirmada: 'badge-success',
    pendiente: 'badge-warning',
    finalizada: 'badge-info',
    cancelada: 'badge-danger',
  })[estado] ?? 'badge-neutral';

// dd/MM/yyyy
const formatFecha = (iso: string) => iso.split('-').reverse().join('/');

const calendar = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg>`;
---

<Layout title="Citas">
  <div class="admin-shell">
    <AdminSidebar active="citas" />

    <div class="admin-main">
      <AdminTopbar title="Citas" subtitle="Control de todas las citas agendadas" />

      <div class="admin-content">
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>
              <Fragment set:html={calendar} />
              Todas las citas
            </h3>
            <select class="form-select" id="filtroEstado" onchange="filtrarCitas(this.value)">
              <option value="">Todos los estados</option>
              <option value="pendiente">Pendiente</option>
              <option value="confirmada">Confirmada</option>
              <option value="finalizada">Finalizada</option>
              <option value="cancelada">Cancelada</option>
            </select>
          </div>

          <div class="table-wrap" style="border-radius:0;border-left:none;border-right:none;border-bottom:none">
            <table class="table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Cliente</th>
                  <th>Trabajador</th>
                  <th>Servicio</th>
                  <th>Fecha</th>
                  <th>Hora</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody id="citasBody">
                {citas.map((s) => (
                  <tr data-estado={s.Estado}>
                    <td class="text-muted">#{s.Id_Solicitud}</td>
                    <td><strong style="color:var(--text)">{s.Cliente}</strong></td>
                    <td>{s.Trabajador}</td>
                    <td>{s.Servicio}</td>
                    <td>{formatFecha(s.Fecha_Servicio)}</td>
                    <td>{s.Hora_Servicio}</td>
                    <td><span class={`badge ${badgeClass(s.Estado)}`}>{s.Estado}</span></td>
                  </tr>
                ))}
                <tr id="citasVacio" hidden={citas.length > 0}>
                  <td colspan="7" class="text-center text-muted" style="padding:2rem">
                    No hay citas registradas aún.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="table-footer">
            <span>Total: <span id="citasTotal">{citas.length}</span> citas</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var select = document.getElementById('filtroEstado');
      var filas = document.querySelectorAll('#citasBody tr[data-estado]');
      var vacio = document.getElementById('citasVacio');
      var total = document.getElementById('citasTotal');

      // Antes el filtro recargaba /Admin/Citas?estado=...; ahora filtra en la misma página.
      window.filtrarCitas = function (estado) {
        var visibles = 0;
        filas.forEach(function (tr) {
          var ok = !estado || tr.dataset.estado === estado;
          tr.hidden = !ok;
          if (ok) visibles++;
        });
        vacio.hidden = visibles > 0;
        total.textContent = visibles;
      };

      // Respeta enlaces antiguos tipo /admin/citas?estado=pendiente
      var inicial = new URLSearchParams(location.search).get('estado');
      if (inicial) { select.value = inicial; window.filtrarCitas(select.value); }
    })();
  </script>
</Layout>