---
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/adminsidebar.astro';
import AdminTopbar from '../../components/admintopbar.astro';
import '../../components/styles/admincitas.css';
---

<Layout title="Citas">
  <div class="admin-shell">
    <AdminSidebar active="citas" />
    <div class="admin-main">
      <AdminTopbar title="Citas" subtitle="Control de todas las citas agendadas" />
      <div class="admin-content">
        <div class="admin-card">
          <div class="admin-card-header">
            <h3><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg> Todas las citas</h3>
            <select class="form-select" id="filtroEstado" onchange="filtrarCitas(this.value)">
              <option value="">Todos los estados</option>
              <option value="pendiente">Pendiente</option>
              <option value="aceptado">Aceptada</option>
              <option value="en_proceso">En proceso</option>
              <option value="rumbo_a_ubicacion">En camino</option>
              <option value="trabajo_realizado">Trabajo realizado</option>
              <option value="finalizado">Finalizada</option>
              <option value="rechazado">Rechazada</option>
              <option value="cancelada">Cancelada</option>
            </select>
          </div>
          <div class="table-wrap" style="border-radius:0;border-left:none;border-right:none;border-bottom:none">
            <table class="table">
              <thead><tr><th>ID</th><th>Cliente</th><th>Trabajador</th><th>Servicio</th><th>Fecha</th><th>Hora</th><th>Estado</th></tr></thead>
              <tbody id="citasBody"><tr id="citasVacio"><td colspan="7" class="text-center text-muted" style="padding:2rem">Cargando solicitudes...</td></tr></tbody>
            </table>
          </div>
          <div class="table-footer"><span>Total: <span id="citasTotal">0</span> citas</span></div>
        </div>
      </div>
    </div>
  </div>
  <script is:inline>
    (function () {
      var select = document.getElementById('filtroEstado');
      var body = document.getElementById('citasBody');
      var vacio = document.getElementById('citasVacio');
      var total = document.getElementById('citasTotal');
      var estados = { pendiente: 'Pendiente', aceptado: 'Aceptada', en_proceso: 'En proceso', rumbo_a_ubicacion: 'En camino', trabajo_realizado: 'Trabajo realizado', finalizado: 'Finalizada', rechazado: 'Rechazada', cancelada: 'Cancelada' };
      var colores = { pendiente: 'badge-warning', aceptado: 'badge-success', en_proceso: 'badge-success', rumbo_a_ubicacion: 'badge-info', trabajo_realizado: 'badge-info', finalizado: 'badge-info', rechazado: 'badge-danger', cancelada: 'badge-danger' };
      var totalCitas = 0;
      var errorCarga = false;
      function agregarCelda(fila, texto, clase) {
        var celda = document.createElement('td');
        if (clase) celda.className = clase;
        celda.textContent = texto || '—';
        fila.appendChild(celda);
        return celda;
      }
      window.filtrarCitas = function (estado) {
        if (errorCarga) return;
        var filas = body.querySelectorAll('tr[data-estado]');
        var visibles = 0;
        filas.forEach(function (fila) {
          var mostrar = !estado || fila.dataset.estado === estado;
          fila.hidden = !mostrar;
          if (mostrar) visibles++;
        });
        vacio.hidden = visibles > 0;
        vacio.querySelector('td').textContent = totalCitas && !visibles ? 'No hay solicitudes que coincidan con ese estado.' : 'No hay solicitudes registradas aún.';
        total.textContent = String(visibles);
      };
      async function cargarCitas() {
        try {
          var respuesta = await fetch('http://127.0.0.1:8000/api/solicitudes');
          var data = await respuesta.json().catch(function () { return {}; });
          if (!respuesta.ok) throw new Error(data.mensaje || 'No se pudieron cargar las solicitudes.');
          var citas = Array.isArray(data) ? data : (Array.isArray(data.value) ? data.value : []);
          totalCitas = citas.length;
          body.replaceChildren(vacio);
          citas.forEach(function (cita) {
            var fila = document.createElement('tr');
            var estado = String(cita.Estado_Solicitudes || 'pendiente').toLowerCase();
            fila.dataset.estado = estado;
            agregarCelda(fila, '#' + cita.Id_Solicitud, 'text-muted');
            var celdaCliente = agregarCelda(fila, '');
            var nombreCliente = document.createElement('strong');
            nombreCliente.style.color = 'var(--text)';
            nombreCliente.textContent = cita.Nombre_Cliente || '—';
            celdaCliente.appendChild(nombreCliente);
            agregarCelda(fila, cita.Nombre_Trabajador);
            agregarCelda(fila, cita.Titulo_Servicio);
            var fecha = String(cita.Fecha_Servicio || '');
            agregarCelda(fila, /^\d{4}-\d{2}-\d{2}/.test(fecha) ? fecha.slice(0, 10).split('-').reverse().join('/') : fecha);
            agregarCelda(fila, String(cita.Hora_Servicio || '').slice(0, 5));
            var estadoCelda = agregarCelda(fila, '');
            var badge = document.createElement('span');
            badge.className = 'badge ' + (colores[estado] || 'badge-neutral');
            badge.textContent = estados[estado] || estado;
            estadoCelda.appendChild(badge);
            body.insertBefore(fila, vacio);
          });
          window.filtrarCitas(select.value);
        } catch (error) {
          errorCarga = true;
          body.replaceChildren(vacio);
          vacio.hidden = false;
          vacio.querySelector('td').textContent = error instanceof Error ? error.message : 'No se pudieron cargar las solicitudes.';
          total.textContent = '0';
        }
      }
      var inicial = new URLSearchParams(location.search).get('estado');
      if (inicial) select.value = inicial;
      cargarCitas();
    })();
  </script>
</Layout>
