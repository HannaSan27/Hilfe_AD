---
import Layout from '../../layouts/Layout.astro';
import '../../components/styles/admintrabajador.css';

// Antes: @model List<TrabajadorAdminVm>. Reemplaza por tu backend.
interface TrabajadorAdminVm {
  Usuario: { Id_Usuario: number; Nombre: string; Ubicacion: string };
  Servicio: string;
  Categoria: string;
  Calificacion: number;
  TotalReseñas: number;
  Verificado: boolean;
}

const trabajadores: TrabajadorAdminVm[] = [
  { Usuario: { Id_Usuario: 1, Nombre: 'Carlos Ruiz', Ubicacion: 'Bogotá' }, Servicio: 'Plomería residencial', Categoria: 'Hogar y arreglos', Calificacion: 4.8, TotalReseñas: 32, Verificado: true },
  { Usuario: { Id_Usuario: 2, Nombre: 'María Torres', Ubicacion: 'Medellín' }, Servicio: 'Instalaciones eléctricas', Categoria: 'Hogar y arreglos', Calificacion: 4.5, TotalReseñas: 18, Verificado: false },
  { Usuario: { Id_Usuario: 3, Nombre: 'Juan Díaz', Ubicacion: 'Cali' }, Servicio: 'Pintura de interiores', Categoria: 'Pintura', Calificacion: 4.9, TotalReseñas: 41, Verificado: true },
  { Usuario: { Id_Usuario: 4, Nombre: 'Pedro León', Ubicacion: 'Bogotá' }, Servicio: 'Muebles a medida', Categoria: 'Carpintería', Calificacion: 4.2, TotalReseñas: 9, Verificado: false },
];

const svg = (paths: string, size: number, style = '') =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"${style ? ` style="${style}"` : ''}>${paths}</svg>`;

const shield = '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>';
const shieldOk = shield + '<path d="m9 12 2 2 4-4"/>';
const shieldOff = shield + '<path d="M8 12h.01"/><path d="M12 12h.01"/><path d="M16 12h.01"/>';
const shieldX = shield + '<path d="m9.5 9.5 5 5"/><path d="m14.5 9.5-5 5"/>';
const hardHat = '<path d="M2 18a1 1 0 0 1 1-1h18a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-2Z"/><path d="M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5"/><path d="M4 15v-3a6 6 0 0 1 6-6h0"/><path d="M14 6a6 6 0 0 1 6 6v3"/>';
const star = '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>';
const search = '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>';
const trash = '<path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/>';

// Iconos que el script necesita para cambiar entre "verificado" y "sin verificar"
const icons = {
  badgeOk: svg(shieldOk, 12),
  badgeOff: svg(shieldOff, 12),
  btnVerificar: svg(shieldOk, 15, 'color:var(--success)'),
  btnQuitar: svg(shieldX, 15, 'color:var(--warning)'),
};
---

<Layout title="Trabajadores">
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <div class="admin-sidebar-logo" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <span class="logo" style="font-size:20px;font-weight:800">Hilf<span class="logo-accent" style="color:var(--primary)">'e</span></span>
        <small style="width:100%">"Conectamos soluciones contigo."</small>
      </div>
      <span class="admin-nav-label">General</span>
      <a href="/admin/admin" class="admin-nav-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Dashboard
      </a>
      <a href="/admin/usuario" class="admin-nav-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Usuarios
      </a>
      <a href="/admin/trabajadores" class="admin-nav-item active">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18a1 1 0 0 1 1-1h18a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-2Z"/><path d="M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5"/><path d="M4 15v-3a6 6 0 0 1 6-6h0"/><path d="M14 6a6 6 0 0 1 6 6v3"/></svg>
        Trabajadores
      </a>
      <span class="admin-nav-label">Plataforma</span>
      <a href="/admin/citas" class="admin-nav-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg>
        Citas
      </a>
      <a href="/admin/categoria" class="admin-nav-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><path d="M7 7h.01"/></svg>
        Categorías
      </a>
      <span class="admin-nav-label">Cuenta</span>
      <a href="/" class="admin-nav-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Ver sitio
      </a>
      <a href="/login" class="admin-nav-item" style="color:var(--danger)">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Cerrar sesión
      </a>
    </aside>

    <div class="admin-main">
      <div class="admin-topbar">
        <div>
          <h1>Trabajadores</h1>
          <p>Administra y verifica los trabajadores de la plataforma</p>
        </div>
        <div class="admin-topbar-right">
          <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme" style="width:36px;height:36px;border-radius:50%;border:1.5px solid var(--border);background:var(--bg-card);cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg class="theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg class="theme-icon-dark" style="display:none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
          <!-- Antes: <partial name="_YoMenu" /> -->
          <div class="admin-avatar">A</div>
        </div>
      </div>

      <div class="admin-content">
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>
              <Fragment set:html={svg(hardHat, 18)} />
              Trabajadores registrados
            </h3>
            <div class="search-wrap admin-search-input">
              <Fragment set:html={svg(search, 16)} />
              <input type="text" id="buscarInput" placeholder="Buscar trabajador..." class="search-input" onkeyup="buscarTrabajador(this.value)" />
            </div>
          </div>

          <div class="table-wrap" style="border-radius:0;border-left:none;border-right:none;border-bottom:none">
            <table class="table">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Servicio</th>
                  <th>Categoría</th>
                  <th>Ciudad</th>
                  <th>Calificación</th>
                  <th>Verificado</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody id="trabBody">
                {trabajadores.map((t) => (
                  <tr id={`fila-${t.Usuario.Id_Usuario}`}>
                    <td><strong style="color:var(--text)">{t.Usuario.Nombre}</strong></td>
                    <td>{t.Servicio}</td>
                    <td>{t.Categoria}</td>
                    <td>{t.Usuario.Ubicacion}</td>
                    <td>
                      <Fragment set:html={svg(star, 13, 'color:var(--star);vertical-align:middle')} />
                      {t.Calificacion}
                      <span class="text-muted">({t.TotalReseñas})</span>
                    </td>
                    <td>
                      {t.Verificado ? (
                        <span class="badge badge-success" id={`vbadge-${t.Usuario.Id_Usuario}`}>
                          <Fragment set:html={icons.badgeOk} />
                          Verificado
                        </span>
                      ) : (
                        <span class="badge badge-danger" id={`vbadge-${t.Usuario.Id_Usuario}`}>
                          <Fragment set:html={icons.badgeOff} />
                          Sin verificar
                        </span>
                      )}
                    </td>
                    <td id={`vactions-${t.Usuario.Id_Usuario}`}>
                      {t.Verificado ? (
                        <button class="btn-tbl js-verif" title="Quitar verificación" onclick={`quitarVerificarTrabajador(${t.Usuario.Id_Usuario})`}>
                          <Fragment set:html={icons.btnQuitar} />
                        </button>
                      ) : (
                        <button class="btn-tbl js-verif" title="Verificar" onclick={`verificarTrabajador(${t.Usuario.Id_Usuario})`}>
                          <Fragment set:html={icons.btnVerificar} />
                        </button>
                      )}
                      <button class="btn-tbl" title="Eliminar" onclick={`eliminarTrabajador(${t.Usuario.Id_Usuario})`} style="color:var(--danger)">
                        <Fragment set:html={svg(trash, 15)} />
                      </button>
                    </td>
                  </tr>
                ))}
                <tr id="trabVacio" hidden={trabajadores.length > 0}>
                  <td colspan="7" class="text-center text-muted" style="padding:2rem">
                    No hay trabajadores registrados aún.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="table-footer">
            <span>Total: <span id="trabTotal">{trabajadores.length}</span> trabajadores</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Reemplaza a ~/js/Admin.js (mismos nombres de función que usaba el HTML) -->
  <script is:inline define:vars={{ icons }}>
    (function () {
      var body = document.getElementById('trabBody');
      var vacio = document.getElementById('trabVacio');
      var total = document.getElementById('trabTotal');
      var input = document.getElementById('buscarInput');

      function normalizar(s) {
        return String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      }

      // Muestra solo las filas que coinciden con el texto y actualiza el total.
      function filtrar(texto) {
        var q = normalizar(texto).trim();
        var visibles = 0;
        body.querySelectorAll('tr[id^="fila-"]').forEach(function (tr) {
          var ok = !q || normalizar(tr.textContent).indexOf(q) !== -1;
          tr.hidden = !ok;
          if (ok) visibles++;
        });
        vacio.hidden = visibles > 0;
        total.textContent = visibles;
      }

      window.buscarTrabajador = filtrar;

      // Respeta enlaces antiguos tipo /admin/trabajadores?buscar=carlos
      var inicial = new URLSearchParams(location.search).get('buscar');
      if (inicial) { input.value = inicial; filtrar(inicial); }

      function pintarVerificacion(id, verificado) {
        var badge = document.getElementById('vbadge-' + id);
        badge.className = 'badge ' + (verificado ? 'badge-success' : 'badge-danger');
        badge.innerHTML = (verificado ? icons.badgeOk + ' Verificado' : icons.badgeOff + ' Sin verificar');

        var btn = document.querySelector('#vactions-' + id + ' .js-verif');
        btn.title = verificado ? 'Quitar verificación' : 'Verificar';
        btn.setAttribute('onclick', (verificado ? 'quitarVerificarTrabajador(' : 'verificarTrabajador(') + id + ')');
        btn.innerHTML = verificado ? icons.btnQuitar : icons.btnVerificar;
      }

      // TODO backend: en las 3 funciones siguientes haz el fetch antes de tocar el DOM.
      window.verificarTrabajador = function (id) { pintarVerificacion(id, true); };
      window.quitarVerificarTrabajador = function (id) { pintarVerificacion(id, false); };

      window.eliminarTrabajador = function (id) {
        if (!confirm('¿Eliminar este trabajador?')) return;
        document.getElementById('fila-' + id).remove();
        filtrar(input.value);
      };

      // Tema claro / oscuro (quita este bloque si tu Layout.astro ya lo maneja)
      var root = document.documentElement;
      var btn = document.getElementById('themeToggle');
      var light = btn.querySelector('.theme-icon-light');
      var dark = btn.querySelector('.theme-icon-dark');
      function aplicar(t) {
        root.setAttribute('data-theme', t);
        light.style.display = t === 'dark' ? 'none' : '';
        dark.style.display = t === 'dark' ? '' : 'none';
      }
      var guardado = null;
      try { guardado = localStorage.getItem('theme'); } catch (e) {}
      aplicar(guardado || 'light');
      btn.addEventListener('click', function () {
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        aplicar(next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    })();
  </script>
</Layout>