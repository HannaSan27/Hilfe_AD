---
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/adminsidebar.astro';
import AdminTopbar from '../../components/admintopbar.astro';
import '../../components/styles/admintrabajador.css';

const svg = (paths: string, size: number, style = '') =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"${style ? ` style="${style}"` : ''}>${paths}</svg>`;

const shield = '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>';
const shieldOk = shield + '<path d="m9 12 2 2 4-4"/>';
const shieldOff = shield + '<path d="M8 12h.01"/><path d="M12 12h.01"/><path d="M16 12h.01"/>';
const shieldX = shield + '<path d="m9.5 9.5 5 5"/><path d="m14.5 9.5-5 5"/>';
const hardHat = '<path d="M2 18a1 1 0 0 1 1-1h18a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-2Z"/><path d="M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5"/><path d="M4 15v-3a6 6 0 0 1 6-6h0"/><path d="M14 6a6 6 0 0 1 6 6v3"/>';
const star = '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>';
const search = '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>';
const icons = {
  badgeOk: svg(shieldOk, 12),
  badgeOff: svg(shieldOff, 12),
  star: svg(star, 13, 'color:var(--star);vertical-align:middle'),
  btnVerificar: svg(shieldOk, 15, 'color:var(--success)'),
  btnQuitar: svg(shieldX, 15, 'color:var(--warning)'),
};
---

<Layout title="Trabajadores">
  <div class="admin-shell">
    <AdminSidebar active="trabajadores" />

    <div class="admin-main">
      <AdminTopbar title="Trabajadores" subtitle="Administra y verifica los trabajadores de la plataforma" />

      <div class="admin-content">
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>
              <Fragment set:html={svg(hardHat, 18)} />
              Trabajadores registrados
            </h3>
            <div class="search-wrap admin-search-input">
              <Fragment set:html={svg(search, 16)} />
              <input type="text" id="buscarInput" placeholder="Buscar trabajador..." class="search-input" onkeyup="buscarTrabajador(this.value)" />
            </div>
          </div>

          <div class="table-wrap" style="border-radius:0;border-left:none;border-right:none;border-bottom:none">
            <table class="table">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Servicio</th>
                  <th>Categoría</th>
                  <th>Ciudad</th>
                  <th>Calificación</th>
                  <th>Verificado</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody id="trabBody">
                <tr id="trabEstado"><td colspan="7" class="text-center text-muted" style="padding:2rem">Cargando trabajadores...</td></tr>
              </tbody>
            </table>
          </div>

          <div class="table-footer">
            <span>Total: <span id="trabTotal">0</span> trabajadores</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ icons }}>
    (function () {
      var body = document.getElementById('trabBody');
      var total = document.getElementById('trabTotal');
      var input = document.getElementById('buscarInput');
      var api = 'http://127.0.0.1:8000/api';
      var trabajadores = [];

      function normalizar(s) {
        return String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      }

      // Muestra solo las filas que coinciden con el texto y actualiza el total.
      function filtrar(texto) {
        var q = normalizar(texto).trim();
        var visibles = 0;
        body.querySelectorAll('tr[id^="fila-"]').forEach(function (tr) {
          var ok = !q || normalizar(tr.textContent).indexOf(q) !== -1;
          tr.hidden = !ok;
          if (ok) visibles++;
        });
        total.textContent = visibles;
      }

      window.buscarTrabajador = filtrar;

      // Respeta enlaces antiguos tipo /admin/trabajadores?buscar=carlos
      var inicial = new URLSearchParams(location.search).get('buscar');
      if (inicial) { input.value = inicial; filtrar(inicial); }

      function listaDe(data) {
        if (Array.isArray(data)) return data;
        return data && Array.isArray(data.value) ? data.value : [];
      }
      function estaVerificado(valor) { return valor === true || Number(valor) === 1; }
      function celda(row, value) {
        var td = document.createElement('td');
        td.textContent = value == null || value === '' ? '—' : String(value);
        row.appendChild(td);
        return td;
      }
      function pintarVerificacion(worker) {
        var badge = document.getElementById('vbadge-' + worker.Id_Usuario);
        var btn = document.getElementById('vbtn-' + worker.Id_Usuario);
        var verificado = estaVerificado(worker.Verificado);
        badge.className = 'badge ' + (verificado ? 'badge-success' : 'badge-danger');
        badge.innerHTML = (verificado ? icons.badgeOk + ' Verificado' : icons.badgeOff + ' Sin verificar');
        btn.title = verificado ? 'Quitar verificación' : 'Verificar';
        btn.setAttribute('aria-label', btn.title + ' a ' + (worker.Nombre || 'trabajador'));
        btn.innerHTML = verificado ? icons.btnQuitar : icons.btnVerificar;
      }
      async function cambiarVerificacion(worker) {
        var btn = document.getElementById('vbtn-' + worker.Id_Usuario);
        var token = localStorage.getItem('token');
        var usuario;
        try { usuario = JSON.parse(localStorage.getItem('usuario') || 'null'); } catch { usuario = null; }
        if (!token || Number(usuario?.rol) !== 1) { alert('Inicia sesión como administrador para cambiar la verificación.'); return; }
        btn.disabled = true;
        try {
          var response = await fetch(api + '/trabajadores/' + encodeURIComponent(worker.Id_Usuario) + '/verificacion', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ verificado: !estaVerificado(worker.Verificado) })
          });
          var result = await response.json().catch(function () { return {}; });
          if (!response.ok) throw new Error(result.mensaje || 'No fue posible guardar la verificación.');
          worker.Verificado = result.Verificado;
          pintarVerificacion(worker);
        } catch (error) {
          alert(error instanceof Error ? error.message : 'No fue posible guardar la verificación.');
        } finally { btn.disabled = false; }
      }
      function crearFila(worker, services) {
        var row = document.createElement('tr');
        row.id = 'fila-' + worker.Id_Usuario;
        var ownServices = services.filter(function (service) { return Number(service.Id_Trabajador) === Number(worker.Id_Usuario); });
        var mainService = ownServices[0] || {};
        var totalReviews = ownServices.reduce(function (sum, service) { return sum + (Number(service.Total_Resenas) || 0); }, 0);
        var average = totalReviews ? ownServices.reduce(function (sum, service) {
          return sum + (Number(service.Calificacion_Promedio) || 0) * (Number(service.Total_Resenas) || 0);
        }, 0) / totalReviews : 0;
        var nameCell = celda(row, worker.Nombre);
        var name = document.createElement('strong'); name.style.color = 'var(--text)'; name.textContent = worker.Nombre || 'Trabajador';
        nameCell.replaceChildren(name);
        celda(row, mainService.Titulo || 'Sin servicio');
        celda(row, mainService.Nombre_Categoria || '—');
        celda(row, worker.Ubicacion || '—');
        var ratingCell = document.createElement('td');
        ratingCell.innerHTML = icons.star + ' ' + average.toFixed(1) + ' <span class="text-muted">(' + totalReviews + ')</span>';
        row.appendChild(ratingCell);
        var badgeCell = document.createElement('td');
        var badge = document.createElement('span'); badge.id = 'vbadge-' + worker.Id_Usuario;
        badgeCell.appendChild(badge); row.appendChild(badgeCell);
        var actionCell = document.createElement('td');
        var button = document.createElement('button'); button.type = 'button'; button.className = 'btn-tbl js-verif'; button.id = 'vbtn-' + worker.Id_Usuario;
        button.addEventListener('click', function () { cambiarVerificacion(worker); });
        actionCell.appendChild(button); row.appendChild(actionCell);
        body.appendChild(row);
        pintarVerificacion(worker);
      }
      async function cargarTrabajadores() {
        try {
          var workersResponse = await fetch(api + '/trabajadores');
          var workersData = await workersResponse.json().catch(function () { return {}; });
          if (!workersResponse.ok) throw new Error(workersData.mensaje || 'No fue posible cargar los trabajadores.');
          var services = [];
          try {
            var servicesResponse = await fetch(api + '/servicios');
            if (servicesResponse.ok) services = listaDe(await servicesResponse.json());
          } catch { /* Los datos básicos y la verificación siguen disponibles. */ }
          trabajadores = listaDe(workersData);
          body.replaceChildren();
          if (!trabajadores.length) {
            var empty = document.createElement('tr');
            empty.innerHTML = '<td colspan="7" class="text-center text-muted" style="padding:2rem">No hay trabajadores registrados aún.</td>';
            body.appendChild(empty);
          } else trabajadores.forEach(function (worker) { crearFila(worker, services); });
          filtrar(input.value);
        } catch (error) {
          var row = document.createElement('tr');
          var cell = document.createElement('td'); cell.colSpan = 7; cell.className = 'text-center text-muted'; cell.style.padding = '2rem';
          cell.textContent = error instanceof Error ? error.message : 'No fue posible cargar los trabajadores.';
          row.appendChild(cell); body.replaceChildren(row); total.textContent = '0';
        }
      };
      cargarTrabajadores();
    })();
  </script>
</Layout>
