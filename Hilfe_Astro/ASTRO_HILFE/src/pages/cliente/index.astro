---
import Layout from "../../layouts/Layout.astro";
import ClienteSidebar from "../../components/clientesidebar.astro";
import ClienteTopbar from "../../components/clientetopbar.astro";
import "../../components/styles/indexcliente.css";
import "../../components/styles/panelcliente.css";
import "../../components/styles/calificarcliente.css";

interface Calificacion {
  puntaje: number;
}

interface Solicitud {
  idSolicitud: string | number;
  servicioTitulo: string | null;
  trabajadorNombre: string | null;
  fechaServicio: string | Date;
  horaServicio: string;
  estado: "pendiente" | "confirmada" | "finalizado" | "cancelada" | string;
  calificacion: Calificacion | null;
}

// TODO: reemplaza por tu lógica real (sesión/BD/API) cuando conectes tu backend
const nombre = "Cliente";
const solicitudes: Solicitud[] = [];

function formatearFecha(fecha: string | Date) {
  const d = typeof fecha === "string" ? new Date(fecha) : fecha;
  const dd = String(d.getDate()).padStart(2, "0");
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  const yyyy = d.getFullYear();
  return `${dd}/${mm}/${yyyy}`;
}

function badgeClase(estado: string) {
  switch (estado) {
    case "pendiente": return "badge-warning";
    case "confirmada": return "badge-primary";
    case "finalizado": return "badge-success";
    case "cancelada": return "badge-danger";
    default: return "badge-neutral";
  }
}

const pendientes = solicitudes.filter((s) => s.estado === "pendiente").length;
const aceptadas = solicitudes.filter((s) => s.estado === "confirmada").length;
const finalizadas = solicitudes.filter((s) => s.estado === "finalizado").length;
const total = solicitudes.length;
const porCalificar = solicitudes.filter((s) => s.estado === "finalizado" && s.calificacion == null).length;
---

<Layout>
  <div class="trabajador-shell cliente-shell cliente-dashboard-shell">
    <ClienteSidebar active="solicitudes" />
    <main class="trabajador-main cliente-main cliente-dashboard-main">
      <ClienteTopbar title="Mis solicitudes" subtitle="Consulta el estado y el historial de tus servicios." />
      <section class="cliente-dashboard-intro">
        <div class="cliente-dashboard-greeting">
          <span class="cliente-eyebrow">TU ACTIVIDAD</span>
          <p>Bienvenido, <a id="nombreBienvenidaCliente" href="/cliente/editarperfil">{nombre}</a></p>
        </div>
        <div class="cliente-dashboard-actions">
          <span id="calificacionesPendientes" class="btn btn-secondary btn-sm" role="status" hidden={porCalificar === 0} style="position:relative;padding:8px 14px;cursor:default;pointer-events:none">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            Calificar
            <span id="contadorCalificaciones" style="position:absolute;top:-6px;right:-6px;background:var(--danger);color:#fff;font-size:11px;font-weight:700;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center">{porCalificar}</span>
          </span>
          <a href="/categorias/" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nuevo servicio
          </a>
        </div>
      </section>

      <!-- Stats Grid -->
      <div class="stats-grid stagger">
        <div class="stat-card">
          <div class="stat-card-icon warning">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="stat-card-body">
          <div class="stat-card-value" id="statPendientes">{pendientes}</div>
            <div class="stat-card-label">Pendientes</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-card-icon primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div class="stat-card-body">
          <div class="stat-card-value" id="statAceptadas">{aceptadas}</div>
            <div class="stat-card-label">Aceptadas</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-card-icon success">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </div>
          <div class="stat-card-body">
          <div class="stat-card-value" id="statFinalizadas">{finalizadas}</div>
            <div class="stat-card-label">Finalizadas</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-card-icon primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          <div class="stat-card-body">
          <div class="stat-card-value" id="statTotal">{total}</div>
            <div class="stat-card-label">Total</div>
          </div>
        </div>
      </div>

      <!-- Solicitudes List -->
      <div class="card cliente-history-card">
        <div class="card-header">
          <div class="cliente-history-heading">
            <span class="cliente-history-icon"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M8 13h8M8 17h6"/></svg></span>
            <span><strong>Historial de solicitudes</strong><small>Revisa el progreso de tus servicios</small></span>
          </div>
          <span class="cliente-history-caption">ACTIVIDAD RECIENTE</span>
        </div>

        {solicitudes.length > 0 ? (
          <div class="table-wrap" id="solicitudesTable" style="border:none;border-radius:0">
            <table class="table">
              <thead>
                <tr>
                  <th>Servicio</th>
                  <th>Trabajador</th>
                  <th>Fecha</th>
                  <th>Hora</th>
                  <th>Estado</th>
                  <th style="text-align:center">Acción</th>
                </tr>
              </thead>
              <tbody id="solicitudesBody">
                {solicitudes.map((s) => {
                  const necesitaCalificar = s.estado === "finalizado" && s.calificacion == null;
                  return (
                    <tr>
                      <td><span class="cliente-request-service"><span class="cliente-request-service-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m14.7 6.3 3 3M4 20l4.2-1 10.5-10.5a2.1 2.1 0 0 0-3-3L5.2 16 4 20Z"/><path d="m13 8 3 3"/></svg></span><strong>{s.servicioTitulo}</strong></span></td>
                      <td><span class="cliente-worker-name">{s.trabajadorNombre}</span></td>
                      <td>{formatearFecha(s.fechaServicio)}</td>
                      <td>{s.horaServicio}</td>
                      <td><span class={`badge ${badgeClase(s.estado)}`}>{s.estado}</span></td>
                      <td style="text-align:center">
                        {necesitaCalificar ? (
                          <button class="btn btn-primary btn-sm btn-calificar" data-id={s.idSolicitud} data-servicio={s.servicioTitulo}>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                            Calificar
                          </button>
                        ) : s.calificacion != null ? (
                          <span class="badge badge-neutral badge-sm" style="font-size:11px">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                            {s.calificacion.puntaje}/5
                          </span>
                        ) : null}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="table-wrap" id="solicitudesTable" hidden style="border:none;border-radius:0">
            <table class="table">
              <thead><tr><th>Servicio</th><th>Trabajador</th><th>Fecha</th><th>Hora</th><th>Estado</th><th style="text-align:center">Acción</th></tr></thead>
              <tbody id="solicitudesBody"></tbody>
            </table>
          </div>
          <div class="card-body" id="solicitudesEmpty">
            <div class="empty-state">
              <div class="empty-state-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              </div>
              <h3>Aún no hay solicitudes</h3>
              <p>No has realizado ninguna solicitud de servicio todavía.</p>
              <a href="/categorias/" class="btn btn-primary">Solicitar un servicio</a>
            </div>
          </div>
        )}
      </div>
    </main>
  </div>

  <!-- Rating Modal -->
  <div class="modal-overlay" id="modalCalificar">
    <div class="modal cal-modal">
      <div class="cal-header">
        <span class="cal-header-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </span>
        <div class="cal-header-text">
          <h3>Calificar servicio</h3>
          <p class="cal-sub">¿Cómo te fue con <strong id="modalServicio"></strong>?</p>
        </div>
        <button type="button" class="cal-close" id="modalClose" aria-label="Cerrar">&times;</button>
      </div>

      <form id="formCalificar">
        <div class="cal-body">
          <input type="hidden" name="idSolicitud" id="inputIdSolicitud" value="" />
          <input type="hidden" name="puntaje" id="inputPuntaje" value="0" />

          <div class="cal-section cal-rating">
            <span class="cal-label">Tu calificación</span>
            <div class="cal-stars" id="starRating" role="radiogroup" aria-label="Calificación de 1 a 5 estrellas">
              <span class="star" data-value="1" role="radio" aria-label="1 estrella">&#9733;</span>
              <span class="star" data-value="2" role="radio" aria-label="2 estrellas">&#9733;</span>
              <span class="star" data-value="3" role="radio" aria-label="3 estrellas">&#9733;</span>
              <span class="star" data-value="4" role="radio" aria-label="4 estrellas">&#9733;</span>
              <span class="star" data-value="5" role="radio" aria-label="5 estrellas">&#9733;</span>
            </div>
            <span class="cal-rating-text" id="ratingTexto">Toca una estrella</span>
          </div>

          <div class="cal-section">
            <label class="cal-label" for="comentario">Comentario <span class="cal-opt">(opcional)</span></label>
            <textarea class="cal-textarea" id="comentario" name="comentario" placeholder="Cuéntanos tu experiencia con este servicio..." maxlength="500"></textarea>
            <div class="cal-counter" id="charCounter">0/500</div>
          </div>

          <div class="cal-section">
            <div class="cal-photos-head">
              <span class="cal-label">Fotos del trabajo realizado <span class="cal-opt">(opcional)</span></span>
              <span class="cal-counter" id="fotoContador">0/3</span>
            </div>
            <div class="cal-photo-grid" id="fotoList" hidden></div>
            <input type="file" id="inputFotos" accept="image/jpeg,image/png,image/webp" multiple hidden />
            <button type="button" class="cal-dropzone" id="btnAgregarFoto">
              <span class="cal-dropzone-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </span>
              <span class="cal-dropzone-text">
                <strong>Agregar fotos</strong>
                <small>JPG, PNG o WEBP · máx. 5 MB cada una</small>
              </span>
            </button>
          </div>
        </div>

        <div class="cal-footer">
          <button type="button" class="btn btn-secondary" id="modalCancel">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btnSubmitCalificar">Enviar calificación</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Toast Container -->
  <div class="toast-container" id="toastContainer"></div>

  <script>
    const navToggle = document.getElementById("navToggle");
    const navLinks = document.getElementById("navLinks");
    navToggle?.addEventListener("click", () => {
      navLinks?.classList.toggle("open");
    });
  </script>

  <script is:inline>
    const apiCliente = "http://127.0.0.1:8000";
    const leerArregloCliente = (data) => Array.isArray(data) ? data : Array.isArray(data?.value) ? data.value : [];
    const textoSeguroCliente = (value) => String(value ?? "");
    const estadoCliente = (estado) => ({ aceptado: "Aceptada", en_proceso: "En proceso", rumbo_a_ubicacion: "En camino", trabajo_realizado: "Trabajo realizado", finalizado: "Finalizada", cancelada: "Cancelada", rechazado: "Rechazada", pendiente: "Pendiente" }[estado] || estado || "Pendiente");
    const claseEstadoCliente = (estado) => ({ pendiente: "badge-warning", aceptado: "badge-primary", en_proceso: "badge-primary", rumbo_a_ubicacion: "badge-primary", trabajo_realizado: "badge-success", finalizado: "badge-success", cancelada: "badge-danger", rechazado: "badge-danger" }[estado] || "badge-neutral");
    const mostrarErrorCliente = (mensaje) => window.alert(mensaje);
    const fechaCliente = (value) => {
      if (!value) return "—";
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? textoSeguroCliente(value) : date.toLocaleDateString("es-CO");
    };

    const cargarSolicitudesCliente = async (silencioso = false) => {
      let usuario;
      try { usuario = JSON.parse(localStorage.getItem("usuario") || "null"); } catch { usuario = null; }
      const token = localStorage.getItem("token");
      if (!usuario?.id) {
        if (!silencioso) mostrarErrorCliente("Inicia sesión para consultar tus solicitudes.");
        return;
      }
      try {
        const response = await fetch(`${apiCliente}/api/solicitudes?cliente=${encodeURIComponent(usuario.id)}`, {
          headers: token ? { Authorization: `Bearer ${token}` } : {},
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.mensaje || "No se pudieron cargar tus solicitudes.");
        const solicitudes = leerArregloCliente(data);
        const body = document.getElementById("solicitudesBody");
        const empty = document.getElementById("solicitudesEmpty");
        if (!body) return;
        body.replaceChildren();
        if (empty) empty.hidden = solicitudes.length > 0;
        const main = document.getElementById("solicitudesTable");
        if (main) main.hidden = solicitudes.length === 0;

        let pendientes = 0, aceptadas = 0, finalizadas = 0, porCalificar = 0;
        for (const solicitud of solicitudes) {
          const estado = String(solicitud.Estado_Solicitudes || "pendiente").toLowerCase();
          const calificada = Number(solicitud.Calificada) === 1;
          if (estado === "pendiente") pendientes++;
          if (["aceptado", "en_proceso", "rumbo_a_ubicacion", "trabajo_realizado"].includes(estado)) aceptadas++;
          if (estado === "finalizado") finalizadas++;
          if (estado === "finalizado" && !calificada) porCalificar++;

          const tr = document.createElement("tr");
          const servicio = document.createElement("td");
          servicio.className = "cliente-service-cell";
          const serviceLabel = document.createElement("span"); serviceLabel.className = "cliente-request-service";
          const serviceIcon = document.createElement("span"); serviceIcon.className = "cliente-request-service-icon";
          serviceIcon.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m14.7 6.3 3 3M4 20l4.2-1 10.5-10.5a2.1 2.1 0 0 0-3-3L5.2 16 4 20Z"/><path d="m13 8 3 3"/></svg>';
          const strong = document.createElement("strong");
          strong.className = "cliente-request-service-title";
          strong.textContent = solicitud.Titulo_Servicio || "Servicio";
          serviceLabel.append(serviceIcon, strong); servicio.appendChild(serviceLabel);
          const trabajador = document.createElement("td"); trabajador.className = "cliente-worker-cell"; trabajador.textContent = solicitud.Nombre_Trabajador || "—";
          const fecha = document.createElement("td"); fecha.textContent = fechaCliente(solicitud.Fecha_Servicio);
          const hora = document.createElement("td"); hora.textContent = textoSeguroCliente(solicitud.Hora_Servicio) || "—";
          const estadoTd = document.createElement("td");
          const badge = document.createElement("span"); badge.className = `badge ${claseEstadoCliente(estado)}`; badge.textContent = estadoCliente(estado); estadoTd.appendChild(badge);
          const acciones = document.createElement("td"); acciones.style.textAlign = "center";
          if (estado === "finalizado" && !calificada) {
            const button = document.createElement("button"); button.type = "button"; button.className = "btn btn-primary btn-sm btn-calificar";
            button.dataset.id = solicitud.Id_Solicitud; button.dataset.servicio = solicitud.Titulo_Servicio || "Servicio"; button.textContent = "Calificar"; acciones.appendChild(button);
          } else if (estado === "finalizado" && calificada) {
            const done = document.createElement("span"); done.className = "badge badge-neutral badge-sm"; done.style.fontSize = "11px"; done.textContent = "Calificada"; acciones.appendChild(done);
          }
          tr.append(servicio, trabajador, fecha, hora, estadoTd, acciones); body.appendChild(tr);
        }

        document.getElementById("statPendientes").textContent = String(pendientes);
        document.getElementById("statAceptadas").textContent = String(aceptadas);
        document.getElementById("statFinalizadas").textContent = String(finalizadas);
        document.getElementById("statTotal").textContent = String(solicitudes.length);
        const indicador = document.getElementById("calificacionesPendientes");
        const contador = document.getElementById("contadorCalificaciones");
        if (indicador) indicador.hidden = porCalificar === 0;
        if (contador) contador.textContent = String(porCalificar);
        const bienvenida = document.getElementById("nombreBienvenidaCliente");
        if (bienvenida) bienvenida.textContent = usuario.nombre || "Cliente";
      } catch (error) {
        if (!silencioso) mostrarErrorCliente(error instanceof Error ? error.message : "No se pudieron cargar tus solicitudes.");
      }
    };

    cargarSolicitudesCliente();
    window.setInterval(() => cargarSolicitudesCliente(true), 12000);
    window.addEventListener("focus", () => cargarSolicitudesCliente(true));

    // ---------- Estrellas ----------
    const TEXTOS_PUNTAJE = ["Toca una estrella", "Muy malo", "Malo", "Regular", "Bueno", "Excelente"];
    const pintarEstrellas = (valor) => {
      document.querySelectorAll("#starRating .star").forEach((s) => {
        s.classList.toggle("is-active", Number(s.dataset.value) <= valor);
      });
    };
    const fijarPuntaje = (valor) => {
      document.getElementById("inputPuntaje").value = String(valor);
      const texto = document.getElementById("ratingTexto");
      texto.textContent = TEXTOS_PUNTAJE[valor] || TEXTOS_PUNTAJE[0];
      texto.classList.toggle("has-value", valor > 0);
      pintarEstrellas(valor);
    };
    const starRating = document.getElementById("starRating");
    starRating?.addEventListener("mouseover", (e) => {
      const s = e.target instanceof Element ? e.target.closest(".star") : null;
      if (s) pintarEstrellas(Number(s.dataset.value));
    });
    starRating?.addEventListener("mouseleave", () => pintarEstrellas(Number(document.getElementById("inputPuntaje").value)));

    // ---------- Fotos de la calificación ----------
    const MAX_FOTOS = 3;
    const MAX_BYTES = 5 * 1024 * 1024;
    const TIPOS_FOTO = ["image/jpeg", "image/png", "image/webp"];
    let fotosCalificacion = [];

    const renderFotosCalificacion = () => {
      const lista = document.getElementById("fotoList");
      const dropzone = document.getElementById("btnAgregarFoto");
      const contador = document.getElementById("fotoContador");
      if (!lista) return;
      lista.querySelectorAll("img").forEach((img) => URL.revokeObjectURL(img.src));
      lista.replaceChildren();
      fotosCalificacion.forEach((archivo, indice) => {
        const item = document.createElement("div");
        item.className = "cal-photo";
        const img = document.createElement("img");
        img.src = URL.createObjectURL(archivo);
        img.alt = archivo.name;
        const quitar = document.createElement("button");
        quitar.type = "button";
        quitar.className = "cal-photo-remove";
        quitar.setAttribute("aria-label", "Quitar foto");
        quitar.dataset.quitarFoto = String(indice);
        quitar.innerHTML = "&times;";
        item.append(img, quitar);
        lista.appendChild(item);
      });
      if (contador) contador.textContent = `${fotosCalificacion.length}/${MAX_FOTOS}`;
      if (dropzone) dropzone.hidden = fotosCalificacion.length >= MAX_FOTOS;
      lista.hidden = fotosCalificacion.length === 0;
    };

    const inputFotos = document.getElementById("inputFotos");
    inputFotos?.addEventListener("change", () => {
      for (const archivo of Array.from(inputFotos.files || [])) {
        if (fotosCalificacion.length >= MAX_FOTOS) {
          mostrarErrorCliente(`Máximo ${MAX_FOTOS} fotos.`);
          break;
        }
        if (!TIPOS_FOTO.includes(archivo.type)) {
          mostrarErrorCliente(`"${archivo.name}" no es JPG, PNG o WEBP.`);
          continue;
        }
        if (archivo.size > MAX_BYTES) {
          mostrarErrorCliente(`"${archivo.name}" supera los 5 MB.`);
          continue;
        }
        fotosCalificacion.push(archivo);
      }
      inputFotos.value = ""; // permite volver a elegir el mismo archivo
      renderFotosCalificacion();
    });

    // ---------- Modal ----------
    const modalCalificar = document.getElementById("modalCalificar");
    const cerrarModalCalificar = () => modalCalificar?.classList.remove("active");

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest("#btnAgregarFoto")) {
        if (fotosCalificacion.length >= MAX_FOTOS) return mostrarErrorCliente(`Máximo ${MAX_FOTOS} fotos.`);
        inputFotos?.click();
        return;
      }
      const quitarFoto = target.closest("[data-quitar-foto]");
      if (quitarFoto) {
        fotosCalificacion.splice(Number(quitarFoto.dataset.quitarFoto), 1);
        renderFotosCalificacion();
        return;
      }

      const boton = target.closest(".btn-calificar");
      if (boton) {
        document.getElementById("inputIdSolicitud").value = boton.dataset.id || "";
        document.getElementById("modalServicio").textContent = boton.dataset.servicio || "";
        document.getElementById("comentario").value = "";
        document.getElementById("charCounter").textContent = "0/500";
        fijarPuntaje(0);
        fotosCalificacion = [];
        renderFotosCalificacion();
        modalCalificar?.classList.add("active");
      }
      if (target.closest("#modalClose, #modalCancel")) cerrarModalCalificar();
      if (target === modalCalificar) cerrarModalCalificar();
      const estrella = target.closest("#starRating .star");
      if (estrella) fijarPuntaje(Number(estrella.dataset.value));
    });

    document.getElementById("comentario")?.addEventListener("input", (event) => {
      document.getElementById("charCounter").textContent = `${event.target.value.length}/500`;
    });

    // ---------- Envío ----------
    const formCalificar = document.getElementById("formCalificar");
    formCalificar?.addEventListener("submit", async (event) => {
      event.preventDefault();
      let usuario;
      try { usuario = JSON.parse(localStorage.getItem("usuario") || "null"); } catch { usuario = null; }
      const token = localStorage.getItem("token");
      const idSolicitud = Number(document.getElementById("inputIdSolicitud").value);
      const puntaje = Number(document.getElementById("inputPuntaje").value);
      if (!token || !usuario?.id) return mostrarErrorCliente("Inicia sesión para enviar una calificación.");
      if (!puntaje) return mostrarErrorCliente("Selecciona una calificación de 1 a 5 estrellas.");

      const btn = document.getElementById("btnSubmitCalificar");
      btn.disabled = true;
      btn.textContent = "Enviando...";
      try {
        // FormData: NO se pone Content-Type, el navegador lo agrega con el boundary
        const formData = new FormData();
        formData.append("idSolicitud", String(idSolicitud));
        formData.append("puntaje", String(puntaje));
        formData.append("comentario", document.getElementById("comentario").value.trim());
        fotosCalificacion.forEach((archivo) => formData.append("fotos", archivo));

        const response = await fetch(`${apiCliente}/api/calificaciones`, {
          method: "POST",
          headers: { Authorization: `Bearer ${token}` },
          body: formData,
        });
        const texto = await response.text();
        console.log("Calificar →", response.status, texto);
        let data = {};
        try { data = JSON.parse(texto); } catch {}
        if (!response.ok) throw new Error(data.mensaje || `Error ${response.status} al enviar la calificación.`);
        cerrarModalCalificar();
        window.alert(data.mensaje || "Calificación enviada correctamente.");
        await cargarSolicitudesCliente();
      } catch (error) {
        window.alert(error instanceof Error ? error.message : "No se pudo enviar la calificación.");
      } finally {
        btn.disabled = false;
        btn.textContent = "Enviar calificación";
      }
    });
  </script>
</Layout>