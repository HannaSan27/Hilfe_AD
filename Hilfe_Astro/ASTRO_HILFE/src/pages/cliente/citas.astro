---
import Layout from "../../layouts/Layout.astro";
import ClienteSidebar from "../../components/clientesidebar.astro";
import ClienteTopbar from "../../components/clientetopbar.astro";
import "../../components/styles/citascliente.css";
import "../../components/styles/panelcliente.css";

interface Solicitud {
  servicioTitulo: string | null;
  trabajadorNombre: string | null;
  fechaServicio: string | Date;
  horaServicio: string;
  direccion: string;
  estado: "confirmada" | "pendiente" | "finalizada" | "cancelada" | string;
}

// TODO: reemplaza por tu consulta real (BD/API) cuando conectes tu backend
const citas: Solicitud[] = [];

function badgeClase(estado: string) {
  switch (estado) {
    case "confirmada": return "badge-success";
    case "pendiente": return "badge-warning";
    case "finalizada": return "badge-info";
    case "cancelada": return "badge-danger";
    default: return "badge-neutral";
  }
}

function formatearFecha(fecha: string | Date) {
  const d = typeof fecha === "string" ? new Date(fecha) : fecha;
  const dd = String(d.getDate()).padStart(2, "0");
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  const yyyy = d.getFullYear();
  return `${dd}/${mm}/${yyyy}`;
}
---

<Layout title="Mis Citas">
  <div class="trabajador-shell cliente-shell">
    <ClienteSidebar active="citas" />

    <main class="trabajador-main cliente-main cliente-appointments-main">
      <ClienteTopbar title="Mis citas" subtitle="Historial de todas tus citas agendadas" />

      <div class="content-card cliente-content-card cliente-history-card cliente-appointments-card">
        <div class="card-header">
          <div class="cliente-history-heading">
            <span class="cliente-history-icon"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/></svg></span>
            <span><strong>Todas tus citas</strong><small>Consulta los detalles y el estado de cada servicio</small></span>
          </div>
          <span class="cliente-history-caption">AGENDA DE SERVICIOS</span>
        </div>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Servicio</th>
                <th>Trabajador</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Dirección</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              {citas && citas.length > 0 ? (
                citas.map((s) => (
                  <tr>
                    <td><span class="cliente-request-service"><span class="cliente-request-service-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m14.7 6.3 3 3M4 20l4.2-1 10.5-10.5a2.1 2.1 0 0 0-3-3L5.2 16 4 20Z"/><path d="m13 8 3 3"/></svg></span><strong>{s.servicioTitulo}</strong></span></td>
                    <td><span class="cliente-worker-name">{s.trabajadorNombre}</span></td>
                    <td><span class="cliente-appointment-date">{formatearFecha(s.fechaServicio)}</span></td>
                    <td><span class="cliente-appointment-time">{s.horaServicio}</span></td>
                    <td><span class="cliente-appointment-address"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>{s.direccion}</span></td>
                    <td><span class={`badge ${badgeClase(s.estado)}`}>{s.estado}</span></td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colspan="6">
                      <div class="empty-state cliente-appointments-empty">
                      <span class="cliente-empty-calendar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M8 14h3M8 18h7"/></svg></span>
                      <h3>Tu agenda está despejada</h3>
                      <p>Aquí aparecerán las citas de tus servicios para que puedas consultar sus detalles.</p>
                      <a href="/categorias/" class="btn btn-primary">Explorar servicios</a>
                    </div>
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script is:inline>
  const apiClienteCitas = "http://127.0.0.1:8000";
  const estadoTextoCita = (estado) => ({ pendiente: "Pendiente", aceptado: "Aceptada", en_proceso: "En proceso", rumbo_a_ubicacion: "En camino", trabajo_realizado: "Trabajo realizado", finalizado: "Finalizada", cancelada: "Cancelada", rechazado: "Rechazada" }[estado] || estado || "Pendiente");
  const estadoClaseCita = (estado) => ({ pendiente: "badge-warning", aceptado: "badge-success", en_proceso: "badge-success", rumbo_a_ubicacion: "badge-success", trabajo_realizado: "badge-info", finalizado: "badge-info", cancelada: "badge-danger", rechazado: "badge-danger" }[estado] || "badge-neutral");
  const cargarCitasCliente = async (silencioso = false) => {
    let usuario;
    try { usuario = JSON.parse(localStorage.getItem("usuario") || "null"); } catch { usuario = null; }
    if (!usuario?.id) return;
    try {
      const token = localStorage.getItem("token");
      const response = await fetch(`${apiClienteCitas}/api/solicitudes?cliente=${encodeURIComponent(usuario.id)}`, { headers: token ? { Authorization: `Bearer ${token}` } : {} });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.mensaje || "No se pudieron cargar tus citas.");
      const citas = Array.isArray(result) ? result : Array.isArray(result?.value) ? result.value : [];
      const tbody = document.querySelector(".content-card tbody");
      if (!tbody) return;
      tbody.replaceChildren();
      if (!citas.length) {
        const row = document.createElement("tr");
        const cell = document.createElement("td"); cell.colSpan = 6;
        const empty = document.createElement("div"); empty.className = "empty-state cliente-appointments-empty";
        const iconWrap = document.createElement("span"); iconWrap.className = "cliente-empty-calendar";
        iconWrap.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 14h3M8 18h7"/></svg>';
        const heading = document.createElement("h3"); heading.textContent = "Tu agenda está despejada";
        const text = document.createElement("p"); text.textContent = "Aquí aparecerán las citas de tus servicios para que puedas consultar sus detalles.";
        const link = document.createElement("a"); link.className = "btn btn-primary"; link.href = "/categorias/"; link.textContent = "Explorar servicios";
        empty.append(iconWrap, heading, text, link); cell.appendChild(empty); row.appendChild(cell); tbody.appendChild(row); return;
      }
      for (const cita of citas) {
        const estado = String(cita.Estado_Solicitudes || "pendiente").toLowerCase();
        const row = document.createElement("tr");
        const servicio = document.createElement("td"); const serviceLabel = document.createElement("span"); serviceLabel.className = "cliente-request-service";
        const serviceIcon = document.createElement("span"); serviceIcon.className = "cliente-request-service-icon"; serviceIcon.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m14.7 6.3 3 3M4 20l4.2-1 10.5-10.5a2.1 2.1 0 0 0-3-3L5.2 16 4 20Z"/><path d="m13 8 3 3"/></svg>';
        const titulo = document.createElement("strong"); titulo.className = "cliente-request-service-title"; titulo.textContent = cita.Titulo_Servicio || "Servicio"; serviceLabel.append(serviceIcon, titulo); servicio.appendChild(serviceLabel);
        const trabajador = document.createElement("td"); trabajador.className = "cliente-worker-cell"; trabajador.textContent = cita.Nombre_Trabajador || "—";
        const fecha = document.createElement("td"); fecha.className = "cliente-appointment-date"; const date = new Date(cita.Fecha_Servicio); fecha.textContent = cita.Fecha_Servicio && !Number.isNaN(date.getTime()) ? date.toLocaleDateString("es-CO") : cita.Fecha_Servicio || "—";
        const hora = document.createElement("td"); hora.className = "cliente-appointment-time"; hora.textContent = cita.Hora_Servicio || "—";
        const direccion = document.createElement("td"); const addressLabel = document.createElement("span"); addressLabel.className = "cliente-appointment-address"; addressLabel.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>'; const addressText = document.createElement("span"); addressText.textContent = cita.Direccion || "—"; addressLabel.appendChild(addressText); direccion.appendChild(addressLabel);
        const estadoCell = document.createElement("td"); const badge = document.createElement("span"); badge.className = `badge ${estadoClaseCita(estado)}`; badge.textContent = estadoTextoCita(estado); estadoCell.appendChild(badge);
        row.append(servicio, trabajador, fecha, hora, direccion, estadoCell); tbody.appendChild(row);
      }
    } catch (error) {
      if (!silencioso) window.alert(error instanceof Error ? error.message : "No se pudieron cargar tus citas.");
    }
  };
  cargarCitasCliente();
  window.setInterval(() => cargarCitasCliente(true), 12000);
  window.addEventListener("focus", () => cargarCitasCliente(true));
</script>
