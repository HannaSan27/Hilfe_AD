---
import Layout from "../../layouts/Layout.astro";
import ClienteSidebar from "../../components/clientesidebar.astro";
import ClienteTopbar from "../../components/clientetopbar.astro";
import "../../components/styles/citascliente.css";

interface Solicitud {
  servicioTitulo: string | null;
  trabajadorNombre: string | null;
  fechaServicio: string | Date;
  horaServicio: string;
  direccion: string;
  estado: "confirmada" | "pendiente" | "finalizada" | "cancelada" | string;
}

// TODO: reemplaza por tu consulta real (BD/API) cuando conectes tu backend
const citas: Solicitud[] = [];

function badgeClase(estado: string) {
  switch (estado) {
    case "confirmada": return "badge-success";
    case "pendiente": return "badge-warning";
    case "finalizada": return "badge-info";
    case "cancelada": return "badge-danger";
    default: return "badge-neutral";
  }
}

function formatearFecha(fecha: string | Date) {
  const d = typeof fecha === "string" ? new Date(fecha) : fecha;
  const dd = String(d.getDate()).padStart(2, "0");
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  const yyyy = d.getFullYear();
  return `${dd}/${mm}/${yyyy}`;
}
---

<Layout title="Mis Citas">
<Fragment slot="head">
  <link rel="stylesheet" href="/css/design-system.css" />
</Fragment>

  <div class="trabajador-shell">
    <ClienteSidebar active="citas" />

    <main class="trabajador-main">
      <ClienteTopbar title="Mis citas" subtitle="Historial de todas tus citas agendadas" />

      <div class="content-card">
        <div class="card-header">
          <h3>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><polyline points="9 16 11 18 15 12"/></svg>
            Todas las citas
          </h3>
        </div>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Servicio</th>
                <th>Trabajador</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Dirección</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              {citas && citas.length > 0 ? (
                citas.map((s) => (
                  <tr>
                    <td><strong style="color:var(--primary)">{s.servicioTitulo}</strong></td>
                    <td>{s.trabajadorNombre}</td>
                    <td>{formatearFecha(s.fechaServicio)}</td>
                    <td>{s.horaServicio}</td>
                    <td>{s.direccion}</td>
                    <td><span class={`badge ${badgeClase(s.estado)}`}>{s.estado}</span></td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colspan="6">
                    <div class="empty-state">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                      <p>No tienes citas registradas.</p>
                    </div>
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</Layout>