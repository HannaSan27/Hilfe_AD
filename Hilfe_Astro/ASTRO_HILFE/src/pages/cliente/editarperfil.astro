---
import Layout from "../../layouts/Layout.astro";
import ClienteSidebar from "../../components/clientesidebar.astro";
import ClienteTopbar from "../../components/clientetopbar.astro";
import "../../components/styles/editarcliente.css";

interface Usuario {
  nombre: string;
  correo: string;
  telefono: string;
}

// TODO: reemplaza por tu lógica real (sesión/BD/API) cuando conectes tu backend
const usuario: Usuario = {
  nombre: "",
  correo: "",
  telefono: "",
};

const mensaje: string | null = null;
---

<Layout title="Mi Perfil">
<Fragment slot="head">
  <link rel="stylesheet" href="/css/design-system.css" />
</Fragment>

  <div class="trabajador-shell">
    <ClienteSidebar active="perfil" />

    <main class="trabajador-main">
      <ClienteTopbar title="Mi perfil" subtitle="Administra tu información personal" />

      {mensaje && (
        <div class="toast-success">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          {mensaje}
        </div>
      )}

      <div class="content-card">
        <div class="card-header">
          <h3>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Información personal
          </h3>
        </div>
        <form id="formPerfilCliente" style="padding:24px;">
          <div class="form-group">
            <label for="nombre">Nombre completo</label>
            <input type="text" name="nombre" id="nombre" class="form-control" value={usuario.nombre} required />
          </div>
          <div class="form-group">
            <label for="correo">Correo electrónico</label>
            <input type="email" id="correo" class="form-control" value={usuario.correo} disabled />
            <small style="color:var(--text-muted,#94a3b8);margin-top:4px;display:block;font-size:12px;">El correo no se puede modificar.</small>
          </div>
          <div class="form-group">
            <label for="telefono">Teléfono</label>
            <input type="text" name="telefono" id="telefono" class="form-control" value={usuario.telefono} />
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
          </div>
        </form>
      </div>
    </main>
  </div>
</Layout>

<script is:inline>
  const apiPerfilCliente = "http://127.0.0.1:8000";
  const formularioPerfilCliente = document.getElementById("formPerfilCliente");
  let ubicacionPerfilCliente = "";
  const mostrarMensajePerfilCliente = (mensaje, correcto = false) => {
    let contenedor = document.querySelector(".trabajador-main > .toast-success");
    if (!correcto) { window.alert(mensaje); return; }
    if (!contenedor) {
      contenedor = document.createElement("div");
      contenedor.className = "toast-success";
      formularioPerfilCliente?.parentElement?.before(contenedor);
    }
    contenedor.textContent = mensaje;
  };
  (async () => {
    let usuario;
    try { usuario = JSON.parse(localStorage.getItem("usuario") || "null"); } catch { usuario = null; }
    if (!usuario?.id) { mostrarMensajePerfilCliente("Inicia sesión para consultar tu perfil."); return; }
    try {
      const response = await fetch(`${apiPerfilCliente}/api/usuarios/${encodeURIComponent(usuario.id)}`);
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.mensaje || "No se pudo cargar tu perfil.");
      ubicacionPerfilCliente = result.Ubicacion || "";
      document.getElementById("nombre").value = result.Nombre || usuario.nombre || "";
      document.getElementById("correo").value = result.Correo || usuario.correo || "";
      document.getElementById("telefono").value = result.Telefono || "";
    } catch (error) {
      mostrarMensajePerfilCliente(error instanceof Error ? error.message : "No se pudo cargar tu perfil.");
    }
  })();
  formularioPerfilCliente?.addEventListener("submit", async (event) => {
    event.preventDefault();
    let usuario;
    try { usuario = JSON.parse(localStorage.getItem("usuario") || "null"); } catch { usuario = null; }
    const token = localStorage.getItem("token");
    if (!usuario?.id || !token) { mostrarMensajePerfilCliente("Inicia sesión para guardar los cambios."); return; }
    try {
      const response = await fetch(`${apiPerfilCliente}/api/usuarios/${encodeURIComponent(usuario.id)}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
        body: JSON.stringify({ nombre: document.getElementById("nombre").value.trim(), telefono: document.getElementById("telefono").value.trim(), ubicacion: ubicacionPerfilCliente }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.mensaje || "No se pudieron guardar los cambios.");
      const actualizado = { ...usuario, nombre: document.getElementById("nombre").value.trim() };
      localStorage.setItem("usuario", JSON.stringify(actualizado));
      mostrarMensajePerfilCliente(result.mensaje || "Perfil actualizado correctamente.", true);
    } catch (error) {
      mostrarMensajePerfilCliente(error instanceof Error ? error.message : "No se pudieron guardar los cambios.");
    }
  });
</script>
