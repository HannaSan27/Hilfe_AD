    --text: var(--color-text, #0f172a);
    --muted: var(--color-muted, #64748b);
    --border: var(--color-border, #e2e8f0);

    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    color: var(--text);
    max-width: 920px;
    margin: 0 auto;
    padding: 3rem 1.25rem 5rem;
    display: grid;
    gap: 1.75rem;
  }

  .wallet__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; }
  .eyebrow { display: block; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--primary); }
  h1 { font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 800; line-height: 1.1; margin: 0.25rem 0 0; letter-spacing: -0.02em; }
  .grad { background: linear-gradient(90deg, #4f46e5, #7c3aed); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .demo { margin: 0; padding: 0.6rem 1rem; border-radius: 14px; background: #fef9c3; color: #854d0e; font-size: 0.85rem; }
  .muted-msg { margin: 0; color: var(--muted); font-size: 0.92rem; }

  .brand { display: inline-flex; align-items: center; gap: .6rem; margin-bottom: 1.1rem; text-decoration: none; color: var(--text); transition: transform .2s ease; }
  .brand:hover { transform: translateY(-2px); }
  .brand__mark { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 12px; color: #fff; background: linear-gradient(135deg, #1d4ed8, #2563eb 55%, #0ea5e9); box-shadow: 0 10px 20px -10px rgba(37, 99, 235, .8); transition: transform .3s ease; }
  .brand:hover .brand__mark { transform: rotate(-8deg) scale(1.06); }
  .brand__text { font-size: 1.7rem; font-weight: 800; letter-spacing: -.03em; line-height: 1; }
  .brand__accent { background: linear-gradient(90deg, #2563eb, #7c3aed); -webkit-background-clip: text; background-clip: text; color: transparent; }

  .balance {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem;
    padding: 2rem 2.25rem; border-radius: 28px; color: #fff;
    background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 55%, #0ea5e9 100%);
    box-shadow: 0 20px 40px -18px rgba(37, 99, 235, 0.55);
    position: relative; overflow: hidden;
  }
  .balance::after { content: ''; position: absolute; right: -60px; top: -60px; width: 220px; height: 220px; background: radial-gradient(circle, rgba(255, 255, 255, 0.25), transparent 70%); }
  .balance__label { margin: 0; opacity: 0.85; font-size: 0.95rem; }
  .balance__amount { margin: 0.25rem 0; font-size: clamp(2.4rem, 6vw, 3.4rem); font-weight: 800; letter-spacing: -0.03em; }
  .balance__hint { margin: 0; opacity: 0.8; font-size: 0.9rem; }
  .balance__actions { display: flex; flex-direction: column; gap: 0.75rem; min-width: 170px; position: relative; z-index: 1; }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.8rem 1.5rem; border-radius: 999px; border: 1px solid transparent; font: inherit; font-weight: 600; cursor: pointer; text-decoration: none; transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease; }
  .btn:hover { transform: translateY(-1px); }
  .btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
  .balance .btn--primary { background: #fff; color: var(--primary); box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.35); }
  .balance .btn--soft { background: rgba(255, 255, 255, 0.16); color: #fff; border-color: rgba(255, 255, 255, 0.35); backdrop-filter: blur(6px); }
  .btn--ghost { background: var(--bg-card); color: var(--text); border-color: var(--border); }
  .btn--main { background: var(--primary); color: #fff; }

  .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 28px; padding: 1.75rem 2rem; box-shadow: 0 10px 30px -20px rgba(15, 23, 42, 0.25); }
  .admin-commission-summary { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: .35rem 1.5rem; border-color: color-mix(in srgb, var(--primary) 28%, var(--border)); }
  .admin-commission-summary h2 { margin: .25rem 0; font-size: 1.15rem; }
  .admin-commission-summary p { margin: 0; color: var(--muted); font-size: .9rem; }
  .admin-commission-summary > strong { color: var(--primary); font-size: clamp(1.5rem, 3vw, 2rem); font-variant-numeric: tabular-nums; }
  .admin-commission-withdrawn { grid-column: 1 / -1; padding-top: .8rem; border-top: 1px solid var(--border); color: var(--muted); font-size: .85rem; }
  .admin-commission-withdrawn b { color: var(--text); }
  .card__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .card__head h2 { font-size: 1.15rem; font-weight: 700; margin: 0; }
  .link { color: var(--primary); font-weight: 600; text-decoration: none; background: none; border: 0; cursor: pointer; font: inherit; }
  .link:hover { text-decoration: underline; }

  .empty { text-align: center; padding: 2.5rem 1rem; color: var(--muted); }
  .empty__icon { width: 64px; height: 64px; margin: 0 auto 1rem; display: grid; place-items: center; font-size: 1.8rem; background: var(--primary-soft); border-radius: 20px; }
  .empty h3 { margin: 0 0 0.25rem; color: var(--text); font-size: 1.05rem; }
  .empty p { margin: 0; font-size: 0.92rem; }

  .day { margin: 1.1rem 0 0.2rem; font-size: 0.76rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .day-group:first-of-type .day { margin-top: 0; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; }
  .item { display: flex; align-items: center; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid var(--border); }
  .item:last-child { border-bottom: 0; }
  .item__icon { width: 42px; height: 42px; border-radius: 14px; display: grid; place-items: center; font-weight: 700; }
  .item__icon.in { background: #dcfce7; color: #16a34a; }
  .item__icon.out { background: #fee2e2; color: #dc2626; }
  .item__text { flex: 1; display: grid; }
  .item__text small { color: var(--muted); }
  .item__amount { font-weight: 700; }
  .item__amount.in { color: #16a34a; }
  .item__amount.out { color: #dc2626; }

  .modal { border: 0; border-radius: 24px; padding: 1.75rem; width: min(92vw, 380px); font-family: inherit; background: var(--bg-card); color: var(--text); box-shadow: 0 30px 60px -20px rgba(15, 23, 42, 0.45); }
  .modal::backdrop { background: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px); }
  .modal h3 { margin: 0 0 1rem; font-size: 1.2rem; }
  .modal input, .modal select { width: 100%; box-sizing: border-box; padding: 0.8rem 1rem; border: 1px solid var(--border); border-radius: 14px; font: inherit; background: var(--bg-card); color: inherit; margin-top: 0.75rem; }
  .modal input[hidden] { display: none; }
  .modal input:first-child { margin-top: 0; }
  .modal__error { color: #dc2626; font-size: 0.9rem; margin: 0.6rem 0 0; }
  .modal__actions { display: flex; gap: 0.75rem; margin-top: 1.25rem; }
  .modal__actions .btn { flex: 1; }

  .bank { text-align: center; }
  .bank__name { display: inline-block; padding: 0.5rem 1.2rem; border-radius: 12px; font-weight: 800; color: #fff; background: linear-gradient(135deg, #1e3a8a, #2563eb); margin-bottom: 1rem; }
  .bank__spin { width: 34px; height: 34px; margin: 0.5rem auto 1rem; border: 3px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: bank-spin 0.8s linear infinite; }
  .bank__spin[hidden] { display: none; }
  @keyframes bank-spin { to { transform: rotate(360deg); } }
  .code { text-align: center; font-size: 1.6rem; letter-spacing: 0.4em; font-weight: 700; }

  .hist { border: 0; padding: 0; width: min(94vw, 560px); max-height: 82vh; border-radius: 28px; font-family: 'Inter', system-ui, sans-serif; background: var(--bg-card); color: var(--text); box-shadow: 0 40px 80px -24px rgba(15, 23, 42, 0.55); overflow: hidden; }
  .hist[open] { animation: hist-pop 0.25s cubic-bezier(0.2, 0.9, 0.3, 1.15); display: flex; }
  .hist::backdrop { background: rgba(15, 23, 42, 0.55); backdrop-filter: blur(5px); animation: hist-fade 0.2s ease; }
  @keyframes hist-pop { from { opacity: 0; transform: translateY(14px) scale(0.96); } to { opacity: 1; transform: none; } }
  @keyframes hist-fade { from { opacity: 0; } to { opacity: 1; } }

  .hist__box { display: flex; flex-direction: column; width: 100%; max-height: 82vh; }
  .hist__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding: 1.4rem 1.6rem 1rem; background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(14, 165, 233, 0.06)); }
  .hist__head h3 { margin: 0.2rem 0 0; font-size: 1.3rem; font-weight: 800; letter-spacing: -0.02em; }
  .hist__close { width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--border); background: var(--bg-card); color: var(--text); font-size: 1.3rem; line-height: 1; cursor: pointer; transition: transform 0.2s ease; }
  .hist__close:hover { transform: rotate(90deg); }
  .hist__chips { display: flex; gap: 0.5rem; padding: 0.9rem 1.6rem 0.4rem; }
  .chip { padding: 0.4rem 1rem; border-radius: 999px; border: 1px solid var(--border); background: transparent; color: var(--text); font: inherit; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.15s ease; }
  .chip.is-active { background: var(--primary); border-color: transparent; color: #fff; }
  .hist__body { overflow-y: auto; padding: 0.4rem 1.6rem 1.5rem; }
  .hist__empty { text-align: center; color: var(--muted); padding: 2rem 0; }

  @media (max-width: 600px) {
    .balance { padding: 1.5rem; }
    .balance__actions { width: 100%; flex-direction: row; }
    .balance__actions .btn { flex: 1; }
    .card { padding: 1.25rem; }
  }

  .wallet--admin { max-width: 1080px; gap: 1.25rem; }
  .wallet--admin .wallet__head { align-items: center; padding: 0 0 1.1rem; border-bottom: 1px solid var(--border); }
  .wallet--admin .wallet__head-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .65rem; }
  .wallet--admin .wallet-back { border-radius: 12px; }
  .wallet--admin .wallet-back span { font-size: 1.15rem; }
  .wallet--admin .balance { min-height: 210px; border-radius: 22px; background: #2856d8; }
  .wallet--admin .balance::after { display: none; }
  .wallet--admin .balance__label, .wallet--admin .balance__hint { opacity: 1; color: #edf3ff; }
  .wallet--admin .balance__amount { color: #fff; font-variant-numeric: tabular-nums; }
  .wallet--admin .card { border-radius: 18px; }
  .wallet--admin .demo { border: 0; border-left: 3px solid var(--primary); border-radius: 0 10px 10px 0; background: var(--bg-card); color: var(--text); }
  .wallet--admin .grad { background-image: none; color: var(--primary); }
  :global(html[data-theme="dark"]) .wallet--admin {
    --bg-card: #171f2b;
    --text: #e8edf5;
    --muted: #aab5c4;
    --border: #344255;
    --primary-soft: #202b39;
    color: var(--text);
  }
  :global(html[data-theme="dark"]) .wallet--admin .card,
  :global(html[data-theme="dark"]) .wallet--admin .modal,
  :global(html[data-theme="dark"]) .wallet--admin .hist { background: var(--bg-card); color: var(--text); }
  :global(html[data-theme="dark"]) .wallet--admin .demo { border-color: var(--primary); background: var(--bg-card-alt); color: var(--text); }
  :global(html[data-theme="dark"]) .wallet--admin .hist__head { background: #202b39; }
  @media (max-width: 640px) {
    .wallet--admin { padding-top: 1.5rem; }
    .wallet--admin .wallet__head { align-items: flex-start; flex-direction: column; }
    .wallet--admin .wallet__head-actions { width: 100%; }
    .wallet--admin .wallet__head-actions .btn { flex: 1; }
    .wallet--admin .balance { min-height: auto; }
  }
  .wallet--admin .brand__mark { background: var(--primary); border-radius: 11px; }
