---
import Layout from '../layouts/Layout.astro';
import { obtenerBilletera, obtenerPendientesPago } from '../lib/billetera';
import { getUsuarioId } from '../lib/sesion';
import { agruparPorFecha, horaDe } from '../lib/fechas';
import { pool } from '../lib/db';
import { sincronizarComisionesAdmin } from '../lib/billetera';

export const prerender = false;

const usuarioId = getUsuarioId(Astro.cookies);
if (!usuarioId) return Astro.redirect('/login/login');

let saldo = 0;
let filas: any[] = [];
let pendientes: Awaited<ReturnType<typeof obtenerPendientesPago>> = [];
let errorBilletera = '';
let esAdmin = false;
let esCliente = false;
let comisionesGeneradas = 0;
let totalRetirado = 0;
let billeteraCargada = false;
try {
  const [usuarios] = await pool.query<any[]>('SELECT Id_Rol FROM usuarios WHERE Id_Usuario = ? LIMIT 1', [usuarioId]);
  const rol = Number(usuarios[0]?.Id_Rol);
  esAdmin = rol === 1;
  esCliente = rol === 3;
  if (esAdmin) await sincronizarComisionesAdmin(usuarioId);
  const wallet = await obtenerBilletera(usuarioId, 10);
  saldo = wallet.saldo;
  filas = wallet.movimientos;
  if (esAdmin) {
    const [resumen] = await pool.query<any[]>(
      `SELECT
          COALESCE(SUM(CASE WHEN t.type = 'deposit' AND t.description = 'Comisión de plataforma por servicio' THEN t.amount ELSE 0 END), 0) AS comisiones,
          COALESCE(SUM(CASE WHEN t.type = 'withdraw' THEN t.amount ELSE 0 END), 0) AS retiros
         FROM transactions t
         JOIN wallets w ON w.id = t.wallet_id
        WHERE w.user_id = ?`,
      [usuarioId]
    );
    comisionesGeneradas = Number(resumen[0]?.comisiones || 0);
    totalRetirado = Number(resumen[0]?.retiros || 0);
  }
  pendientes = await obtenerPendientesPago(usuarioId);
  billeteraCargada = true;
} catch (error) {
  console.error('No se pudo cargar la billetera:', error);
  errorBilletera = 'No se pudo cargar tu billetera. Revisa que MySQL esté activo y vuelve a intentarlo.';
}

const cop = (n: number) =>
  new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(n);

const movimientos = filas.map((m: any) => {
  const entra = m.type === 'deposit' || m.type === 'refund';
  return {
    id: m.id,
    titulo: m.description ?? (entra ? 'Ingreso' : 'Egreso'),
    fecha: new Date(m.created_at),
    monto: entra ? Number(m.amount) : -Number(m.amount),
  };
});
const grupos = agruparPorFecha(movimientos);
---

<Layout title="Mi Billetera | Hilf'e">
  <main class:list={['wallet', esAdmin && 'wallet--admin']}>
    <header class="wallet__head">
      <div>
        <a href="/" class="brand" aria-label="Ir al inicio de Hilf'e">
          <span class="brand__mark">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <rect x="3" y="3" width="18" height="18" rx="4"/>
              <line x1="12" y1="7" x2="12" y2="17"/>
              <line x1="7" y1="12" x2="17" y2="12"/>
            </svg>
          </span>
          <span class="brand__text">Hilf<span class="brand__accent">'e</span></span>
        </a>
        <span class="eyebrow">{esAdmin ? 'Billetera de administración' : 'Mi billetera'}</span>
        <h1>{esAdmin ? <>Comisiones de <span class="grad">Hilf’e</span></> : <>Saldo <span class="grad">disponible</span></>}</h1>
      </div>
      {esAdmin ? <div class="wallet__head-actions"><a class="btn btn--ghost wallet-back" href="/" aria-label="Volver al sitio"><span aria-hidden="true">←</span> Volver al sitio</a><button type="button" class="btn btn--ghost" data-open-hist>Historial</button></div> : <button type="button" class="btn btn--ghost" data-open-hist>Historial</button>}
    </header>

    {errorBilletera && (esAdmin ? <div class="wallet__error" role="alert"><span>No fue posible cargar los datos reales de la billetera. Revisa la conexión con la base de datos e inténtalo de nuevo.</span><button type="button" class="wallet__retry" id="wallet-retry">Reintentar</button></div> : <p class="wallet__error" role="alert">{errorBilletera}</p>)}

    <p class="demo">{esAdmin ? 'Aquí se acumulan las comisiones de servicios finalizados. Puedes consultar los movimientos y simular un retiro.' : 'Modo demostración: las recargas y retiros son simulados.'}</p>

    <section class="balance">
      <div class="balance__info">
        <p class="balance__label">Saldo actual</p>
        <p class="balance__amount" id="saldo-actual">{esAdmin && !billeteraCargada ? '—' : cop(saldo)}</p>
        <p class="balance__hint">{esAdmin ? 'Comisiones de servicios finalizados' : "Disponible para usar en Hilf'e"}</p>
      </div>
      <div class="balance__actions">
        {!esAdmin && <button class="btn btn--primary" id="btn-recargar">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          Recargar
        </button>}
        <button class="btn btn--soft" id="btn-retirar" disabled={esAdmin && !billeteraCargada}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
          {esAdmin ? 'Retirar comisiones' : 'Retirar'}
        </button>
      </div>
    </section>

    {esAdmin && <section class="card admin-commission-summary" aria-label="Resumen de comisiones de administración">
      <div>
        <span class="eyebrow">Ingresos de la plataforma</span>
        <h2>Comisiones generadas</h2>
        <p>Comisión acumulada por servicios finalizados.</p>
      </div>
      <div class="admin-commission-intro"><span class="eyebrow">Ingresos de la plataforma</span><h2>Comisiones acumuladas</h2><p>Por cada servicio finalizado, Hilf’e recibe el 5% del cliente y el 5% del trabajador.</p></div>
      <strong id="admin-comision-total">{billeteraCargada ? cop(comisionesGeneradas) : '—'}</strong>
      <div class="admin-commission-metrics">
        <div><span>5% aportado por clientes</span><b id="admin-comision-cliente">—</b></div>
        <div><span>5% descontado a trabajadores</span><b id="admin-comision-trabajador">—</b></div>
        <div><span>Servicios con comisión</span><b id="admin-servicios-comision">—</b></div>
        <div><span>Retiros registrados</span><b id="admin-retiros-comision">{billeteraCargada ? cop(totalRetirado) : '—'}</b></div>
      </div>
      <p class="admin-commission-withdrawn">Disponible para retirar: <b>{billeteraCargada ? cop(saldo) : '—'}</b>. Los retiros de esta demostración se descuentan del saldo y quedan en el historial; no se envía dinero real.</p>
    </section>}

    {esAdmin && <section class="card admin-trace-card">
      <div class="admin-trace-heading"><div><span class="eyebrow">Trazabilidad de cobros</span><h2>Comisiones por servicio</h2><p>Consulta quién pagó y quién recibió cada servicio, junto con el valor descontado a cada parte.</p></div><span id="admin-trace-count" class="admin-trace-count">— servicios</span></div>
      <div class="admin-trace-table-wrap" role="region" aria-label="Cobros por servicio; desplázate horizontalmente para ver todas las columnas" tabindex="0"><table class="admin-trace-table"><thead><tr><th>Servicio</th><th>Cliente</th><th>Trabajador</th><th>Valor del servicio</th><th>Pagó el cliente</th><th>Descuento cliente</th><th>Recibió trabajador</th><th>Descuento trabajador</th><th>Total Hilf’e</th><th>Comprobante</th></tr></thead><tbody id="admin-trace-list" aria-live="polite"><tr><td colspan="10" class="admin-trace-empty">Cargando movimientos registrados…</td></tr></tbody></table></div>
      <button type="button" id="admin-trace-more" class="admin-trace-more" aria-expanded="false" hidden>Ver todos los servicios</button>
    </section>}

    {esCliente && <section class="card">
      <div class="card__head">
        <h2>Servicios por pagar</h2>
      </div>
      {pendientes.length === 0 ? (
        <p class="muted-msg">No tienes servicios pendientes de pago.</p>
      ) : (
        <ul class="list">
          {pendientes.map(p => (
            <li class="item">
              <span class="item__icon out">$</span>
              <div class="item__text">
                <strong>{p.titulo}</strong>
                <small>{p.trabajador} · Abonado {cop(p.abonado)} · Pendiente {cop(p.saldoPendiente)}</small>
              </div>
              <button type="button" class="btn btn--main btn-pagar" data-solicitud={p.id} data-total={p.saldoPendiente}>
                {p.saldoPendiente > 0 ? 'Pagar saldo restante' : 'Confirmar y finalizar'}
              </button>
            </li>
          ))}
        </ul>
      )}
    </section>}

    <section class="card">
      <div class="card__head">
        <h2>Últimos movimientos</h2>
        <button type="button" class="link" data-open-hist>Ver todos</button>
      </div>

      {grupos.length === 0 ? (
        <div class="empty">
          <div class="empty__icon">💳</div>
          <h3>{errorBilletera && esAdmin ? 'Historial no disponible' : 'Aún no tienes movimientos'}</h3>
          <p>{errorBilletera && esAdmin ? 'Revisa la conexión con la base de datos e inténtalo de nuevo.' : esAdmin ? 'Cuando se registren comisiones, aparecerán aquí.' : 'Cuando completes trabajos, tus ingresos aparecerán aquí.'}</p>
        </div>
      ) : (
        grupos.map(g => (
          <div class="day-group">
            <h3 class="day">{g.etiqueta}</h3>
            <ul class="list">
              {g.items.map(m => (
                <li class="item">
                  <span class={`item__icon ${m.monto >= 0 ? 'in' : 'out'}`}>{m.monto >= 0 ? '↓' : '↑'}</span>
                  <div class="item__text">
                    <strong>{m.titulo}</strong>
                    <small>{horaDe(m.fecha)}</small>
                  </div>
                  <span class={`item__amount ${m.monto >= 0 ? 'in' : 'out'}`}>
                    {m.monto >= 0 ? '+' : ''}{cop(m.monto)}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      )}
    </section>

    <!-- ========== MODAL RECARGA / RETIRO ========== -->
    <dialog id="modal" class="modal">
      <h3 id="modal-title">Recargar saldo</h3>

      <div id="step-form">
        <input id="modal-monto" type="number" min="1000" step="1000" placeholder="Monto en COP" />
        <label id="modal-banco-label" for="modal-banco">Banco desde el que se simula la recarga</label>
        <select id="modal-banco">
          <option value="">Elige tu banco</option>
          <option value="Bancolombia">Bancolombia</option>
          <option value="Davivienda">Davivienda</option>
          <option value="Banco de Bogotá">Banco de Bogotá</option>
          <option value="BBVA">BBVA</option>
          <option value="Nequi">Nequi</option>
          <option value="Daviplata">Daviplata</option>
        </select>
        <label id="modal-destino-label" for="modal-cuenta" hidden>Cuenta, celular o llave Bre‑B de destino</label>
        <input id="modal-cuenta" type="text" maxlength="120" autocomplete="off" placeholder="Ej. 3001234567 o nombre@banco" hidden />
        <small id="modal-destino-ayuda" hidden>En esta demostración no se envía dinero; el retiro solo se descuenta de tu saldo y queda registrado.</small>
        <p id="modal-error" class="modal__error" hidden></p>
        <div class="modal__actions">
          <button type="button" class="btn btn--ghost" id="modal-cancel">Cancelar</button>
          <button type="button" class="btn btn--main" id="modal-ok">Continuar</button>
        </div>
      </div>

      <div id="step-bank" class="bank" hidden>
        <div class="bank__name" id="bank-name"></div>
        <div class="bank__spin" id="bank-spin"></div>
        <p id="bank-msg">Conectando con tu banco…</p>
        <div class="modal__actions" id="bank-actions" hidden>
          <button type="button" class="btn btn--ghost" id="bank-reject">Rechazar</button>
          <button type="button" class="btn btn--main" id="bank-approve">Aprobar</button>
        </div>
      </div>

    </dialog>

    <!-- ========== HISTORIAL ========== -->
    <dialog id="hist" class="hist">
      <div class="hist__box">
        <header class="hist__head">
          <div>
            <span class="eyebrow">Mi billetera</span>
            <h3>Historial de movimientos</h3>
          </div>
          <button type="button" class="hist__close" id="hist-close" aria-label="Cerrar">×</button>
        </header>
        <div class="hist__chips" role="tablist">
          <button type="button" class="chip is-active" data-filtro="todos">Todos</button>
          <button type="button" class="chip" data-filtro="in">Ingresos</button>
          <button type="button" class="chip" data-filtro="out">Egresos</button>
        </div>
        <div class="hist__body" id="hist-body"></div>
      </div>
    </dialog>

    {esAdmin && <dialog id="admin-ticket" class="hist admin-ticket" aria-labelledby="admin-ticket-title">
      <div class="hist__box">
        <header class="admin-ticket-head">
          <div class="admin-ticket-brand" aria-label="Hilf’e"><span class="admin-ticket-brand-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><path d="M12 7v10M7 12h10"/></svg></span>Hilf<span>’e</span></div>
          <button type="button" class="hist__close" id="admin-ticket-close" aria-label="Cerrar ticket">×</button>
        </header>
        <div class="admin-ticket-body">
          <div class="admin-ticket-summary"><div class="admin-ticket-summary-top"><span>COMPROBANTE DE SERVICIO</span><span class="admin-ticket-status"><i></i> Liquidado</span></div><h2 id="admin-ticket-title">Servicio</h2><div class="admin-ticket-meta"><span id="ticket-id">Solicitud</span><span id="ticket-date"></span></div></div>
          <div class="admin-ticket-parties"><div class="admin-ticket-party"><span class="admin-ticket-avatar client">C</span><div><small>CLIENTE</small><strong id="ticket-client">—</strong></div></div><span class="admin-ticket-connector" aria-hidden="true">→</span><div class="admin-ticket-party"><span class="admin-ticket-avatar pro">P</span><div><small>PROFESIONAL</small><strong id="ticket-worker">—</strong></div></div></div>
          <section class="admin-ticket-section"><h3>Liquidación del servicio</h3><dl class="admin-ticket-values"><div><dt>Valor del servicio</dt><dd id="ticket-price">—</dd></div><div><dt>Pago neto del cliente</dt><dd id="ticket-client-paid">—</dd></div><div><dt>Devolución al cliente</dt><dd id="ticket-refund">—</dd></div><div><dt>Recibido por el profesional</dt><dd id="ticket-worker-paid">—</dd></div></dl></section>
          <section class="admin-ticket-section fee-section"><h3>Comisiones de Hilf’e</h3><dl class="admin-ticket-values"><div><dt>Aporte del cliente <span>5%</span></dt><dd id="ticket-client-fee">—</dd></div><div><dt>Aporte del profesional <span>5%</span></dt><dd id="ticket-worker-fee">—</dd></div></dl><div class="admin-ticket-total"><span>Total Hilf’e</span><strong id="ticket-total-fee">—</strong></div></section>
          <p class="admin-ticket-footnote">Comprobante informativo del movimiento registrado en la billetera de Hilf’e.</p>
        </div>
      </div>
    </dialog>}
  </main>
</Layout>

<script>
  import { agruparPorFecha, horaDe } from '../lib/fechas';

  const cop = (n: number) =>
    new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(n);

  /* ========== MODAL RECARGA / RETIRO ========== */
  const modal = document.getElementById('modal') as HTMLDialogElement;
  const modalTitle = document.getElementById('modal-title')!;
  const stepForm = document.getElementById('step-form')!;
  const stepBank = document.getElementById('step-bank')!;
  const montoInput = document.getElementById('modal-monto') as HTMLInputElement;
  const bancoSelect = document.getElementById('modal-banco') as HTMLSelectElement;
  const cuentaInput = document.getElementById('modal-cuenta') as HTMLInputElement;
  const bancoLabel = document.getElementById('modal-banco-label')!;
  const destinoLabel = document.getElementById('modal-destino-label')!;
  const destinoAyuda = document.getElementById('modal-destino-ayuda')!;
  const modalError = document.getElementById('modal-error')!;
  const bankName = document.getElementById('bank-name')!;
  const bankSpin = document.getElementById('bank-spin')!;
  const bankMsg = document.getElementById('bank-msg')!;
  const bankActions = document.getElementById('bank-actions')!;

  let accionActual: 'recargar' | 'retirar' = 'recargar';
  let montoActual = 0;
  let bancoActual = '';

  function mostrarPaso(paso: 'form' | 'bank') {
    stepForm.hidden = paso !== 'form';
    stepBank.hidden = paso !== 'bank';
  }

  function abrir(accion: 'recargar' | 'retirar') {
    accionActual = accion;
    modalTitle.textContent = accion === 'recargar' ? 'Recargar saldo' : 'Retirar dinero';
    montoInput.value = '';
    bancoSelect.value = '';
    cuentaInput.value = '';
    bancoSelect.hidden = accion !== 'recargar';
    bancoLabel.hidden = accion !== 'recargar';
    cuentaInput.hidden = accion !== 'retirar';
    destinoLabel.hidden = accion !== 'retirar';
    destinoAyuda.hidden = accion !== 'retirar';
    modalError.hidden = true;
    mostrarPaso('form');
    modal.showModal();
    montoInput.focus();
  }

  function cerrarModal() {
    modal.close();
  }

  document.getElementById('wallet-retry')?.addEventListener('click', () => location.reload());

  document.getElementById('btn-recargar')?.addEventListener('click', () => abrir('recargar'));
  document.getElementById('btn-retirar')?.addEventListener('click', () => abrir('retirar'));
  document.getElementById('modal-cancel')?.addEventListener('click', cerrarModal);

  document.getElementById('modal-ok')?.addEventListener('click', async () => {
    const monto = Number(montoInput.value);
    const banco = bancoSelect.value;

    modalError.hidden = true;

    if (!monto || monto < 1000) {
      modalError.textContent = 'Ingresa un monto válido (mínimo $1.000)';
      modalError.hidden = false;
      return;
    }
    if (accionActual === 'recargar' && !banco) {
      modalError.textContent = 'Selecciona un banco';
      modalError.hidden = false;
      return;
    }
    const destino = cuentaInput.value.trim();
    if (accionActual === 'retirar' && (destino.length < 4 || destino.length > 120 || !/^[\p{L}\p{N}._@+\- ]+$/u.test(destino))) {
      modalError.textContent = 'Escribe un número, correo o llave Bre‑B válida (mínimo 4 caracteres).';
      modalError.hidden = false;
      return;
    }

    montoActual = monto;
    bancoActual = banco;

    mostrarPaso('bank');
    bankName.textContent = accionActual === 'recargar' ? banco : 'Retiro simulado';
    bankSpin.hidden = false;
    bankActions.hidden = true;
    bankMsg.textContent = accionActual === 'recargar'
      ? 'Simulación de confirmación de recarga…'
      : 'Preparando la simulación de retiro…';

    await new Promise(r => setTimeout(r, 1800));

    bankSpin.hidden = true;
    bankMsg.textContent = accionActual === 'recargar'
      ? `¿Autorizas la recarga de ${cop(monto)} desde ${banco}?`
      : `¿Confirmas descontar ${cop(monto)} y simular el envío a ${destino}?`;
    bankActions.hidden = false;
  });

  document.getElementById('bank-reject')?.addEventListener('click', () => {
    cerrarModal();
  });

    document.getElementById('bank-approve')?.addEventListener('click', async () => {
    bankActions.hidden = true;
    bankSpin.hidden = false;
      if (accionActual === 'recargar') {
        bankMsg.textContent = 'Aplicando recarga simulada a tu billetera…';
        try {
          const res = await fetch('/api/billetera/recargar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ monto: montoActual, banco: bancoActual }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || !data.ok) throw new Error(mensajeError(data.error) || 'No se pudo aplicar la recarga.');
          bankSpin.hidden = true;
          bankMsg.textContent = `Recarga simulada aplicada: ${cop(montoActual)}. Tu saldo está actualizado.`;
          window.setTimeout(() => { cerrarModal(); location.reload(); }, 850);
        } catch (error) {
          bankSpin.hidden = true;
          bankMsg.textContent = error instanceof Error ? error.message : 'Error al aplicar la recarga. Intenta de nuevo.';
          bankActions.hidden = false;
        }
        return;
      }

    bankMsg.textContent = 'Descontando el retiro de demostración…';
    try {
      const res = await fetch('/api/billetera/retirar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ monto: montoActual, destino: cuentaInput.value.trim() }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) throw new Error(mensajeError(data.error));
      bankSpin.hidden = true;
      bankMsg.textContent = `Retiro simulado de ${cop(montoActual)} registrado. El saldo se descontó; no se envió dinero real.`;
      window.setTimeout(() => { cerrarModal(); location.reload(); }, 1200);
    } catch (error) {
      bankMsg.textContent = error instanceof Error ? error.message : 'No se pudo completar el retiro. Revisa el saldo e intenta de nuevo.';
      bankSpin.hidden = true;
      bankActions.hidden = false;
    }
  });

  function mensajeError(code: string): string {
    const map: Record<string, string> = {
      MONTO_INVALIDO: 'Monto no válido',
      BANCO_INVALIDO: 'Banco no válido',
      SALDO_INSUFICIENTE: 'Saldo insuficiente',
      DESTINO_INVALIDO: 'Escribe un número, correo o llave Bre‑B válida.',
      NO_SESION: 'Sesión expirada. Vuelve a iniciar sesión',
      YA_PAGADA: 'Este servicio ya fue pagado',
      NO_PAGABLE: 'El servicio aún no está listo para pagar',
      NO_AUTORIZADO: 'No puedes pagar esta solicitud',
    };
    return map[code] || 'Ocurrió un error. Intenta de nuevo.';
  }

  modal.addEventListener('click', (e) => {
    if (e.target === modal) cerrarModal();
  });

  /* ========== PAGAR SERVICIO ========== */
  document.querySelectorAll<HTMLButtonElement>('.btn-pagar').forEach((b) =>
    b.addEventListener('click', async () => {
      const total = Number(b.dataset.total);
      if (!confirm(`¿Pagar ${cop(total)} con tu billetera?`)) return;
      b.disabled = true;
      b.textContent = 'Procesando…';
      try {
        const res = await fetch('/api/billetera/pagar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ solicitudId: Number(b.dataset.solicitud) }),
        });
        const data = await res.json();
        if (!data.ok) {
          alert(mensajeError(data.error));
          b.disabled = false;
          b.textContent = 'Pagar servicio';
          return;
        }
        location.reload();
      } catch {
        alert('Error de conexión.');
        b.disabled = false;
        b.textContent = 'Pagar servicio';
      }
    })
  );

  /* ========== HISTORIAL ========== */
  type Mov = { id: number; titulo: string; fecha: string | Date; monto: number };
  const hist = document.getElementById('hist') as HTMLDialogElement;
  const histBody = document.getElementById('hist-body')!;
  let datos: Mov[] = [];
  let filtro: 'todos' | 'in' | 'out' = 'todos';

  function fila(m: Mov) {
    const li = document.createElement('li');
    li.className = 'item';
    const ic = document.createElement('span');
    ic.className = `item__icon ${m.monto >= 0 ? 'in' : 'out'}`;
    ic.textContent = m.monto >= 0 ? '↓' : '↑';
    const tx = document.createElement('div');
    tx.className = 'item__text';
    const st = document.createElement('strong');
    st.textContent = m.titulo;
    const sm = document.createElement('small');
    sm.textContent = horaDe(m.fecha);
    tx.append(st, sm);
    const am = document.createElement('span');
    am.className = `item__amount ${m.monto >= 0 ? 'in' : 'out'}`;
    am.textContent = (m.monto >= 0 ? '+' : '') + cop(m.monto);
    li.append(ic, tx, am);
    return li;
  }

  function pintar() {
    histBody.replaceChildren();
    const lista = datos.filter((m) =>
      filtro === 'todos' ? true : filtro === 'in' ? m.monto >= 0 : m.monto < 0
    );
    if (!lista.length) {
      const p = document.createElement('p');
      p.className = 'hist__empty';
      p.textContent = 'No hay movimientos para mostrar.';
      histBody.appendChild(p);
      return;
    }
    for (const g of agruparPorFecha(lista)) {
      const h = document.createElement('h4');
      h.className = 'day';
      h.textContent = g.etiqueta;
      const ul = document.createElement('ul');
      ul.className = 'list';
      g.items.forEach((m) => ul.appendChild(fila(m)));
      histBody.append(h, ul);
    }
  }

  async function abrirHistorial() {
    hist.showModal();
    histBody.textContent = 'Cargando…';
    try {
      const res = await fetch('/api/billetera/historial', { credentials: 'same-origin' });
      const data = await res.json();
      datos = data.ok ? data.movimientos : [];
    } catch {
      datos = [];
    }
    pintar();
  }

  document.querySelectorAll('[data-open-hist]').forEach((b) =>
    b.addEventListener('click', abrirHistorial)
  );
  document.getElementById('hist-close')?.addEventListener('click', () => hist.close());
  hist.addEventListener('click', (e) => {
    if (e.target === hist) hist.close();
  });

  document.querySelectorAll<HTMLElement>('.chip').forEach((c) =>
    c.addEventListener('click', () => {
      document.querySelectorAll('.chip').forEach((x) => x.classList.remove('is-active'));
      c.classList.add('is-active');
      filtro = c.dataset.filtro as 'todos' | 'in' | 'out';
      pintar();
    })
  );

  async function cargarDetalleComisionesAdmin() {
    if (!document.querySelector('.wallet--admin')) return;
    const lista = document.getElementById('admin-trace-list');
    const contador = document.getElementById('admin-trace-count');
    const botonMas = document.getElementById('admin-trace-more') as HTMLButtonElement | null;
    const ticket = document.getElementById('admin-ticket') as HTMLDialogElement | null;
    const tickets = new Map<number, any>();
    const dinero = (valor: number) => cop(Number(valor) || 0);
    function mostrarTicket(servicio: any) {
      if (!ticket || !servicio) return;
      const setTicket = (id: string, texto: string) => { const nodo = document.getElementById(id); if (nodo) nodo.textContent = texto; };
      setTicket('ticket-id', `Solicitud #${servicio.id}`);
      setTicket('admin-ticket-title', servicio.servicio || 'Servicio finalizado');
      const fecha = servicio.fecha ? new Date(`${servicio.fecha}T00:00:00`).toLocaleDateString('es-CO', { day: '2-digit', month: 'long', year: 'numeric' }) : 'Fecha no registrada';
      setTicket('ticket-date', `${fecha}${servicio.hora ? ` · ${servicio.hora}` : ''}`);
      setTicket('ticket-client', servicio.cliente || 'Cliente sin nombre registrado');
      setTicket('ticket-worker', servicio.trabajador || 'Profesional sin nombre registrado');
      setTicket('ticket-price', dinero(servicio.precioServicio));
      setTicket('ticket-client-paid', dinero(servicio.pagoClienteNeto));
      setTicket('ticket-refund', dinero(servicio.devolucionCliente));
      setTicket('ticket-worker-paid', dinero(servicio.pagoTrabajador));
      setTicket('ticket-client-fee', dinero(servicio.comisionCliente));
      setTicket('ticket-worker-fee', dinero(servicio.comisionTrabajador));
      setTicket('ticket-total-fee', dinero(servicio.comisionTotal));
      const inicialCliente = document.querySelector('.admin-ticket-avatar.client');
      const inicialProfesional = document.querySelector('.admin-ticket-avatar.pro');
      if (inicialCliente) inicialCliente.textContent = String(servicio.cliente || 'C').trim().charAt(0).toUpperCase();
      if (inicialProfesional) inicialProfesional.textContent = String(servicio.trabajador || 'P').trim().charAt(0).toUpperCase();
      ticket.showModal();
    }
    document.getElementById('admin-ticket-close')?.addEventListener('click', () => ticket?.close());
    ticket?.addEventListener('click', (event) => { if (event.target === ticket) ticket.close(); });
    botonMas?.addEventListener('click', () => {
      const expandir = botonMas.getAttribute('aria-expanded') !== 'true';
      botonMas.setAttribute('aria-expanded', String(expandir));
      botonMas.textContent = expandir ? 'Ver menos' : 'Ver todos los servicios';
      lista?.querySelectorAll<HTMLElement>('.admin-trace-extra').forEach((fila) => { fila.hidden = !expandir; });
    });
    lista?.addEventListener('click', (event) => {
      const boton = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-ticket-id]');
      if (boton) mostrarTicket(tickets.get(Number(boton.dataset.ticketId)));
    });
    try {
      const response = await fetch('/api/admin/comisiones', { credentials: 'same-origin', cache: 'no-store' });
      const data = await response.json();
      if (!response.ok || !data.ok) throw new Error(data.mensaje || 'No se pudieron cargar las comisiones.');
      const setTexto = (id: string, texto: string) => { const nodo = document.getElementById(id); if (nodo) nodo.textContent = texto; };
      setTexto('admin-comision-total', dinero(data.comisionTotal));
      setTexto('admin-comision-cliente', dinero(data.comisionCliente));
      setTexto('admin-comision-trabajador', dinero(data.comisionTrabajador));
      setTexto('admin-servicios-comision', new Intl.NumberFormat('es-CO').format(Number(data.serviciosConMovimiento) || 0));
      setTexto('admin-retiros-comision', dinero(data.retirosRegistrados));
      const servicios = (Array.isArray(data.servicios) ? data.servicios : []).filter((servicio: any) => {
        const clienteSinNombre = /^Cliente #\d+$/.test(String(servicio.cliente || '').trim());
        const trabajadorSinNombre = /^Trabajador #\d+$/.test(String(servicio.trabajador || '').trim());
        return !(clienteSinNombre && trabajadorSinNombre);
      });
      setTexto('admin-trace-count', `${new Intl.NumberFormat('es-CO').format(servicios.length)} ${servicios.length === 1 ? 'servicio' : 'servicios'}`);
      if (!lista) return;
      if (!servicios.length) {
        const vacio = document.createElement('tr'); vacio.className = 'admin-trace-empty-row';
        const mensaje = document.createElement('td'); mensaje.colSpan = 10; mensaje.className = 'admin-trace-empty';
        mensaje.textContent = 'Todavía no hay servicios finalizados con movimientos de pago.';
        vacio.appendChild(mensaje); lista.replaceChildren(vacio);
        return;
      }
      const fragmento = document.createDocumentFragment();
      servicios.forEach((servicio: any, indice: number) => {
        tickets.set(Number(servicio.id), servicio);
        const fila = document.createElement('tr'); fila.className = 'admin-trace-row';
        if (indice >= 5) { fila.classList.add('admin-trace-extra'); fila.hidden = true; }
        const celda = (texto: string, clase = '') => { const td = document.createElement('td'); if (clase) td.className = clase; td.textContent = texto; return td; };
        const detalle = celda(''); detalle.className = 'admin-trace-service-cell';
        const servicioTexto = document.createElement('strong'); servicioTexto.className = 'admin-trace-service'; servicioTexto.textContent = servicio.servicio || 'Servicio finalizado';
        const solicitudTexto = document.createElement('small'); solicitudTexto.textContent = `Solicitud #${servicio.id}`;
        detalle.append(servicioTexto, solicitudTexto);
        fila.append(detalle,
          celda(servicio.cliente || 'Cliente', 'admin-trace-person-cell'),
          celda(servicio.trabajador || 'Profesional', 'admin-trace-person-cell'),
          celda(dinero(servicio.precioServicio), 'admin-trace-money'),
          celda(dinero(servicio.pagoClienteNeto), 'admin-trace-money'),
          celda(dinero(servicio.comisionCliente), 'admin-trace-money admin-trace-fee-value'),
          celda(dinero(servicio.pagoTrabajador), 'admin-trace-money'),
          celda(dinero(servicio.comisionTrabajador), 'admin-trace-money admin-trace-fee-value'),
          celda(dinero(servicio.comisionTotal), 'admin-trace-money admin-trace-total-value'));
        const verTicket = document.createElement('button'); verTicket.type = 'button'; verTicket.className = 'admin-ticket-button'; verTicket.dataset.ticketId = String(servicio.id); verTicket.setAttribute('aria-label', `Ver comprobante del servicio ${servicio.servicio || ''}`); verTicket.innerHTML = '<svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 2.75h7l3 3v11.5H5z"/><path d="M12 2.75v3h3M7.5 9h5M7.5 12h5M7.5 15h3"/></svg><span>Ver ticket</span>';
        const ticketCell = document.createElement('td'); ticketCell.className = 'admin-trace-ticket-cell'; ticketCell.appendChild(verTicket);
        fila.appendChild(ticketCell); fragmento.appendChild(fila);
      });
      lista.replaceChildren(fragmento);
      if (botonMas) botonMas.hidden = servicios.length <= 5;
    } catch {
      if (lista) { const fila = document.createElement('tr'); const aviso = document.createElement('td'); aviso.colSpan = 10; aviso.className = 'admin-trace-empty'; aviso.textContent = 'No fue posible cargar la trazabilidad de cobros.'; fila.appendChild(aviso); lista.replaceChildren(fila); }
    }
  }
  cargarDetalleComisionesAdmin();

  /* ========== Accesos desde el navbar ========== */
  if (location.hash === '#recargar') abrir('recargar');
  if (location.hash === '#historial') abrirHistorial();
</script>

<style>
  .wallet {
    --primary: var(--color-primary, #1d4ed8);
    --primary-soft: var(--color-primary-soft, #e8f0fe);
