---
import Layout from "../../layouts/Layout.astro";
import "../../components/styles/login.css";
---

<Layout title="Recuperar contraseña | Hilf'e">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/design-system.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  </Fragment>

  <div class="login-wrap">
    <div class="login-left">
      <div class="nebula nebula-1"></div>
      <div class="nebula nebula-2"></div>
      <div class="nebula nebula-3"></div>
      <div class="grid-overlay"></div>
      <div class="ambient"><div></div><div></div><div></div><div></div><div></div><div></div></div>
      <div class="login-logo">
        <div class="logo-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="4"/><line x1="12" y1="7" x2="12" y2="17"/><line x1="7" y1="12" x2="17" y2="12"/></svg></div>
        <h2>Hilf<span>'e</span></h2>
      </div>
      <div class="cube-center">
        <div style="position:relative;z-index:2;max-width:440px;padding:32px;color:#fff;text-align:center;">
          <h1 style="font-size:clamp(28px,4vw,42px);line-height:1.15;margin-bottom:14px;">Recupera el acceso a tu cuenta</h1>
          <p style="color:rgba(255,255,255,.72);line-height:1.7;">Te enviaremos un código al correo asociado a tu cuenta.</p>
        </div>
      </div>
    </div>

    <div class="login-right">
      <main class="login-card">
        <div class="mini-nav">
          <h2>Hilf<span>'e</span></h2>
          <button class="theme-toggle" id="themeToggle" aria-label="Cambiar tema" style="width:38px;height:38px;border-radius:50%;border:1.5px solid var(--border);background:var(--bg-card);cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:var(--transition-fast);">
            <svg class="theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="5.64"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/></svg>
            <svg class="theme-icon-dark" style="display:none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
        </div>

        <h1 class="form-title" style="font-size:22px;color:var(--text);">Restablecer contraseña</h1>
        <div class="msg-toast info" id="recuperacionMensaje" role="status" aria-live="polite" hidden></div>

        <form id="formSolicitarCodigo">
          <div class="form-group">
            <label for="correoRecuperacion">Correo electrónico</label>
            <div class="input-wrap">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <input type="email" id="correoRecuperacion" placeholder="Correo electrónico" autocomplete="email" required />
            </div>
          </div>
          <button type="submit" class="btn-login-modern" id="solicitarCodigoBtn"><span class="btn-text">Enviar código</span><div class="spinner"></div></button>
        </form>

        <form id="formVerificarCodigo" hidden>
          <p class="form-title" style="margin-bottom:18px;">Escribe el código de 6 dígitos que enviamos a <strong id="correoDestino"></strong>.</p>
          <div class="form-group">
            <label for="codigoRecuperacion">Código de verificación</label>
            <div class="input-wrap">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h.01M12 9h.01M17 9h.01M7 14h.01M12 14h.01M17 14h.01"/></svg>
              <input type="text" id="codigoRecuperacion" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="000000" autocomplete="one-time-code" required />
            </div>
          </div>
          <button type="submit" class="btn-login-modern" id="verificarCodigoBtn"><span class="btn-text">Verificar código</span><div class="spinner"></div></button>
          <div class="register-link"><button type="button" id="reenviarCodigo" style="background:none;border:0;color:var(--primary);font:inherit;font-weight:700;cursor:pointer;">Cambiar correo o enviar otro código</button></div>
        </form>

        <form id="formNuevaContrasena" hidden>
          <div class="form-group">
            <label for="nuevaContrasena">Nueva contraseña</label>
            <div class="input-wrap">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <input type="password" id="nuevaContrasena" placeholder="Nueva contraseña" autocomplete="new-password" required />
            </div>
          </div>
          <div class="form-group">
            <label for="confirmarContrasena">Confirmar contraseña</label>
            <div class="input-wrap">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <input type="password" id="confirmarContrasena" placeholder="Repite la contraseña" autocomplete="new-password" required />
            </div>
          </div>
          <button type="submit" class="btn-login-modern" id="guardarContrasenaBtn"><span class="btn-text">Guardar contraseña</span><div class="spinner"></div></button>
        </form>

        <div class="login-footer"><a href="/login/login"><i class="bi bi-arrow-left"></i> Volver al inicio de sesión</a></div>
      </main>
    </div>
  </div>

  <script is:inline>
    (function () {
      var api = "http://127.0.0.1:8000/api/auth/recuperar";
      var mensaje = document.getElementById("recuperacionMensaje");
      var correo = "";
      var codigo = "";
      var forms = [document.getElementById("formSolicitarCodigo"), document.getElementById("formVerificarCodigo"), document.getElementById("formNuevaContrasena")];
      function mostrarMensaje(texto, tipo) {
        mensaje.className = "msg-toast " + tipo;
        mensaje.textContent = texto;
        mensaje.hidden = false;
      }
      async function post(ruta, cuerpo) {
        var response;
        try {
          response = await fetch(api + ruta, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(cuerpo) });
        } catch {
          throw new Error("No se pudo conectar con el backend. Comprueba que Deno siga ejecutándose en el puerto 8000. Si ocurre únicamente con un correo registrado, revisa el error SMTP en la terminal de Deno.");
        }
        var data = await response.json().catch(function () { return {}; });
        if (!response.ok) throw new Error(data.mensaje || data.error || "No fue posible completar la recuperación.");
        return data;
      }
      function cargando(boton, activo) {
        boton.classList.toggle("loading", activo);
        boton.disabled = activo;
      }

      forms[0].addEventListener("submit", async function (event) {
        event.preventDefault();
        var boton = document.getElementById("solicitarCodigoBtn");
        correo = document.getElementById("correoRecuperacion").value.trim();
        cargando(boton, true);
        try {
          var data = await post("/solicitar", { correo: correo });
          document.getElementById("correoDestino").textContent = correo;
          forms[0].hidden = true; forms[1].hidden = false;
          mostrarMensaje(data.mensaje || "Si el correo está registrado, se envió un código de verificación.", "info");
          document.getElementById("codigoRecuperacion").focus();
        } catch (error) { mostrarMensaje(error.message || "No se pudo enviar el código.", "error"); }
        finally { cargando(boton, false); }
      });

      forms[1].addEventListener("submit", async function (event) {
        event.preventDefault();
        var boton = document.getElementById("verificarCodigoBtn");
        codigo = document.getElementById("codigoRecuperacion").value.trim();
        cargando(boton, true);
        try {
          var data = await post("/verificar", { correo: correo, codigo: codigo });
          forms[1].hidden = true; forms[2].hidden = false;
          mostrarMensaje(data.mensaje || "Código verificado. Ya puedes crear una nueva contraseña.", "success");
          document.getElementById("nuevaContrasena").focus();
        } catch (error) { mostrarMensaje(error.message || "El código no es válido o venció.", "error"); }
        finally { cargando(boton, false); }
      });

      forms[2].addEventListener("submit", async function (event) {
        event.preventDefault();
        var nuevaContrasena = document.getElementById("nuevaContrasena").value;
        var confirmar = document.getElementById("confirmarContrasena").value;
        if (nuevaContrasena !== confirmar) { mostrarMensaje("Las contraseñas no coinciden.", "error"); return; }
        var boton = document.getElementById("guardarContrasenaBtn");
        cargando(boton, true);
        try {
          var data = await post("/nueva-contrasena", { correo: correo, codigo: codigo, nuevaContrasena: nuevaContrasena });
          forms[2].hidden = true;
          mostrarMensaje(data.mensaje || "Contraseña actualizada correctamente.", "success");
          var acceso = document.createElement("div"); acceso.className = "register-link";
          var enlace = document.createElement("a"); enlace.href = "/login/login"; enlace.textContent = "Iniciar sesión con tu nueva contraseña";
          acceso.appendChild(enlace); mensaje.appendChild(document.createElement("br")); mensaje.appendChild(acceso);
        } catch (error) { mostrarMensaje(error.message || "No se pudo actualizar la contraseña.", "error"); }
        finally { cargando(boton, false); }
      });

      document.getElementById("reenviarCodigo").addEventListener("click", function () {
        forms[1].hidden = true; forms[0].hidden = false;
        document.getElementById("correoRecuperacion").value = correo;
        mensaje.hidden = true;
        document.getElementById("correoRecuperacion").focus();
      });
    })();
  </script>
  <script is:inline src="/js/site.js"></script>
</Layout>
