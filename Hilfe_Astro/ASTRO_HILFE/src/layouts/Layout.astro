---
interface Props {
	title?: string;
}

const {
	title = "Hilf'e — Encuentra ayuda fácil, rápida y confiable",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<script is:inline>
			(function () {
				var tema = 'light';
				try { tema = localStorage.getItem('theme') || 'light'; } catch (e) {}
				document.documentElement.setAttribute('data-theme', tema);
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<style is:global>
			:root {
				color-scheme: light;
				--app-page: #f5f7fb;
				--app-surface: #ffffff;
				--app-surface-alt: #edf2f8;
				--app-ink: #172033;
				--app-muted: #64748b;
				--app-line: #d9e1ec;
				--app-blue: #2856d8;
			}
			:root[data-theme="dark"] {
				color-scheme: dark;
				--app-page: #111722;
				--app-surface: #171f2b;
				--app-surface-alt: #202b39;
				--app-ink: #e8edf5;
				--app-muted: #aab5c4;
				--app-line: #344255;
				--app-blue: #7ca5ff;
			}
			body { background-color: var(--app-page); color: var(--app-ink); }
			*, *::before, *::after {
				box-shadow: none !important;
				text-shadow: none !important;
				backdrop-filter: none !important;
				-webkit-backdrop-filter: none !important;
			}
			:focus-visible { outline: 2px solid var(--app-blue); outline-offset: 3px; }
			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
			}
		</style>
	<script is:inline>
	(function () {
		var ruta = window.location.pathname.replace(/\/+$/, '') || '/';
		var rutasProtegidas = [
			{ prefijo: '/admin', rol: 1, destino: '/admin/admin' },
			{ prefijo: '/cliente', rol: 3, destino: '/cliente/' },
			{ prefijo: '/trabajador', rol: 2, destino: '/trabajador/' },
		];
		// El perfil público del trabajador es visible sin iniciar sesión.
		if (ruta === '/trabajador/perfil' && /[?&]id=/.test(window.location.search)) return;

		var regla = rutasProtegidas.find(function (item) {
			return ruta === item.prefijo || ruta.indexOf(item.prefijo + '/') === 0;
		});
		if (!regla) return;

		// Oculta la página hasta confirmar la sesión
		var estilo = document.createElement('style');
		estilo.id = 'guardia-estilo';
		estilo.textContent = 'body{visibility:hidden}';
		document.head.appendChild(estilo);
		var mostrar = function () { var e = document.getElementById('guardia-estilo'); if (e) e.remove(); };

		var irLogin = function () {
			window.location.replace('/login/login?error=' + encodeURIComponent('Inicia sesión con una cuenta autorizada para continuar.'));
		};

		fetch('/api/auth/me', { credentials: 'same-origin', cache: 'no-store' })
			.then(function (r) { return r.ok ? r.json() : null; })
			.then(function (data) {
				if (!data || !data.ok || Number(data.usuario.rol) !== regla.rol) { irLogin(); return; }
				try {
				var token = localStorage.getItem('token');
				if (!token || token === 'sesion-activa') {
					localStorage.removeItem('token');
					localStorage.removeItem('usuario');
					irLogin();
					return;
				}
					localStorage.setItem('usuario', JSON.stringify(data.usuario));
				} catch (e) {}
				if (ruta === '/admin') { window.location.replace(regla.destino); return; }
				mostrar();
			})
			.catch(irLogin);
	})();
</script>
		<slot name="head" />
	</head>
	<body>
		<slot />
		<style is:global>
			/* Shared surface and text tokens used by the marketing pages and role dashboards. */
			:root {
				--bg-body: var(--app-page) !important;
				--bg-card: var(--app-surface) !important;
				--bg-card-alt: var(--app-surface-alt) !important;
				--bg-elevated: var(--app-surface) !important;
				--bg-nav: var(--app-surface) !important;
				--text: var(--app-ink) !important;
				--text-secondary: var(--app-muted) !important;
				--text-muted: var(--app-muted) !important;
				--border: var(--app-line) !important;
				--border-light: var(--app-line) !important;
				--input-bg: var(--app-surface) !important;
				--input-border: var(--app-line) !important;
				--primary: var(--app-blue) !important;
				--primary-dark: var(--app-blue) !important;
				--primary-soft: var(--app-surface-alt) !important;
				--shadow-sm: none !important;
				--shadow: none !important;
				--shadow-lg: none !important;
				--shadow-xl: none !important;
			}
			:root[data-theme="dark"] {
				--success-soft: #183c31 !important;
				--warning-soft: #443716 !important;
				--danger-soft: #44272b !important;
				--info-soft: #203751 !important;
				--tag-bg: var(--app-surface-alt) !important;
				--tag-color: var(--app-ink) !important;
				--hover-bg: var(--app-surface-alt) !important;
			}
			body { background: var(--app-page) !important; color: var(--app-ink); }
			::selection { background: color-mix(in srgb, var(--app-blue) 24%, transparent); }
			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
			}
		</style>

		<script is:inline>
			(function () {
				var mensajeLogin = null;
				try {
					mensajeLogin = sessionStorage.getItem('hilfe:loginToast');
					sessionStorage.removeItem('hilfe:loginToast');
				} catch (e) {}
				if (mensajeLogin) {
					var aviso = document.createElement('div');
					aviso.setAttribute('role', 'status');
					aviso.setAttribute('aria-live', 'polite');
					aviso.textContent = mensajeLogin;
					aviso.style.cssText = 'position:fixed;top:24px;left:50%;z-index:5000;max-width:min(92vw,520px);padding:13px 20px;border:1px solid var(--app-line);border-radius:14px;background:var(--app-surface);color:var(--app-ink);font:600 14px Inter,system-ui,sans-serif;text-align:center;opacity:0;transform:translate(-50%,-10px);transition:opacity .24s ease,transform .24s ease';
					document.body.appendChild(aviso);
					requestAnimationFrame(function () { aviso.style.opacity = '1'; aviso.style.transform = 'translate(-50%,0)'; });
					window.setTimeout(function () {
						aviso.style.opacity = '0';
						aviso.style.transform = 'translate(-50%,-10px)';
						window.setTimeout(function () { aviso.remove(); }, 220);
					}, 3200);
				}

				var current = 'light';
				try { current = localStorage.getItem('theme') || 'light'; } catch (e) {}
				document.documentElement.setAttribute('data-theme', current);

				function updateAllThemeIcons(theme) {
					document.querySelectorAll('.theme-toggle').forEach(function (btn) {
						var light = btn.querySelector('.theme-icon-light');
						var dark = btn.querySelector('.theme-icon-dark');
						if (light) light.style.display = theme === 'dark' ? 'none' : '';
						if (dark) dark.style.display = theme === 'dark' ? '' : 'none';
					});
				}

				updateAllThemeIcons(current);

				document.addEventListener('click', function (e) {
					var target = e.target;
					var btn = target && target.closest ? target.closest('.theme-toggle') : null;
					if (!btn) return;
					e.preventDefault();
					e.stopPropagation();
					var next =
						document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
					document.documentElement.setAttribute('data-theme', next);
					try { localStorage.setItem('theme', next); } catch (e) {}
					updateAllThemeIcons(next);
				}, true);
			})();
		</script>
	</body>
</html>
