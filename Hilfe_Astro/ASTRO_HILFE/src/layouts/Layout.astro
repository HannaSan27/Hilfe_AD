---
interface Props {
	title?: string;
}

const {
	title = "Hilf'e — Encuentra ayuda fácil, rápida y confiable",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	<script is:inline>
	(function () {
		var ruta = window.location.pathname.replace(/\/+$/, '') || '/';
		var rutasProtegidas = [
			{ prefijo: '/admin', rol: 1, destino: '/admin/admin' },
			{ prefijo: '/cliente', rol: 3, destino: '/cliente/' },
			{ prefijo: '/trabajador', rol: 2, destino: '/trabajador/' },
		];
		// El perfil público del trabajador es visible sin iniciar sesión.
		if (ruta === '/trabajador/perfil' && /[?&]id=/.test(window.location.search)) return;

		var regla = rutasProtegidas.find(function (item) {
			return ruta === item.prefijo || ruta.indexOf(item.prefijo + '/') === 0;
		});
		if (!regla) return;

		// Oculta la página hasta confirmar la sesión
		var estilo = document.createElement('style');
		estilo.id = 'guardia-estilo';
		estilo.textContent = 'body{visibility:hidden}';
		document.head.appendChild(estilo);
		var mostrar = function () { var e = document.getElementById('guardia-estilo'); if (e) e.remove(); };

		var irLogin = function () {
			window.location.replace('/login/login?error=' + encodeURIComponent('Inicia sesión con una cuenta autorizada para continuar.'));
		};

		fetch('/api/auth/me', { credentials: 'same-origin', cache: 'no-store' })
			.then(function (r) { return r.ok ? r.json() : null; })
			.then(function (data) {
				if (!data || !data.ok || Number(data.usuario.rol) !== regla.rol) { irLogin(); return; }
				try {
				var token = localStorage.getItem('token');
				if (!token || token === 'sesion-activa') {
					localStorage.removeItem('token');
					localStorage.removeItem('usuario');
					irLogin();
					return;
				}
					localStorage.setItem('usuario', JSON.stringify(data.usuario));
				} catch (e) {}
				if (ruta === '/admin') { window.location.replace(regla.destino); return; }
				mostrar();
			})
			.catch(irLogin);
	})();
</script>
		<slot name="head" />
	</head>
	<body>
		<slot />

		<script is:inline>
			(function () {
				var mensajeLogin = null;
				try {
					mensajeLogin = sessionStorage.getItem('hilfe:loginToast');
					sessionStorage.removeItem('hilfe:loginToast');
				} catch (e) {}
				if (mensajeLogin) {
					var aviso = document.createElement('div');
					aviso.setAttribute('role', 'status');
					aviso.setAttribute('aria-live', 'polite');
					aviso.textContent = mensajeLogin;
					aviso.style.cssText = 'position:fixed;top:20px;right:20px;z-index:5000;padding:12px 18px;border:1px solid #86efac;border-radius:12px;background:#f0fdf4;color:#166534;box-shadow:0 12px 36px rgba(15,23,42,.18);font:600 14px Inter,system-ui,sans-serif;opacity:0;transform:translateY(-8px);transition:opacity .2s ease,transform .2s ease';
					document.body.appendChild(aviso);
					requestAnimationFrame(function () { aviso.style.opacity = '1'; aviso.style.transform = 'translateY(0)'; });
					window.setTimeout(function () {
						aviso.style.opacity = '0';
						aviso.style.transform = 'translateY(-8px)';
						window.setTimeout(function () { aviso.remove(); }, 220);
					}, 3200);
				}

				var current = 'light';
				try { current = localStorage.getItem('theme') || 'light'; } catch (e) {}
				document.documentElement.setAttribute('data-theme', current);

				function updateAllThemeIcons(theme) {
					document.querySelectorAll('.theme-toggle').forEach(function (btn) {
						var light = btn.querySelector('.theme-icon-light');
						var dark = btn.querySelector('.theme-icon-dark');
						if (light) light.style.display = theme === 'dark' ? 'none' : '';
						if (dark) dark.style.display = theme === 'dark' ? '' : 'none';
					});
				}

				updateAllThemeIcons(current);

				document.addEventListener('click', function (e) {
					var target = e.target;
					var btn = target && target.closest ? target.closest('.theme-toggle') : null;
					if (!btn) return;
					e.preventDefault();
					e.stopPropagation();
					var next =
						document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
					document.documentElement.setAttribute('data-theme', next);
					try { localStorage.setItem('theme', next); } catch (e) {}
					updateAllThemeIcons(next);
				}, true);
			})();
		</script>
	</body>
</html>
